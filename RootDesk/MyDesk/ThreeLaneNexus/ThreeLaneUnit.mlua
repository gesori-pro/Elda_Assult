@Component
script ThreeLaneUnit extends Component

	property integer CombatUnitId = 0

	property integer OwnerSide = 1

	property integer LaneIndex = 1

	property integer SlotIndex = 1

	property integer BaseSlotIndex = 1

	property integer BaseLaneIndex = 1

	property integer PlacementOrder = 0

	property integer CardIndex = 5

	property string CardInstanceId = ""

	property string MonsterId = "drake"

	@Sync
	property string NameKey = "monster.drake.name"

	@Sync
	property string DisplayNameFallback = "드레이크"

	property string RangeClass = "Melee"

	property integer Cost = 5

	property integer HP = 600

	property integer MaxHP = 600

	property integer Attack = 120

	property integer BaseAttack = 120

	property integer CombatAttackBonus = 0

	property integer AttackIntervalTicks = 72

	property integer FirstAttackDelayTicks = 18

	property number MoveSpeed = 1.0

	property number AttackRange = 0.70

	property integer NexusDamage = 5

	property string SecondaryTargetLane = "None"

	property number SecondaryDamageRate = 0

	property string RevealEffectTargetInstanceId = ""

	property integer RevealEffectDestinationSlotIndex = 0

	property boolean RevealEffectResolved = false

	property boolean HasCombatVisualProfile = false

	property string VisualPackId = ""

	property string IdleRuid = ""

	property string MoveRuid = ""

	property string AttackRuid = ""

	property string HitRuid = ""

	property string DieRuid = ""

	property string NexusRuid = ""

	property string VisualState = "Prototype"

	property integer VisualStateUntilTick = 0

	property number VisualPlaybackSpeed = 1

	property number HealthBarYOffset = 0.72

	property number HealthBarWidthScale = 3.5

	property number NameplateYOffset = 0.72

	property number NameplateNameOffset = 0.20

	property number NameplateStackStep = 0.22

	property integer NameplateStackLevel = 0

	property number SimX = 0

	property number CombatStartX = 0

	property number CombatStartY = 0

	property number TargetNexusX = 5.35

	property integer TargetCombatUnitId = 0

	property integer LastTargetCombatUnitId = 0

	property integer EngageTick = -1

	property integer NextAttackTick = -1

	property integer DeathTick = -1

	property boolean Alive = true

	property boolean Exited = false

	property boolean PendingExit = false

	property boolean IsTestUnit = false

	property integer ForcedDeathTick = -1

	property table AttackIntentTicks = {}

	property table TargetHistory = {}

	property table SecondaryIntentTicks = {}

	property table SecondaryTargetHistory = {}

	property table DamageIntentHistory = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 전투 판정은 Combat만 수행하므로 소환 직후 시각 이동을 정지한다.
		self:SetVisualVelocity(0)
		log("[ThreeLaneUnit] OnBeginPlay - passive combat state ready")
	end

	@ExecSpace("ServerOnly")
	method void ResetCombatState()
		-- 새 전투 등록 시 대상·공격 예약·사망 상태를 기본값으로 되돌린다.
		self.TargetCombatUnitId = 0
		self.LastTargetCombatUnitId = 0
		self.EngageTick = -1
		self.NextAttackTick = -1
		self.DeathTick = -1
		self.Alive = true
		self.Exited = false
		self.PendingExit = false
		self.ForcedDeathTick = -1
		self.AttackIntentTicks = {}
		self.TargetHistory = {}
		self.SecondaryIntentTicks = {}
		self.SecondaryTargetHistory = {}
		self.DamageIntentHistory = {}
		self:SetVisualVelocity(0)
		self.VisualStateUntilTick = 0
		self.NameplateStackLevel = 0
		if self.HasCombatVisualProfile then
			self:SetCombatVisualState("Idle", 0, 0, self.VisualPlaybackSpeed, true)
			self:SetHealthBarVisible(true)
			self:ConfigureHealthBarTransform()
			self:UpdateHealthBarVisual()
		end
	end

	@ExecSpace("ServerOnly")
	method void SetVisualVelocity(number signedSpeed)
		-- Combat이 계산한 방향 속도만 Kinematicbody 시각 이동에 반영한다.
		if isvalid(self.Entity.KinematicbodyComponent) then
			self.Entity.KinematicbodyComponent.MoveVelocity = Vector2(signedSpeed, 0)
		end
	end

	@ExecSpace("ServerOnly")
	method void InitializePresentation(any profile, number speed)
		if profile == nil then
			self.HasCombatVisualProfile = false
			self.VisualState = "Prototype"
			self:SetHealthBarVisible(false)
			return
		end
		self.HasCombatVisualProfile = true
		self.VisualPackId = profile.PackId or ""
		self.IdleRuid = profile.IdleRuid or ""
		self.MoveRuid = profile.MoveRuid or self.IdleRuid
		self.AttackRuid = profile.AttackRuid or self.IdleRuid
		self.HitRuid = profile.HitRuid or self.IdleRuid
		self.DieRuid = profile.DieRuid or self.IdleRuid
		self.NexusRuid = profile.NexusRuid or self.AttackRuid
		self.NameplateYOffset = profile.NameplateYOffset or profile.HealthBarYOffset or 0.72
		self.HealthBarYOffset = self.NameplateYOffset
		self.HealthBarWidthScale = profile.HealthBarWidthScale or 3.5
		self.NameplateStackLevel = 0
		self.VisualPlaybackSpeed = speed == 2 and 2 or 1
		if isvalid(self.Entity.SpriteRendererComponent) then
			self.Entity.SpriteRendererComponent.Color = Color(1.0, 1.0, 1.0, 1.0)
			self.Entity.SpriteRendererComponent.FlipX = self.OwnerSide == 1
			self.Entity.SpriteRendererComponent.PlayRate = self.VisualPlaybackSpeed
		end
		self:ConfigureHealthBarTransform()
		self:SetHealthBarVisible(true)
		self:UpdateHealthBarVisual()
		self:SetNameplateFallbackText()
		self:ApplyLocalizedNameplate(self.NameKey, self.DisplayNameFallback)
		self:SetCombatVisualState("Idle", 0, 0, self.VisualPlaybackSpeed, true)
		log(
			"[Phase2C5][Visual] Profile Monster=" .. self.MonsterId
			.. ", Pack=" .. self.VisualPackId
			.. ", Side=" .. tostring(self.OwnerSide)
			.. ", FlipX=" .. tostring(self.OwnerSide == 1)
		)
	end

	@ExecSpace("ServerOnly")
	method void SetNameplateFallbackText()
		local nameEntity = self.Entity:GetChildByName("NameplateName")
		if isvalid(nameEntity) and isvalid(nameEntity.TextRendererComponent) then
			local renderer = nameEntity.TextRendererComponent
			renderer.Text = self.DisplayNameFallback
			renderer.FontColor = Color(1.0, 1.0, 1.0, 1.0)
			renderer.OutlineColor = Color(0.05, 0.06, 0.08, 1.0)
			renderer.OutlineWidth = 0.12
		end
	end

	@ExecSpace("Client")
	method void ApplyLocalizedNameplate(string nameKey, string fallbackName)
		-- 이름의 권위 키는 NameKey다. LocaleDataSet이 아직 없거나 키가 비면 읽을 수 있는 한국어 fallback을 쓴다.
		local nameEntity = self.Entity:GetChildByName("NameplateName")
		if not isvalid(nameEntity) or not isvalid(nameEntity.TextRendererComponent) then
			return
		end
		local displayName = ""
		if nameKey ~= nil and nameKey ~= "" then
			displayName = _LocalizationService:GetText(nameKey)
		end
		if displayName == nil or displayName == "" or displayName == nameKey then
			displayName = fallbackName
		end
		nameEntity.TextRendererComponent.Text = displayName
	end

	@ExecSpace("ServerOnly")
	method string GetVisualRuid(string state)
		if state == "Move" then return self.MoveRuid end
		if state == "Attack" then return self.AttackRuid end
		if state == "Hit" then return self.HitRuid end
		if state == "Die" then return self.DieRuid end
		if state == "Nexus" then return self.NexusRuid end
		return self.IdleRuid
	end

	@ExecSpace("ServerOnly")
	method void SetCombatVisualState(
		string state,
		integer simTick,
		integer untilTick,
		number speed,
		boolean force
	)
		if not self.HasCombatVisualProfile or not isvalid(self.Entity.SpriteRendererComponent) then
			return
		end
		self:SetVisualPlaybackSpeed(speed)
		if not force
			and simTick < self.VisualStateUntilTick
			and (self.VisualState == "Attack" or self.VisualState == "Hit") then
			return
		end
		local ruid = self:GetVisualRuid(state)
		if ruid == nil or ruid == "" then
			return
		end
		if self.VisualState ~= state or force then
			self.VisualState = state
			self.Entity.SpriteRendererComponent.SpriteRUID = ruid
		end
		self.VisualStateUntilTick = untilTick
	end

	@ExecSpace("ServerOnly")
	method void SetVisualPlaybackSpeed(number speed)
		local normalized = 1
		if speed == 2 then normalized = 2 end
		if self.VisualPlaybackSpeed == normalized then
			return
		end
		self.VisualPlaybackSpeed = normalized
		if isvalid(self.Entity.SpriteRendererComponent) then
			self.Entity.SpriteRendererComponent.PlayRate = normalized
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshLocomotionVisual(integer simTick, boolean moving, number speed)
		if moving then
			self:SetCombatVisualState("Move", simTick, 0, speed, false)
		else
			self:SetCombatVisualState("Idle", simTick, 0, speed, false)
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayAttackVisual(integer simTick, number speed)
		self:SetCombatVisualState("Attack", simTick, simTick + 12, speed, true)
	end

	@ExecSpace("ServerOnly")
	method void PlayHitVisual(integer simTick, number speed)
		self:SetCombatVisualState("Hit", simTick, simTick + 8, speed, true)
		self:UpdateHealthBarVisual()
	end

	@ExecSpace("ServerOnly")
	method void PlayDeathVisual(integer simTick, number speed)
		self:SetVisualVelocity(0)
		self:SetHealthBarVisible(false)
		self:SetCombatVisualState("Die", simTick, simTick + 30, speed, true)
	end

	@ExecSpace("ServerOnly")
	method void PlayNexusFinalVisual(integer simTick, number speed)
		self:SetVisualVelocity(0)
		self:SetHealthBarVisible(false)
		self:SetCombatVisualState("Nexus", simTick, simTick + 24, speed, true)
	end

	@ExecSpace("ServerOnly")
	method void ConfigureHealthBarTransform()
		local back = self.Entity:GetChildByName("HealthBarBack")
		local fill = self.Entity:GetChildByName("HealthBarFill")
		local nameEntity = self.Entity:GetChildByName("NameplateName")
		local stackedYOffset = self.NameplateYOffset
			+ self.NameplateStackStep * self.NameplateStackLevel
		if isvalid(back) then
			back.TransformComponent.Position = Vector3(0, stackedYOffset, 0)
			back.TransformComponent.Scale = Vector3(self.HealthBarWidthScale, 1, 1)
		end
		if isvalid(fill) then
			fill.TransformComponent.Position = Vector3(0, stackedYOffset, 0)
			fill.TransformComponent.Scale = Vector3(self.HealthBarWidthScale, 1, 1)
		end
		if isvalid(nameEntity) then
			nameEntity.TransformComponent.Position = Vector3(0, stackedYOffset + self.NameplateNameOffset, 0)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetNameplateStackLevel(integer stackLevel)
		local normalized = stackLevel
		if normalized < 0 then normalized = 0 end
		if self.NameplateStackLevel == normalized then
			return
		end
		self.NameplateStackLevel = normalized
		self:ConfigureHealthBarTransform()
	end

	@ExecSpace("ServerOnly")
	method void UpdateHealthBarVisual()
		if not self.HasCombatVisualProfile or self.MaxHP <= 0 then
			return
		end
		local fill = self.Entity:GetChildByName("HealthBarFill")
		if not isvalid(fill) then
			return
		end
		local ratio = self.HP / self.MaxHP
		if ratio < 0 then ratio = 0 end
		if ratio > 1 then ratio = 1 end
		fill.TransformComponent.Scale = Vector3(self.HealthBarWidthScale * ratio, 1, 1)
		fill.TransformComponent.Position = Vector3(
			-0.08 * self.HealthBarWidthScale * (1 - ratio),
			self.NameplateYOffset + self.NameplateStackStep * self.NameplateStackLevel,
			0
		)
	end

	@ExecSpace("ServerOnly")
	method void SetHealthBarVisible(boolean visible)
		local back = self.Entity:GetChildByName("HealthBarBack")
		local fill = self.Entity:GetChildByName("HealthBarFill")
		local nameEntity = self.Entity:GetChildByName("NameplateName")
		if isvalid(back) then back.Enable = visible and self.HasCombatVisualProfile end
		if isvalid(fill) then fill.Enable = visible and self.HasCombatVisualProfile end
		if isvalid(nameEntity) then nameEntity.Enable = visible and self.HasCombatVisualProfile end
	end

end
