@Component
script ThreeLaneUnit extends Component

	property integer OwnerSide = 1

	property integer Damage = 3

	property number MoveSpeed = 1.4

	property number TargetX = 5.35

	property boolean HasResolved = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 생성된 유닛을 같은 라인의 적 수호석 방향으로 이동시킨다.
		if isvalid(self.Entity.KinematicbodyComponent) then
			self.Entity.KinematicbodyComponent.MoveVelocity = Vector2(self.MoveSpeed, 0)
		end

		log(
			"[ThreeLaneUnit] OnBeginPlay - Damage="
			.. tostring(self.Damage)
			.. ", TargetX="
			.. tostring(self.TargetX)
		)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 목표 지점 도달 시 한 번만 적 수호석 피해를 서버 보드에 전달한다.
		if self.HasResolved then
			return
		end

		local boardEntity = self.Entity.CurrentMap:GetChildByName("PrototypeBoard")
		if not isvalid(boardEntity) then
			return
		end

		---@type ThreeLaneBoard
		local board = boardEntity:GetComponent("script.ThreeLaneBoard")
		if not isvalid(board) then
			return
		end

		if board.BattleState ~= "Playing" then
			if isvalid(self.Entity.KinematicbodyComponent) then
				self.Entity.KinematicbodyComponent.MoveVelocity = Vector2.zero
			end
			return
		end

		local currentX = self.Entity.TransformComponent.WorldPosition.x
		if currentX < self.TargetX then
			return
		end

		self.HasResolved = true
		if isvalid(self.Entity.KinematicbodyComponent) then
			self.Entity.KinematicbodyComponent.MoveVelocity = Vector2.zero
		end

		board:ResolveEnemyNexusHit(self.Damage, self.Entity)
	end

end
