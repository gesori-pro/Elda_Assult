@Component
script ThreeLaneCombat extends Component

	property number SimStep = 0.0166666666666667

	property integer BattleTimeLimitTicks = 3600

	property integer ActiveBattleLimitTicks = 3600

	property integer MaxStepsPerFrame = 120

	property number SimAccumulator = 0

	property integer SimTick = 0

	property number SimulationSpeed = 1

	property boolean IsRunning = false

	property boolean BacklogWarned = false

	property integer BacklogWarningCount = 0

	property integer NextCombatUnitId = 1

	property table Units = {}

	property table UnitById = {}

	property boolean MakerTestMode = false
	property boolean MakerHarnessRunning = false

	property string CurrentScenario = ""

	property table ScenarioMetrics = {}

	property string Speed1Signature = ""

	property string Speed2Signature = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 전투 단일 권위 컴포넌트의 고정 Tick 상태를 초기화한다.
		self:ResetSimulation(false)
		log("[ThreeLaneCombat] OnBeginPlay - fixed tick combat authority ready")
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Battle 페이즈 동안에만 누적 delta를 고정 Tick으로 처리한다.
		if self.MakerHarnessRunning then
			return
		end

		if not self.IsRunning then
			return
		end

		local board = self:GetBoard()
		if not isvalid(board) then
			return
		end

		if board.BattleState ~= "Playing" or board.Phase ~= "Battle" then
			self.IsRunning = false
			self:StopAllVisuals()
			return
		end

		self:AdvanceSimulation(delta)
	end

	@ExecSpace("ServerOnly")
	method ThreeLaneBoard GetBoard()
		-- 같은 PrototypeBoard 엔티티의 페이즈·코스트·결과 권위 컴포넌트를 반환한다.
		---@type ThreeLaneBoard
		local board = self.Entity:GetComponent("script.ThreeLaneBoard")
		if not isvalid(board) then
			return nil
		end
		return board
	end

	@ExecSpace("ServerOnly")
	method ThreeLaneData GetData()
		-- 같은 PrototypeBoard의 MonsterData 캐시를 드레이크·7종 테스트 상태 생성에 사용한다.
		---@type ThreeLaneData
		local data = self.Entity:GetComponent("script.ThreeLaneData")
		if not isvalid(data) then
			return nil
		end
		if not data.IsReady and not data:LoadAndValidate() then
			return nil
		end
		return data
	end

	@ExecSpace("ServerOnly")
	method void StartBattle(number speed)
		-- Reveal에서 등록된 유닛을 유지한 채 새 전투의 Tick 누적을 0부터 시작한다.
		self.SimAccumulator = 0
		self.SimTick = 0
		self.ActiveBattleLimitTicks = self.BattleTimeLimitTicks
		self.BacklogWarned = false
		self.BacklogWarningCount = 0
		self:SetSimulationSpeed(speed)
		self.IsRunning = true

		local board = self:GetBoard()
		if isvalid(board) then
			board:UpdateBattleRemainingFromCombat(0, self.ActiveBattleLimitTicks)
		end

		log(
			"[ThreeLaneCombat] StartBattle - Units="
			.. tostring(self:CountActiveUnits())
			.. ", LimitTicks="
			.. tostring(self.ActiveBattleLimitTicks)
			.. ", Speed=x"
			.. tostring(self.SimulationSpeed)
		)
	end

	@ExecSpace("ServerOnly")
	method void PrepareReveal()
		-- 새 Reveal에서 전투 Tick을 0으로 고정하되 이미 소환된 유닛 레지스트리는 유지한다.
		self.IsRunning = false
		self.SimAccumulator = 0
		self.SimTick = 0
		self.ActiveBattleLimitTicks = self.BattleTimeLimitTicks
		self.BacklogWarned = false
		self.BacklogWarningCount = 0
		self:StopAllVisuals()
		log("[ThreeLaneCombat] PrepareReveal - Tick=0, Running=false")
	end

	@ExecSpace("ServerOnly")
	method void SetSimulationSpeed(number speed)
		-- 처리 Tick 수에만 영향을 주도록 배속을 1 또는 2로 정규화한다.
		if speed ~= 2 then
			self.SimulationSpeed = 1
		else
			self.SimulationSpeed = 2
		end
	end

	@ExecSpace("ServerOnly")
	method void AdvanceSimulation(number delta)
		-- 누적 시간을 버리지 않고 프레임당 상한까지 고정 Tick을 순서대로 처리한다.
		self.SimAccumulator = self.SimAccumulator + delta * self.SimulationSpeed
		local processed = 0

		while self.IsRunning
			and self.SimAccumulator + 0.000000001 >= self.SimStep
			and processed < self.MaxStepsPerFrame do
			self.SimAccumulator = self.SimAccumulator - self.SimStep
			self:StepBattle()
			processed = processed + 1
		end

		if not self.IsRunning then
			self.SimAccumulator = 0
			return
		end

		if self.SimAccumulator + 0.000000001 >= self.SimStep then
			if not self.BacklogWarned then
				self.BacklogWarned = true
				self.BacklogWarningCount = self.BacklogWarningCount + 1
				log_warning(
					"[ThreeLaneCombat] BACKLOG retained - Tick="
					.. tostring(self.SimTick)
					.. ", Accumulator="
					.. tostring(self.SimAccumulator)
					.. ", MaxStepsPerFrame="
					.. tostring(self.MaxStepsPerFrame)
				)
			end
		else
			self.BacklogWarned = false
		end
	end

	@ExecSpace("ServerOnly")
	method void StepBattle()
		-- 한 Tick의 스냅샷부터 Resolve 판정까지 고정된 순서로 모두 처리한다.
		if not self.IsRunning then
			return
		end

		local board = self:GetBoard()
		if not isvalid(board) then
			self.IsRunning = false
			return
		end

		self.SimTick = self.SimTick + 1
		self:ApplyMakerTestHooks()

		local snapshot = self:BuildStableSnapshot()
		self:ValidateTargets(snapshot)
		self:AcquireTargets(snapshot)
		self:MoveUnits(snapshot)
		local intents = self:ResolveRangesAndNexus(snapshot)
		self:CollectAttackIntents(snapshot, intents)
		local damageTotals = self:ApplyDamageIntents(intents)
		self:FinalizeDeathsAndExits(snapshot)

		board:UpdateBattleRemainingFromCombat(self.SimTick, self.ActiveBattleLimitTicks)
		board:ApplyNexusDamageBatch(
			damageTotals.PlayerNexusDamage,
			damageTotals.EnemyNexusDamage,
			self.SimTick
		)

		if board.BattleState ~= "Playing" then
			self.IsRunning = false
			self:StopAllVisuals()
			return
		end

		if self.SimTick >= self.ActiveBattleLimitTicks then
			self:TimeoutActiveUnits()
			self.IsRunning = false
			board:OnCombatResolved("Timeout", self.SimTick)
			return
		end

		if self:CountActiveUnits() == 0 then
			self.IsRunning = false
			board:OnCombatResolved("AllResolved", self.SimTick)
		end
	end

	@ExecSpace("ServerOnly")
	method table BuildStableSnapshot()
		-- 생존·미퇴장 유닛만 모아 CombatUnitId 오름차순으로 정렬한다.
		local snapshot = {}
		for _, unit in ipairs(self.Units) do
			if self:IsUnitActive(unit) then
				table.insert(snapshot, unit)
			end
		end

		table.sort(
			snapshot,
			function(a, b)
				return a.CombatUnitId < b.CombatUnitId
			end
		)
		return snapshot
	end

	@ExecSpace("ServerOnly")
	method boolean IsUnitActive(any unit)
		-- 테스트 테이블과 실제 컴포넌트를 같은 생존 규칙으로 판정한다.
		if unit == nil then
			return false
		end
		if unit.IsTestUnit == true then
			return unit.Alive == true and unit.Exited ~= true and unit.PendingExit ~= true
		end
		return isvalid(unit)
			and unit.Alive == true
			and unit.Exited ~= true
			and unit.PendingExit ~= true
	end

	@ExecSpace("ServerOnly")
	method any GetUnitById(integer combatUnitId)
		-- 등록 테이블에서 지정 CombatUnitId의 유닛을 반환한다.
		if combatUnitId <= 0 then
			return nil
		end
		return self.UnitById[combatUnitId]
	end

	@ExecSpace("ServerOnly")
	method void ValidateTargets(table snapshot)
		-- 사망·퇴장·라인 불일치·교전 후 사거리 이탈 대상의 예약 공격을 취소한다.
		for _, unit in ipairs(snapshot) do
			if unit.TargetCombatUnitId > 0 then
				local target = self:GetUnitById(unit.TargetCombatUnitId)
				local invalid = not self:IsUnitActive(target)
					or target.OwnerSide == unit.OwnerSide
					or target.LaneIndex ~= unit.LaneIndex

				if not invalid and unit.EngageTick >= 0 then
					local distance = math.abs(target.SimX - unit.SimX)
					if distance > unit.AttackRange + 0.000001 then
						invalid = true
					end
				end

				if invalid then
					self:CancelCurrentTarget(unit, "InvalidOrOutOfRange")
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void CancelCurrentTarget(any unit, string reason)
		-- 현재 대상과 공격 예약을 모두 지우고 다음 재탐색이 18 Tick부터 다시 시작되게 한다.
		local oldTargetId = unit.TargetCombatUnitId
		local hadWindup = unit.EngageTick >= 0 and unit.NextAttackTick > self.SimTick
		unit.TargetCombatUnitId = 0
		unit.LastTargetCombatUnitId = oldTargetId
		unit.EngageTick = -1
		unit.NextAttackTick = -1

		if self.CurrentScenario == "CancelDuringWindup" and hadWindup then
			self.ScenarioMetrics.CancelObserved = true
		end

		log(
			"[ThreeLaneCombat][TargetCancel] Tick="
			.. tostring(self.SimTick)
			.. ", Unit="
			.. tostring(unit.CombatUnitId)
			.. ", Target="
			.. tostring(oldTargetId)
			.. ", Reason="
			.. reason
		)
	end

	@ExecSpace("ServerOnly")
	method void AcquireTargets(table snapshot)
		-- 대상이 없는 유닛마다 같은 라인의 가장 가까운 적을 ID 동률 규칙으로 선택한다.
		for _, unit in ipairs(snapshot) do
			if unit.TargetCombatUnitId == 0 then
				local target = self:FindFrontTarget(unit, snapshot)
				if target ~= nil then
					unit.TargetCombatUnitId = target.CombatUnitId
					table.insert(unit.TargetHistory, target.CombatUnitId)

					if self.CurrentScenario == "FrontTargetThenRetarget"
						and unit.OwnerSide == 1 then
						if self.ScenarioMetrics.FirstTargetId == nil then
							self.ScenarioMetrics.FirstTargetId = target.CombatUnitId
						elseif target.CombatUnitId ~= self.ScenarioMetrics.FirstTargetId then
							self.ScenarioMetrics.RetargetId = target.CombatUnitId
						end
					end

					log(
						"[ThreeLaneCombat][Target] Tick="
						.. tostring(self.SimTick)
						.. ", Unit="
						.. tostring(unit.CombatUnitId)
						.. ", Target="
						.. tostring(target.CombatUnitId)
					)
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method any FindFrontTarget(any attacker, table snapshot)
		-- 같은 라인의 반대 진영 중 X 거리가 가장 짧은 적을 선택하고 동률은 ID로 깬다.
		return self:FindFrontTargetInLane(attacker, snapshot, attacker.LaneIndex)
	end

	@ExecSpace("ServerOnly")
	method any FindFrontTargetInLane(any attacker, table snapshot, integer laneIndex)
		-- 지정 라인의 최전방 적을 거리순으로 선택한다. 추가타도 같은 안정 ID 동률 규칙을 공유한다.
		local best = nil
		local bestDistance = 999999
		for _, candidate in ipairs(snapshot) do
			if candidate.OwnerSide ~= attacker.OwnerSide
				and candidate.LaneIndex == laneIndex
				and self:IsUnitActive(candidate) then
				local distance = math.abs(candidate.SimX - attacker.SimX)
				if distance < bestDistance - 0.000001
					or (math.abs(distance - bestDistance) <= 0.000001
						and (best == nil or candidate.CombatUnitId < best.CombatUnitId)) then
					best = candidate
					bestDistance = distance
				end
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method integer GetLaneIndexByName(string laneName)
		-- MonsterData 문자열을 전투 보드의 고정 라인 인덱스로 변환한다.
		if laneName == "Top" then
			return 1
		elseif laneName == "Middle" then
			return 2
		elseif laneName == "Bottom" then
			return 3
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void MoveUnits(table snapshot)
		-- 대상 사거리 또는 수호석 도달 전까지 SimX를 고정 스텝으로만 전진시킨다.
		for _, unit in ipairs(snapshot) do
			local shouldMove = true
			local target = self:GetUnitById(unit.TargetCombatUnitId)
			if self:IsUnitActive(target) then
				local distance = math.abs(target.SimX - unit.SimX)
				if distance <= unit.AttackRange + 0.000001 then
					shouldMove = false
				end
			elseif unit.OwnerSide == 1 and unit.SimX >= unit.TargetNexusX then
				shouldMove = false
			elseif unit.OwnerSide == 2 and unit.SimX <= unit.TargetNexusX then
				shouldMove = false
			end

			if shouldMove then
				local direction = 1
				if unit.OwnerSide == 2 then
					direction = -1
				end
				unit.SimX = unit.SimX + direction * unit.MoveSpeed * self.SimStep
				self:SetUnitVisualVelocity(unit, direction * unit.MoveSpeed * self.SimulationSpeed)
			else
				self:SetUnitVisualVelocity(unit, 0)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table ResolveRangesAndNexus(table snapshot)
		-- 이동 후 사거리 진입은 공격 예약으로, 수호석 도달은 같은 Tick intent로 등록한다.
		local intents = {}
		for _, unit in ipairs(snapshot) do
			local target = self:GetUnitById(unit.TargetCombatUnitId)
			if self:IsUnitActive(target) then
				local distance = math.abs(target.SimX - unit.SimX)
				if distance <= unit.AttackRange + 0.000001 then
					self:SetUnitVisualVelocity(unit, 0)
					if unit.EngageTick < 0 then
						unit.EngageTick = self.SimTick
						unit.NextAttackTick = self.SimTick + unit.FirstAttackDelayTicks
						log(
							"[ThreeLaneCombat][Engage] Unit="
							.. tostring(unit.CombatUnitId)
							.. ", Target="
							.. tostring(target.CombatUnitId)
							.. ", EngageTick="
							.. tostring(unit.EngageTick)
						)
					end
				end
			elseif unit.TargetCombatUnitId == 0 then
				local reached = (unit.OwnerSide == 1 and unit.SimX >= unit.TargetNexusX)
					or (unit.OwnerSide == 2 and unit.SimX <= unit.TargetNexusX)
				if reached then
					local targetKind = "EnemyNexus"
					if unit.OwnerSide == 2 then
						targetKind = "PlayerNexus"
					end
					table.insert(
						intents,
						{
							AttackerId = unit.CombatUnitId,
							TargetKind = targetKind,
							TargetId = 0,
							IntentKind = "Nexus",
							IntentOrder = 1,
							Damage = unit.NexusDamage
						}
					)
					unit.PendingExit = true
					self:SetUnitVisualVelocity(unit, 0)
					log(
						"[ThreeLaneCombat][AttackIntent] Tick="
						.. tostring(self.SimTick)
						.. ", Attacker="
						.. tostring(unit.CombatUnitId)
						.. ", Target="
						.. targetKind
						.. ", Damage="
						.. tostring(unit.NexusDamage)
					)
				end
			end
		end
		return intents
	end

	@ExecSpace("ServerOnly")
	method void CollectAttackIntents(table snapshot, table intents)
		-- 예약 Tick에 도달한 모든 유닛 공격을 피해 적용 전 intent 묶음에 추가한다.
		for _, unit in ipairs(snapshot) do
			if unit.TargetCombatUnitId > 0
				and unit.EngageTick >= 0
				and unit.NextAttackTick >= 0
				and self.SimTick >= unit.NextAttackTick then
				local target = self:GetUnitById(unit.TargetCombatUnitId)
				local inRange = self:IsUnitActive(target)
					and math.abs(target.SimX - unit.SimX) <= unit.AttackRange + 0.000001
				if inRange then
					table.insert(
						intents,
						{
							AttackerId = unit.CombatUnitId,
							TargetKind = "Unit",
							TargetId = target.CombatUnitId,
							IntentKind = "Primary",
							IntentOrder = 1,
							Damage = unit.Attack
						}
					)
					table.insert(unit.AttackIntentTicks, self.SimTick)
					table.insert(
						unit.DamageIntentHistory,
						{
							Tick = self.SimTick,
							IntentKind = "Primary",
							TargetId = target.CombatUnitId,
							Damage = unit.Attack
						}
					)
					log(
						"[ThreeLaneCombat][AttackIntent] Tick="
						.. tostring(self.SimTick)
						.. ", Attacker="
						.. tostring(unit.CombatUnitId)
						.. ", Target="
						.. tostring(target.CombatUnitId)
						.. ", Damage="
						.. tostring(unit.Attack)
					)
					self:CollectSecondaryAttackIntent(unit, snapshot, intents)
					unit.NextAttackTick = unit.NextAttackTick + unit.AttackIntervalTicks
				else
					self:CancelCurrentTarget(unit, "TargetInvalidOrOutOfRangeBeforeIntent")
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void CollectSecondaryAttackIntent(any unit, table snapshot, table intents)
		-- 유효한 기본 유닛 공격과 같은 Tick에만 데이터가 지정한 고정 라인 추가타를 등록한다.
		local rate = unit.SecondaryDamageRate or 0
		local laneIndex = self:GetLaneIndexByName(unit.SecondaryTargetLane or "None")
		if rate <= 0 or laneIndex == 0 then
			return
		end

		local secondaryTarget = self:FindFrontTargetInLane(unit, snapshot, laneIndex)
		if secondaryTarget == nil then
			log(
				"[ThreeLaneCombat][SecondaryConsumed] Tick="
				.. tostring(self.SimTick)
				.. ", Attacker="
				.. tostring(unit.CombatUnitId)
				.. ", Lane="
				.. tostring(unit.SecondaryTargetLane)
				.. ", Reason=NoTarget"
			)
			return
		end

		local damage = math.floor(unit.Attack * rate)
		if damage <= 0 then
			log(
				"[ThreeLaneCombat][SecondaryConsumed] Tick="
				.. tostring(self.SimTick)
				.. ", Attacker="
				.. tostring(unit.CombatUnitId)
				.. ", Reason=NonPositiveDamage"
			)
			return
		end

		table.insert(
			intents,
			{
				AttackerId = unit.CombatUnitId,
				TargetKind = "Unit",
				TargetId = secondaryTarget.CombatUnitId,
				IntentKind = "Secondary",
				IntentOrder = 2,
				Damage = damage
			}
		)
		table.insert(unit.SecondaryIntentTicks, self.SimTick)
		table.insert(unit.SecondaryTargetHistory, secondaryTarget.CombatUnitId)
		table.insert(
			unit.DamageIntentHistory,
			{
				Tick = self.SimTick,
				IntentKind = "Secondary",
				TargetId = secondaryTarget.CombatUnitId,
				Damage = damage
			}
		)
		log(
			"[ThreeLaneCombat][SecondaryIntent] Tick="
			.. tostring(self.SimTick)
			.. ", Attacker="
			.. tostring(unit.CombatUnitId)
			.. ", Target="
			.. tostring(secondaryTarget.CombatUnitId)
			.. ", Lane="
			.. tostring(unit.SecondaryTargetLane)
			.. ", Rate="
			.. tostring(rate)
			.. ", CurrentAttack="
			.. tostring(unit.Attack)
			.. ", Damage="
			.. tostring(damage)
		)
	end

	@ExecSpace("ServerOnly")
	method table ApplyDamageIntents(table intents)
		-- intent를 공격자·기본/추가 순서·대상 ID로 고정하되 모든 피해는 사망 처리 전에 적용한다.
		table.sort(
			intents,
			function(a, b)
				if a.AttackerId == b.AttackerId then
					if a.IntentOrder == b.IntentOrder then
						return a.TargetId < b.TargetId
					end
					return a.IntentOrder < b.IntentOrder
				end
				return a.AttackerId < b.AttackerId
			end
		)

		local totals = { PlayerNexusDamage = 0, EnemyNexusDamage = 0 }
		for _, intent in ipairs(intents) do
			if intent.TargetKind == "Unit" then
				local target = self:GetUnitById(intent.TargetId)
				if target ~= nil and target.Alive == true then
					local before = target.HP
					target.HP = target.HP - intent.Damage
					log(
						"[ThreeLaneCombat][Damage] Tick="
						.. tostring(self.SimTick)
						.. ", Attacker="
						.. tostring(intent.AttackerId)
						.. ", Target="
						.. tostring(intent.TargetId)
						.. ", Kind="
						.. tostring(intent.IntentKind)
						.. ", HP="
						.. tostring(before)
						.. "->"
						.. tostring(target.HP)
					)
				end
			elseif intent.TargetKind == "PlayerNexus" then
				totals.PlayerNexusDamage = totals.PlayerNexusDamage + intent.Damage
			elseif intent.TargetKind == "EnemyNexus" then
				totals.EnemyNexusDamage = totals.EnemyNexusDamage + intent.Damage
			end
		end
		return totals
	end

	@ExecSpace("ServerOnly")
	method void FinalizeDeathsAndExits(table snapshot)
		-- 같은 Tick 피해 적용이 끝난 뒤 HP 0 사망과 수호석 공격 후 퇴장을 확정한다.
		for _, unit in ipairs(snapshot) do
			if unit.Alive == true and unit.HP <= 0 then
				unit.Alive = false
				unit.DeathTick = self.SimTick
				self:SetUnitVisualVelocity(unit, 0)
				log(
					"[ThreeLaneCombat][Death] CombatUnitId="
					.. tostring(unit.CombatUnitId)
					.. ", DeathTick="
					.. tostring(unit.DeathTick)
				)
				self:DestroyVisualEntity(unit)
			elseif unit.PendingExit == true then
				unit.PendingExit = false
				unit.Exited = true
				self:SetUnitVisualVelocity(unit, 0)
				log(
					"[ThreeLaneCombat][Exit] CombatUnitId="
					.. tostring(unit.CombatUnitId)
					.. ", Tick="
					.. tostring(self.SimTick)
				)
				self:DestroyVisualEntity(unit)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyMakerTestHooks()
		-- Maker 전용 취소 시나리오의 강제 제거를 snapshot 생성 전에만 적용한다.
		if not self.MakerTestMode then
			return
		end

		for _, unit in ipairs(self.Units) do
			if unit.IsTestUnit == true
				and unit.Alive == true
				and unit.ForcedDeathTick == self.SimTick then
				unit.Alive = false
				unit.DeathTick = self.SimTick
				log(
					"[ThreeLaneCombat][TestForcedRemoval] CombatUnitId="
					.. tostring(unit.CombatUnitId)
					.. ", Tick="
					.. tostring(self.SimTick)
				)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TimeoutActiveUnits()
		-- 3,600번째 Tick의 피해 적용 뒤 남은 유닛을 같은 Tick에 시간 초과 사망시킨다.
		local snapshot = self:BuildStableSnapshot()
		for _, unit in ipairs(snapshot) do
			unit.Alive = false
			unit.HP = 0
			unit.DeathTick = self.SimTick
			self:SetUnitVisualVelocity(unit, 0)
			log(
				"[ThreeLaneCombat][TimeoutDeath] CombatUnitId="
				.. tostring(unit.CombatUnitId)
				.. ", DeathTick="
				.. tostring(unit.DeathTick)
			)
			self:DestroyVisualEntity(unit)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetUnitVisualVelocity(any unit, number signedSpeed)
		-- 실제 유닛일 때만 Combat 계산 속도를 Kinematicbody에 전달한다.
		if unit == nil or unit.IsTestUnit == true then
			return
		end
		if isvalid(unit) then
			unit:SetVisualVelocity(signedSpeed)
		end
	end

	@ExecSpace("ServerOnly")
	method void DestroyVisualEntity(any unit)
		-- 테스트 테이블은 유지하고 실제 스폰 엔티티만 전장에서 제거한다.
		if unit == nil or unit.IsTestUnit == true then
			return
		end
		if isvalid(unit) and isvalid(unit.Entity) then
			_EntityService:Destroy(unit.Entity)
		end
	end

	@ExecSpace("ServerOnly")
	method void StopAllVisuals()
		-- 현재 등록된 실제 유닛의 시각 이동을 모두 정지한다.
		for _, unit in ipairs(self.Units) do
			self:SetUnitVisualVelocity(unit, 0)
		end
	end

	@ExecSpace("ServerOnly")
	method integer CountActiveUnits()
		-- 단일 권위 레지스트리의 생존·미퇴장 유닛 수를 반환한다.
		return #self:BuildStableSnapshot()
	end

	@ExecSpace("ServerOnly")
	method void RegisterUnit(any unit)
		-- Board가 스탯을 주입한 유닛에 안정적인 CombatUnitId를 부여해 등록한다.
		if unit == nil then
			return
		end

		if unit.IsTestUnit ~= true and not isvalid(unit) then
			return
		end

		unit.CombatUnitId = self.NextCombatUnitId
		self.NextCombatUnitId = self.NextCombatUnitId + 1
		unit.TargetCombatUnitId = 0
		unit.LastTargetCombatUnitId = 0
		unit.EngageTick = -1
		unit.NextAttackTick = -1
		unit.DeathTick = -1
		unit.Alive = true
		unit.Exited = false
		unit.PendingExit = false
		unit.AttackIntentTicks = {}
		unit.TargetHistory = {}
		unit.SecondaryIntentTicks = {}
		unit.SecondaryTargetHistory = {}
		unit.DamageIntentHistory = {}
		if unit.IsTestUnit ~= true then
			unit:SetVisualVelocity(0)
		end

		self.UnitById[unit.CombatUnitId] = unit
		table.insert(self.Units, unit)
		log(
			"[ThreeLaneCombat][Register] CombatUnitId="
			.. tostring(unit.CombatUnitId)
			.. ", Side="
			.. tostring(unit.OwnerSide)
			.. ", Lane="
			.. tostring(unit.LaneIndex)
			.. ", Slot="
			.. tostring(unit.SlotIndex)
			.. ", MonsterId="
			.. tostring(unit.MonsterId)
			.. ", RangeClass="
			.. tostring(unit.RangeClass)
			.. ", SimX="
			.. tostring(unit.SimX)
		)
	end

	@ExecSpace("ServerOnly")
	method void ClearAllUnits(boolean destroyEntities)
		-- 레지스트리를 비우고 요청된 경우 실제 스폰 엔티티도 함께 제거한다.
		for _, unit in ipairs(self.Units) do
			self:SetUnitVisualVelocity(unit, 0)
			if destroyEntities then
				self:DestroyVisualEntity(unit)
			end
		end
		self.Units = {}
		self.UnitById = {}
		self.NextCombatUnitId = 1
	end

	@ExecSpace("ServerOnly")
	method void ResetSimulation(boolean destroyEntities)
		-- 정상 재시작을 위해 테스트 오버라이드와 Tick 누적을 기본값으로 복구한다.
		self.IsRunning = false
		self:ClearAllUnits(destroyEntities)
		self.SimAccumulator = 0
		self.SimTick = 0
		self.SimulationSpeed = 1
		self.ActiveBattleLimitTicks = self.BattleTimeLimitTicks
		self.BacklogWarned = false
		self.BacklogWarningCount = 0
		self.MakerTestMode = false
		self.CurrentScenario = ""
		self.ScenarioMetrics = {}
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C3BTests()
		-- 고정 라인 추가타 13개 규칙 시나리오와 실제 스폰 경로를 한 번에 검증한다.
		self.MakerHarnessRunning = true
		local allPassed = true
		local scenarios = {
			"GreenFocusTop",
			"GreenSplitTop",
			"GreenEmptySecondary",
			"NoPrimaryNoSecondary",
			"PinkFocusBottom",
			"PinkSplitBottom",
			"SecondaryIgnoresRange",
			"BuffScalesSecondary",
			"SecondaryFloor",
			"SameTickLethal",
			"BothSidesSecondary",
			"SpeedDeterminism",
			"NextTurnReset"
		}

		for _, scenarioName in ipairs(scenarios) do
			local passed = self:RunPhase2C3BScenario(scenarioName)
			allPassed = self:RecordPhase2C3BResult(scenarioName, passed) and allPassed
		end

		local board = self:GetBoard()
		if isvalid(board) then
			local actualPassed = board:RunMakerPhase2C3BActualSpawnRegression()
			allPassed = self:RecordPhase2C3BResult("ActualSpawnSecondary", actualPassed) and allPassed
			board:ResetBattle()
		else
			allPassed = self:RecordPhase2C3BResult("ActualSpawnSecondary", false) and allPassed
		end
		self.MakerHarnessRunning = false

		if allPassed then
			log("[Phase2C3B][TEST][ALL] PASS - normal play state restored")
		else
			log_error("[Phase2C3B][TEST][ALL] FAIL - see scenario logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean RecordPhase2C3BResult(string scenarioName, boolean passed)
		-- 각 규칙의 결과를 독립 접두사로 남겨 Maker runtime 로그에서 누락 없이 확인한다.
		if passed then
			log("[Phase2C3B][TEST][" .. scenarioName .. "] PASS")
		else
			log_error("[Phase2C3B][TEST][" .. scenarioName .. "] FAIL")
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean PreparePhase2C3BTestState()
		-- 시나리오마다 보드·레지스트리·Tick을 정상 초기값에서 다시 구성한다.
		local board = self:GetBoard()
		if not isvalid(board) then
			return false
		end
		self.MakerHarnessRunning = true
		board:ResetBattle()
		self.MakerHarnessRunning = true
		self.MakerTestMode = true
		self.CurrentScenario = "Phase2C3B"
		self.ScenarioMetrics = {}
		self.ActiveBattleLimitTicks = self.BattleTimeLimitTicks
		self.SimAccumulator = 0
		self.SimTick = 0
		self.BacklogWarned = false
		self.BacklogWarningCount = 0
		self.IsRunning = true
		self.SimulationSpeed = 1
		board.PlayerNexusHp = 30
		board.EnemyNexusHp = 30
		board.BattleState = "Playing"
		board.Phase = "Battle"
		board.CurrentCost = 1
		board.EnemyCurrentCost = 1
		board.BattleRemaining = 60
		return true
	end

	@ExecSpace("ServerOnly")
	method void ConfigurePhase2C3BPassiveTarget(any unit, integer hp)
		-- 표적이 시나리오 결과에 역공·이동으로 개입하지 않게 하되 정상 target 탐색에는 남긴다.
		if unit == nil then
			return
		end
		unit.HP = hp
		unit.MaxHP = hp
		unit.Attack = 0
		unit.BaseAttack = 0
		unit.CombatAttackBonus = 0
		unit.FirstAttackDelayTicks = 9999
		unit.MoveSpeed = 0
	end

	@ExecSpace("ServerOnly")
	method void RunPhase2C3BTicks(integer targetTick)
		-- 정상 StepBattle 경로만 사용해 요청 Tick까지 진행한다.
		local safety = 0
		while self.IsRunning and self.SimTick < targetTick and safety < 5000 do
			self:StepBattle()
			safety = safety + 1
		end
		if safety >= 5000 and self.IsRunning then
			self.IsRunning = false
			log_error("[Phase2C3B][TEST] tick safety limit reached")
		end
	end

	@ExecSpace("ServerOnly")
	method boolean HasDamageIntent(any unit, integer index, string kind, integer targetId, integer damage)
		-- 한 공격의 기본·추가 피해가 합쳐지지 않은 별도 intent인지 정확히 비교한다.
		if unit == nil or unit.DamageIntentHistory == nil then
			return false
		end
		local intent = unit.DamageIntentHistory[index]
		return intent ~= nil
			and intent.Tick == 19
			and intent.IntentKind == kind
			and intent.TargetId == targetId
			and intent.Damage == damage
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C3BScenario(string scenarioName)
		-- 테스트 전용 결과 조작 없이 실제 target·range·intent·batch damage 경로를 사용한다.
		if scenarioName == "SpeedDeterminism" then
			local speed1 = self:BuildPhase2C3BSpeedSignature(1)
			local speed2 = self:BuildPhase2C3BSpeedSignature(2)
			log(
				"[Phase2C3B][SpeedCompare] Speed1="
				.. speed1
				.. ", Speed2="
				.. speed2
				.. ", Equal="
				.. tostring(speed1 ~= "" and speed1 == speed2)
			)
			return speed1 ~= "" and speed1 == speed2
		end

		if scenarioName == "NextTurnReset" then
			if not self:PreparePhase2C3BTestState() then
				return false
			end
			local oldGreen = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
			local oldTarget = self:CreateTestMonster("drake", 2, 2, 0.3)
			if oldGreen == nil or oldTarget == nil then
				return false
			end
			self:ConfigurePhase2C3BPassiveTarget(oldTarget, 1000)
			oldGreen.MoveSpeed = 0
			oldGreen.CombatAttackBonus = 30
			oldGreen.Attack = oldGreen.BaseAttack + oldGreen.CombatAttackBonus
			self:RunPhase2C3BTicks(19)
			local oldResolved = #oldGreen.DamageIntentHistory == 1
				and oldGreen.Attack == 120

			if not self:PreparePhase2C3BTestState() then
				return false
			end
			local freshGreen = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
			return oldResolved
				and freshGreen ~= nil
				and freshGreen.Attack == 90
				and freshGreen.BaseAttack == 90
				and freshGreen.CombatAttackBonus == 0
				and freshGreen.TargetCombatUnitId == 0
				and #freshGreen.AttackIntentTicks == 0
				and #freshGreen.SecondaryIntentTicks == 0
				and #freshGreen.SecondaryTargetHistory == 0
				and #freshGreen.DamageIntentHistory == 0
				and freshGreen.SecondaryTargetLane == "Top"
				and math.abs(freshGreen.SecondaryDamageRate - 0.5) <= 0.000001
		end

		if not self:PreparePhase2C3BTestState() then
			return false
		end

		if scenarioName == "GreenFocusTop" then
			local green = self:CreateTestMonster("green_mushroom", 1, 1, -0.3)
			local target = self:CreateTestMonster("drake", 2, 1, 0.3)
			if green == nil or target == nil then return false end
			green.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(target, 1000)
			self:RunPhase2C3BTicks(19)
			return target.HP == 865
				and #green.DamageIntentHistory == 2
				and self:HasDamageIntent(green, 1, "Primary", target.CombatUnitId, 90)
				and self:HasDamageIntent(green, 2, "Secondary", target.CombatUnitId, 45)
		end

		if scenarioName == "GreenSplitTop" then
			local green = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
			local primary = self:CreateTestMonster("drake", 2, 2, 0.3)
			local secondary = self:CreateTestMonster("drake", 2, 1, 5.0)
			if green == nil or primary == nil or secondary == nil then return false end
			green.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(primary, 1000)
			self:ConfigurePhase2C3BPassiveTarget(secondary, 1000)
			self:RunPhase2C3BTicks(19)
			return primary.HP == 910 and secondary.HP == 955
				and self:HasDamageIntent(green, 1, "Primary", primary.CombatUnitId, 90)
				and self:HasDamageIntent(green, 2, "Secondary", secondary.CombatUnitId, 45)
		end

		if scenarioName == "GreenEmptySecondary" then
			local green = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
			local primary = self:CreateTestMonster("drake", 2, 2, 0.3)
			if green == nil or primary == nil then return false end
			green.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(primary, 1000)
			self:RunPhase2C3BTicks(19)
			return primary.HP == 910
				and #green.DamageIntentHistory == 1
				and #green.SecondaryIntentTicks == 0
				and self:HasDamageIntent(green, 1, "Primary", primary.CombatUnitId, 90)
		end

		if scenarioName == "NoPrimaryNoSecondary" then
			local green = self:CreateTestMonster("green_mushroom", 1, 2, -3.0)
			local topEnemy = self:CreateTestMonster("drake", 2, 1, 0.0)
			if green == nil or topEnemy == nil then return false end
			self:ConfigurePhase2C3BPassiveTarget(topEnemy, 1000)
			self:RunPhase2C3BTicks(19)
			return green.SimX > -3.0
				and green.TargetCombatUnitId == 0
				and #green.DamageIntentHistory == 0
				and #green.SecondaryIntentTicks == 0
		end

		if scenarioName == "PinkFocusBottom" then
			local pink = self:CreateTestMonster("pink_bean", 1, 3, -0.3)
			local target = self:CreateTestMonster("drake", 2, 3, 0.3)
			if pink == nil or target == nil then return false end
			pink.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(target, 1000)
			self:RunPhase2C3BTicks(19)
			return target.HP == 730
				and #pink.DamageIntentHistory == 2
				and self:HasDamageIntent(pink, 1, "Primary", target.CombatUnitId, 180)
				and self:HasDamageIntent(pink, 2, "Secondary", target.CombatUnitId, 90)
		end

		if scenarioName == "PinkSplitBottom" then
			local pink = self:CreateTestMonster("pink_bean", 1, 2, -0.3)
			local primary = self:CreateTestMonster("drake", 2, 2, 0.3)
			local secondary = self:CreateTestMonster("drake", 2, 3, 5.0)
			if pink == nil or primary == nil or secondary == nil then return false end
			pink.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(primary, 1000)
			self:ConfigurePhase2C3BPassiveTarget(secondary, 1000)
			self:RunPhase2C3BTicks(19)
			return primary.HP == 820 and secondary.HP == 910
				and self:HasDamageIntent(pink, 1, "Primary", primary.CombatUnitId, 180)
				and self:HasDamageIntent(pink, 2, "Secondary", secondary.CombatUnitId, 90)
		end

		if scenarioName == "SecondaryIgnoresRange" then
			local green = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
			local primary = self:CreateTestMonster("drake", 2, 2, 0.3)
			local farTop = self:CreateTestMonster("drake", 2, 1, 5.0)
			if green == nil or primary == nil or farTop == nil then return false end
			green.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(primary, 1000)
			self:ConfigurePhase2C3BPassiveTarget(farTop, 1000)
			local distance = math.abs(farTop.SimX - green.SimX)
			self:RunPhase2C3BTicks(19)
			return distance > green.AttackRange
				and farTop.HP == 955
				and self:HasDamageIntent(green, 2, "Secondary", farTop.CombatUnitId, 45)
		end

		if scenarioName == "BuffScalesSecondary" then
			local green = self:CreateTestMonster("green_mushroom", 1, 1, -0.3)
			local target = self:CreateTestMonster("drake", 2, 1, 0.3)
			local data = self:GetData()
			if green == nil or target == nil or not isvalid(data) then return false end
			local original = data:GetMonsterById("green_mushroom")
			green.MoveSpeed = 0
			green.CombatAttackBonus = 30
			green.Attack = green.BaseAttack + green.CombatAttackBonus
			self:ConfigurePhase2C3BPassiveTarget(target, 1000)
			self:RunPhase2C3BTicks(19)
			return target.HP == 820
				and original ~= nil and original.Attack == 90
				and green.Attack == 120
				and self:HasDamageIntent(green, 1, "Primary", target.CombatUnitId, 120)
				and self:HasDamageIntent(green, 2, "Secondary", target.CombatUnitId, 60)
		end

		if scenarioName == "SecondaryFloor" then
			local green = self:CreateTestMonster("green_mushroom", 1, 1, -0.3)
			local target = self:CreateTestMonster("drake", 2, 1, 0.3)
			if green == nil or target == nil then return false end
			green.MoveSpeed = 0
			green.CombatAttackBonus = 31
			green.Attack = green.BaseAttack + green.CombatAttackBonus
			self:ConfigurePhase2C3BPassiveTarget(target, 1000)
			self:RunPhase2C3BTicks(19)
			return target.HP == 819
				and self:HasDamageIntent(green, 1, "Primary", target.CombatUnitId, 121)
				and self:HasDamageIntent(green, 2, "Secondary", target.CombatUnitId, 60)
		end

		if scenarioName == "SameTickLethal" then
			local green = self:CreateTestMonster("green_mushroom", 1, 1, -0.3)
			local target = self:CreateTestMonster("drake", 2, 1, 0.3)
			if green == nil or target == nil then return false end
			green.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(target, 90)
			self:RunPhase2C3BTicks(19)
			return target.HP == -45 and target.DeathTick == 19
				and #green.DamageIntentHistory == 2
				and self:HasDamageIntent(green, 2, "Secondary", target.CombatUnitId, 45)
		end

		if scenarioName == "BothSidesSecondary" then
			local green = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
			local pink = self:CreateTestMonster("pink_bean", 2, 2, 0.3)
			local topTarget = self:CreateTestMonster("drake", 2, 1, 5.0)
			local bottomTarget = self:CreateTestMonster("drake", 1, 3, -5.0)
			if green == nil or pink == nil or topTarget == nil or bottomTarget == nil then return false end
			green.MoveSpeed = 0
			pink.MoveSpeed = 0
			self:ConfigurePhase2C3BPassiveTarget(topTarget, 1000)
			self:ConfigurePhase2C3BPassiveTarget(bottomTarget, 1000)
			self:RunPhase2C3BTicks(19)
			return green.HP == 140 and pink.HP == 760
				and topTarget.HP == 955 and bottomTarget.HP == 910
				and #green.DamageIntentHistory == 2
				and #pink.DamageIntentHistory == 2
				and self:HasDamageIntent(green, 2, "Secondary", topTarget.CombatUnitId, 45)
				and self:HasDamageIntent(pink, 2, "Secondary", bottomTarget.CombatUnitId, 90)
		end

		return false
	end

	@ExecSpace("ServerOnly")
	method string BuildPhase2C3BSpeedSignature(integer speed)
		-- 동일한 추가타 사망 장면을 프레임당 1Tick/2Tick 처리로 실행해 결과를 직렬화한다.
		if not self:PreparePhase2C3BTestState() then
			return ""
		end
		local green = self:CreateTestMonster("green_mushroom", 1, 2, -0.3)
		local primary = self:CreateTestMonster("drake", 2, 2, 0.3)
		local secondary = self:CreateTestMonster("drake", 2, 1, 5.0)
		if green == nil or primary == nil or secondary == nil then
			return ""
		end
		green.MoveSpeed = 0
		self:ConfigurePhase2C3BPassiveTarget(primary, 90)
		self:ConfigurePhase2C3BPassiveTarget(secondary, 45)
		self.SimulationSpeed = speed
		local safety = 0
		while self.IsRunning and self.SimTick < 20 and safety < 100 do
			self:AdvanceSimulation(self.SimStep)
			safety = safety + 1
		end
		local board = self:GetBoard()
		if self.SimTick ~= 20 or not isvalid(board) then
			return ""
		end
		return "Tick="
			.. tostring(self.SimTick)
			.. "|Intents="
			.. self:JoinDamageIntentHistory(green.DamageIntentHistory)
			.. "|Primary="
			.. tostring(primary.HP)
			.. ":D"
			.. tostring(primary.DeathTick)
			.. "|Secondary="
			.. tostring(secondary.HP)
			.. ":D"
			.. tostring(secondary.DeathTick)
			.. "|Nexus="
			.. tostring(board.PlayerNexusHp)
			.. "/"
			.. tostring(board.EnemyNexusHp)
			.. "|Turn="
			.. tostring(board.TurnNumber)
			.. "|Phase="
			.. board.Phase
	end

	@ExecSpace("ServerOnly")
	method string JoinDamageIntentHistory(table history)
		-- 별도 기본·추가 intent의 Tick·종류·대상·피해를 안정 문자열로 변환한다.
		local text = ""
		for index, intent in ipairs(history) do
			if index > 1 then
				text = text .. ","
			end
			text = text
				.. tostring(intent.Tick)
				.. ":"
				.. tostring(intent.IntentKind)
				.. ":"
				.. tostring(intent.TargetId)
				.. ":"
				.. tostring(intent.Damage)
		end
		return text
	end

	@ExecSpace("ServerOnly")
	method boolean RunAllMakerTests()
		-- Maker Play에서 Phase 2B 8종과 Phase 2C-2 3종을 실행하고 정상 상태로 복구한다.
		self.MakerHarnessRunning = true
		self.Speed1Signature = ""
		self.Speed2Signature = ""
		local allPassed = true
		local scenarios = {
			"DrakeMirror",
			"FrontTargetThenRetarget",
			"CancelDuringWindup",
			"EmptyLaneFreePass",
			"SimultaneousNexusDraw",
			"Timeout",
			"Speed1",
			"Speed2",
			"RangeClassEngage",
			"FriendlyNoBlock",
			"YetiNexusDamage"
		}

		for _, scenarioName in ipairs(scenarios) do
			local passed = self:RunMakerTestScenarioInternal(scenarioName)
			if not passed then
				allPassed = false
			end
		end

		local board = self:GetBoard()
		if isvalid(board) then
			board:ResetBattle()
		end
		self.MakerHarnessRunning = false

		if allPassed then
			log("[ThreeLaneCombat][TEST][ALL] PASS - normal play state restored")
		else
			log_error("[ThreeLaneCombat][TEST][ALL] FAIL - see scenario logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerTestScenario(string scenarioName)
		-- Maker Play에서 지정 시나리오 하나를 실행한 뒤 정상 상태로 복구한다.
		self.MakerHarnessRunning = true
		local passed = self:RunMakerTestScenarioInternal(scenarioName)
		local board = self:GetBoard()
		if isvalid(board) then
			board:ResetBattle()
		end
		self.MakerHarnessRunning = false
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerTestScenarioInternal(string scenarioName)
		-- 공용 시뮬레이션 경로로 시나리오를 구성·실행·평가한다.
		if not self:SetupMakerScenario(scenarioName) then
			log_error("[ThreeLaneCombat][TEST][" .. scenarioName .. "] UNKNOWN SCENARIO")
			return false
		end

		if scenarioName == "Speed1" or scenarioName == "Speed2" then
			self:RunScenarioByFrames(scenarioName)
		else
			self:RunScenarioByTicks()
		end

		local passed = self:EvaluateMakerScenario(scenarioName)
		local signature = self:GetCurrentSignature()
		if passed then
			log("[ThreeLaneCombat][TEST][" .. scenarioName .. "] PASS " .. signature)
		else
			log_error("[ThreeLaneCombat][TEST][" .. scenarioName .. "] FAIL " .. signature)
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean SetupMakerScenario(string scenarioName)
		-- 테스트 전용 유닛과 보드 상태를 만들되 다음 ResetBattle에서 모두 폐기되게 한다.
		self.MakerHarnessRunning = true
		local board = self:GetBoard()
		if not isvalid(board) then
			return false
		end

		board:ResetBattle()
		self.MakerTestMode = true
		self.CurrentScenario = scenarioName
		self.ScenarioMetrics = {}
		self.ActiveBattleLimitTicks = self.BattleTimeLimitTicks
		self.SimAccumulator = 0
		self.SimTick = 0
		self.BacklogWarned = false
		self.BacklogWarningCount = 0
		self.IsRunning = true
		self.SimulationSpeed = 1

		board.PlayerNexusHp = 30
		board.EnemyNexusHp = 30
		board.BattleState = "Playing"
		board.Phase = "Battle"
		board.CurrentCost = 1
		board.EnemyCurrentCost = 1
		board.BattleRemaining = 60

		if scenarioName == "DrakeMirror" or scenarioName == "Speed1" or scenarioName == "Speed2" then
			self:CreateTestDrake(1, 2, -3.0)
			self:CreateTestDrake(2, 2, 3.0)
			if scenarioName == "Speed2" then
				self.SimulationSpeed = 2
			end
			return true
		end

		if scenarioName == "FrontTargetThenRetarget" then
			local attacker = self:CreateTestDrake(1, 2, -0.35)
			local front = self:CreateTestDrake(2, 2, 0.35)
			local rear = self:CreateTestDrake(2, 2, 1.20)
			front.HP = 120
			front.MaxHP = 120
			front.Attack = 1
			rear.Attack = 1
			self.ScenarioMetrics.AttackerId = attacker.CombatUnitId
			self.ScenarioMetrics.ExpectedFirstId = front.CombatUnitId
			self.ScenarioMetrics.ExpectedRetargetId = rear.CombatUnitId
			return true
		end

		if scenarioName == "CancelDuringWindup" then
			local attacker = self:CreateTestDrake(1, 2, -0.35)
			local target = self:CreateTestDrake(2, 2, 0.35)
			target.ForcedDeathTick = 10
			self.ScenarioMetrics.AttackerId = attacker.CombatUnitId
			self.ScenarioMetrics.TargetId = target.CombatUnitId
			return true
		end

		if scenarioName == "EmptyLaneFreePass" then
			local runner = self:CreateTestDrake(1, 1, 5.34)
			self.ScenarioMetrics.RunnerId = runner.CombatUnitId
			return true
		end

		if scenarioName == "SimultaneousNexusDraw" then
			board.PlayerNexusHp = 5
			board.EnemyNexusHp = 5
			self:CreateTestDrake(1, 1, 5.35)
			self:CreateTestDrake(2, 3, -5.35)
			return true
		end

		if scenarioName == "Timeout" then
			local scorer = self:CreateTestDrake(1, 1, 5.35)
			local survivor = self:CreateTestDrake(2, 2, 3.0)
			survivor.MoveSpeed = 0
			self.SimTick = self.BattleTimeLimitTicks - 1
			self.ScenarioMetrics.ScorerId = scorer.CombatUnitId
			self.ScenarioMetrics.SurvivorId = survivor.CombatUnitId
			return true
		end

		if scenarioName == "RangeClassEngage" then
			local melee = self:CreateTestMonster("slime", 1, 1, -3.0)
			local meleeTarget = self:CreateTestMonster("drake", 2, 1, 0.0)
			local ranged = self:CreateTestMonster("green_mushroom", 1, 3, -3.0)
			local rangedTarget = self:CreateTestMonster("drake", 2, 3, 0.0)
			if melee == nil or meleeTarget == nil or ranged == nil or rangedTarget == nil then
				return false
			end
			meleeTarget.HP = 999999
			meleeTarget.MaxHP = 999999
			meleeTarget.Attack = 0
			meleeTarget.MoveSpeed = 0
			rangedTarget.HP = 999999
			rangedTarget.MaxHP = 999999
			rangedTarget.Attack = 0
			rangedTarget.MoveSpeed = 0
			self.ScenarioMetrics.MeleeId = melee.CombatUnitId
			self.ScenarioMetrics.MeleeTargetId = meleeTarget.CombatUnitId
			self.ScenarioMetrics.RangedId = ranged.CombatUnitId
			self.ScenarioMetrics.RangedTargetId = rangedTarget.CombatUnitId
			self.ActiveBattleLimitTicks = 240
			return true
		end

		if scenarioName == "FriendlyNoBlock" then
			local ranged = self:CreateTestMonster("green_mushroom", 1, 2, -3.0)
			local friendlyFront = self:CreateTestMonster("stone_golem", 1, 2, -0.6)
			local enemy = self:CreateTestMonster("drake", 2, 2, 0.6)
			if ranged == nil or friendlyFront == nil or enemy == nil then
				return false
			end
			friendlyFront.HP = 999999
			friendlyFront.MaxHP = 999999
			friendlyFront.Attack = 0
			friendlyFront.MoveSpeed = 0
			enemy.HP = 999999
			enemy.MaxHP = 999999
			enemy.Attack = 0
			enemy.MoveSpeed = 0
			self.ScenarioMetrics.RangedId = ranged.CombatUnitId
			self.ScenarioMetrics.FriendlyId = friendlyFront.CombatUnitId
			self.ScenarioMetrics.EnemyId = enemy.CombatUnitId
			self.ActiveBattleLimitTicks = 240
			return true
		end

		if scenarioName == "YetiNexusDamage" then
			local yeti = self:CreateTestMonster("yeti", 1, 2, 5.35)
			if yeti == nil then
				return false
			end
			self.ScenarioMetrics.YetiId = yeti.CombatUnitId
			return true
		end

		return false
	end

	@ExecSpace("ServerOnly")
	method any CreateTestDrake(integer ownerSide, integer laneIndex, number simX)
		-- 카드 5가 아닌 BalanceReference MonsterId로 드레이크 회귀 상태를 만든다.
		return self:CreateTestMonster("drake", ownerSide, laneIndex, simX)
	end

	@ExecSpace("ServerOnly")
	method any CreateTestMonster(string monsterId, integer ownerSide, integer laneIndex, number simX)
		-- 실제 엔티티 없이 MonsterData 한 행을 동일한 Combat 경로의 상태 테이블로 변환한다.
		local data = self:GetData()
		if not isvalid(data) then
			log_error("[ThreeLaneCombat][TEST] ThreeLaneData unavailable for " .. monsterId)
			return nil
		end
		local monster = data:GetMonsterById(monsterId)
		if monster == nil then
			log_error("[ThreeLaneCombat][TEST] MonsterData missing MonsterId=" .. monsterId)
			return nil
		end

		local unit = {
			CombatUnitId = 0,
			OwnerSide = ownerSide,
			LaneIndex = laneIndex,
			BaseLaneIndex = laneIndex,
			SlotIndex = 8,
			BaseSlotIndex = 8,
			PlacementOrder = 0,
			CardIndex = monster.CardIndex,
			MonsterId = monster.MonsterId,
			RangeClass = monster.RangeClass,
			Cost = monster.Cost,
			HP = monster.HP,
			MaxHP = monster.HP,
			Attack = monster.Attack,
			BaseAttack = monster.Attack,
			CombatAttackBonus = 0,
			AttackIntervalTicks = monster.AttackIntervalTicks,
			FirstAttackDelayTicks = monster.FirstAttackDelayTicks,
			MoveSpeed = monster.MoveSpeed,
			AttackRange = monster.AttackRange,
			NexusDamage = monster.NexusDamage,
			SecondaryTargetLane = monster.SecondaryTargetLane,
			SecondaryDamageRate = monster.SecondaryDamageRate,
			SimX = simX,
			CombatStartX = simX,
			CombatStartY = 0,
			TargetNexusX = 5.35,
			TargetCombatUnitId = 0,
			LastTargetCombatUnitId = 0,
			EngageTick = -1,
			NextAttackTick = -1,
			DeathTick = -1,
			Alive = true,
			Exited = false,
			PendingExit = false,
			IsTestUnit = true,
			ForcedDeathTick = -1,
			AttackIntentTicks = {},
			TargetHistory = {},
			SecondaryIntentTicks = {},
			SecondaryTargetHistory = {},
			DamageIntentHistory = {}
		}
		if ownerSide == 2 then
			unit.TargetNexusX = -5.35
		end
		self:RegisterUnit(unit)
		return unit
	end

	@ExecSpace("ServerOnly")
	method void RunScenarioByTicks()
		-- 프레임 누적과 무관한 시나리오는 같은 StepBattle을 종료까지 직접 진행한다.
		local safety = 0
		while self.IsRunning and safety < 5000 do
			self:StepBattle()
			safety = safety + 1
		end
		if safety >= 5000 and self.IsRunning then
			self.IsRunning = false
			log_error("[ThreeLaneCombat][TEST] safety limit reached")
		end
	end

	@ExecSpace("ServerOnly")
	method void RunScenarioByFrames(string scenarioName)
		-- Speed 시나리오는 실제 누적기와 프레임당 처리 상한을 통과시켜 결과를 비교한다.
		local safety = 0
		if scenarioName == "Speed2" then
			self:AdvanceSimulation(5.0)
		end

		while self.IsRunning and safety < 5000 do
			self:AdvanceSimulation(self.SimStep)
			safety = safety + 1
		end
		if safety >= 5000 and self.IsRunning then
			self.IsRunning = false
			log_error("[ThreeLaneCombat][TEST] frame safety limit reached")
		end
	end

	@ExecSpace("ServerOnly")
	method boolean EvaluateMakerScenario(string scenarioName)
		-- 각 시나리오의 필수 불변식을 실제 Tick·HP·결과 상태로 판정한다.
		local board = self:GetBoard()
		if not isvalid(board) then
			return false
		end

		if scenarioName == "DrakeMirror" or scenarioName == "Speed1" or scenarioName == "Speed2" then
			local player = self:GetUnitById(1)
			local enemy = self:GetUnitById(2)
			local mirrorPassed = player ~= nil
				and enemy ~= nil
				and player.EngageTick == enemy.EngageTick
				and player.DeathTick == player.EngageTick + 306
				and enemy.DeathTick == enemy.EngageTick + 306
				and player.DeathTick == enemy.DeathTick
				and #player.AttackIntentTicks == 5
				and #enemy.AttackIntentTicks == 5
				and player.AttackIntentTicks[1] == player.EngageTick + 18
				and player.AttackIntentTicks[2] == player.EngageTick + 90
				and player.AttackIntentTicks[3] == player.EngageTick + 162
				and player.AttackIntentTicks[4] == player.EngageTick + 234
				and player.AttackIntentTicks[5] == player.EngageTick + 306
				and board.Phase == "Resolve"
				and board.CurrentCost == 1
				and board.EnemyCurrentCost == 1

			local signature = self:GetCurrentSignature()
			if scenarioName == "Speed1" then
				self.Speed1Signature = signature
			elseif scenarioName == "Speed2" then
				self.Speed2Signature = signature
				mirrorPassed = mirrorPassed
					and self.Speed1Signature ~= ""
					and self.Speed1Signature == self.Speed2Signature
					and self.BacklogWarningCount > 0
				log(
					"[ThreeLaneCombat][SpeedCompare] Speed1="
					.. self.Speed1Signature
					.. ", Speed2="
					.. self.Speed2Signature
					.. ", Equal="
					.. tostring(self.Speed1Signature == self.Speed2Signature)
				)
			end
			return mirrorPassed
		end

		if scenarioName == "FrontTargetThenRetarget" then
			return self.ScenarioMetrics.FirstTargetId == self.ScenarioMetrics.ExpectedFirstId
				and self.ScenarioMetrics.RetargetId == self.ScenarioMetrics.ExpectedRetargetId
		end

		if scenarioName == "CancelDuringWindup" then
			local attacker = self:GetUnitById(self.ScenarioMetrics.AttackerId)
			return self.ScenarioMetrics.CancelObserved == true
				and attacker ~= nil
				and #attacker.AttackIntentTicks == 0
		end

		if scenarioName == "EmptyLaneFreePass" then
			local runner = self:GetUnitById(self.ScenarioMetrics.RunnerId)
			return runner ~= nil and runner.Exited == true and board.EnemyNexusHp == 25
		end

		if scenarioName == "SimultaneousNexusDraw" then
			return board.BattleState == "Draw"
				and board.PlayerNexusHp == 0
				and board.EnemyNexusHp == 0
		end

		if scenarioName == "Timeout" then
			local survivor = self:GetUnitById(self.ScenarioMetrics.SurvivorId)
			return survivor ~= nil
				and survivor.DeathTick == 3600
				and board.EnemyNexusHp == 25
				and board.Phase == "Resolve"
		end

		if scenarioName == "RangeClassEngage" then
			local melee = self:GetUnitById(self.ScenarioMetrics.MeleeId)
			local meleeTarget = self:GetUnitById(self.ScenarioMetrics.MeleeTargetId)
			local ranged = self:GetUnitById(self.ScenarioMetrics.RangedId)
			local rangedTarget = self:GetUnitById(self.ScenarioMetrics.RangedTargetId)
			if melee == nil or meleeTarget == nil or ranged == nil or rangedTarget == nil then
				return false
			end
			local meleeDistance = math.abs(meleeTarget.SimX - melee.SimX)
			local rangedDistance = math.abs(rangedTarget.SimX - ranged.SimX)
			log(
				"[Phase2C2][RangeClass] MeleeEngage="
				.. tostring(melee.EngageTick)
				.. ", MeleeDistance="
				.. tostring(meleeDistance)
				.. ", RangedEngage="
				.. tostring(ranged.EngageTick)
				.. ", RangedDistance="
				.. tostring(rangedDistance)
			)
			return melee.RangeClass == "Melee"
				and ranged.RangeClass == "Ranged"
				and math.abs(melee.AttackRange - 0.55) <= 0.000001
				and math.abs(ranged.AttackRange - 2.20) <= 0.000001
				and melee.EngageTick >= 0
				and ranged.EngageTick >= 0
				and ranged.EngageTick < melee.EngageTick
				and rangedDistance > meleeDistance
		end

		if scenarioName == "FriendlyNoBlock" then
			local ranged = self:GetUnitById(self.ScenarioMetrics.RangedId)
			local enemy = self:GetUnitById(self.ScenarioMetrics.EnemyId)
			if ranged == nil or enemy == nil then
				return false
			end
			local firstTargetId = ranged.TargetHistory[1]
			log(
				"[Phase2C2][FriendlyNoBlock] Ranged="
				.. tostring(ranged.CombatUnitId)
				.. ", Friendly="
				.. tostring(self.ScenarioMetrics.FriendlyId)
				.. ", Enemy="
				.. tostring(enemy.CombatUnitId)
				.. ", FirstTarget="
				.. tostring(firstTargetId)
				.. ", AttackIntents="
				.. tostring(#ranged.AttackIntentTicks)
			)
			return firstTargetId == enemy.CombatUnitId
				and ranged.EngageTick >= 0
				and #ranged.AttackIntentTicks > 0
		end

		if scenarioName == "YetiNexusDamage" then
			local yeti = self:GetUnitById(self.ScenarioMetrics.YetiId)
			if yeti == nil then
				return false
			end
			log(
				"[Phase2C2][YetiNexusDamage] Cost="
				.. tostring(yeti.Cost)
				.. ", NexusDamage="
				.. tostring(yeti.NexusDamage)
				.. ", EnemyNexusHp="
				.. tostring(board.EnemyNexusHp)
			)
			return yeti.MonsterId == "yeti"
				and yeti.Cost == 5
				and yeti.NexusDamage == 8
				and yeti.Exited == true
				and board.EnemyNexusHp == 22
		end

		return false
	end

	@ExecSpace("ServerOnly")
	method string GetCurrentSignature()
		-- 배속 비교에 필요한 Tick·HP·결과·코스트만 안정적인 문자열로 직렬화한다.
		local player = self:GetUnitById(1)
		local enemy = self:GetUnitById(2)
		local playerPart = "P:none"
		local enemyPart = "E:none"
		if player ~= nil then
			playerPart = "P:E"
				.. tostring(player.EngageTick)
				.. ":D"
				.. tostring(player.DeathTick)
				.. ":A"
				.. self:JoinTicks(player.AttackIntentTicks)
		end
		if enemy ~= nil then
			enemyPart = "E:E"
				.. tostring(enemy.EngageTick)
				.. ":D"
				.. tostring(enemy.DeathTick)
				.. ":A"
				.. self:JoinTicks(enemy.AttackIntentTicks)
		end

		local board = self:GetBoard()
		if not isvalid(board) then
			return playerPart .. "|" .. enemyPart
		end
		return playerPart
			.. "|"
			.. enemyPart
			.. "|State="
			.. board.BattleState
			.. "|Phase="
			.. board.Phase
			.. "|Nexus="
			.. tostring(board.PlayerNexusHp)
			.. "/"
			.. tostring(board.EnemyNexusHp)
			.. "|Cost="
			.. tostring(board.CurrentCost)
			.. "/"
			.. tostring(board.EnemyCurrentCost)
	end

	@ExecSpace("ServerOnly")
	method string JoinTicks(table ticks)
		-- 정수 Tick 배열을 비교 로그용 쉼표 문자열로 변환한다.
		local text = ""
		for index, tick in ipairs(ticks) do
			if index > 1 then
				text = text .. ","
			end
			text = text .. tostring(tick)
		end
		return text
	end

end
