@Component
script ThreeLaneBoard extends Component

	@Sync
	property integer PlayerNexusHp = 30

	@Sync
	property integer EnemyNexusHp = 30

	@Sync
	property string BattleState = "Playing"

	@Sync
	property string Phase = "Mulligan"

	@Sync
	property integer TurnNumber = 1

	@Sync
	property number BattleRemaining = 60

	@Sync
	property integer CurrentCost = 2

	@Sync
	property integer EnemyCurrentCost = 2

	@Sync
	property integer MaxCost = 10

	@Sync
	property integer PendingCount = 0

	@Sync
	property integer EnemyPendingCount = 0

	@Sync
	property string UsedCardMask = "0000000"

	@Sync
	property integer PlayerHandCount = 0

	@Sync
	property integer PlayerDeckCount = 0

	@Sync
	property integer PlayerInstalledCount = 0

	@Sync
	property integer PlayerBurnedCount = 0

	@Sync
	property integer EnemyHandCount = 0

	@Sync
	property integer EnemyDeckCount = 0

	@Sync
	property integer EnemyInstalledCount = 0

	@Sync
	property integer EnemyBurnedCount = 0

	@Sync
	property boolean PlayerMulliganReady = false

	@Sync
	property boolean EnemyMulliganReady = false

	@Sync
	property string PlayerDeadSlotMask = "000000000000000"

	@Sync
	property string EnemyDeadSlotMask = "000000000000000"

	@Sync
	property number SimSpeed = 1

	property string UnitModelId = "threelaneprototypeunit"

	property number BattleTimeLimit = 60

	property number BattleMinTime = 0.6

	property number RevealDuration = 0.4

	property number ResolveDuration = 0.6

	property integer StartCost = 2

	property integer CostGainPerTurn = 2

	property integer SpawnSerial = 0

	property integer PlacementSerial = 0

	property integer EnemyPlacementSerial = 0

	property integer LastRevealEffectTurn = 0

	property number PhaseElapsed = 0

	property table PendingPlacements = {}

	property table EnemyPendingPlacements = {}

	property table ActiveUnits = {}

	property table UsedCards = {}

	property table PlayerCardState = {}

	property table EnemyCardState = {}

	property boolean UseFixedMatchSeed = false

	property integer FixedPlayerSeed = 24080401

	property integer FixedEnemySeed = 24080402

	property boolean AutoConfirmRerollWithoutUI = false

	property string PlayerOwnerUserId = ""

	property integer EnemyFixedCardIndex = 5

	property integer EnemyFixedSlotIndex = 8

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 서버 전투 상태를 초기화하고 Phase 2A 턴 기반 시작을 기록한다.
		log("[ThreeLaneBoard] OnBeginPlay - Phase 2C-4A server card authority ready")
		self:ResetBattle()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 승패가 확정되지 않은 동안 현재 페이즈를 진행한다.
		local combat = self:GetCombat()
		if isvalid(combat) and combat.MakerHarnessRunning then
			return
		end

		if self.BattleState ~= "Playing" then
			return
		end

		if self.Phase == "Placement" then
			return
		end

		if self.Phase == "Reveal" then
			self.PhaseElapsed = self.PhaseElapsed + delta
			if self.PhaseElapsed >= self.RevealDuration then
				self:EnterBattle()
			end
			return
		end

		if self.Phase == "Battle" then
			-- 전투 시간과 모든 판정은 ThreeLaneCombat의 고정 Tick만 갱신한다.
			return
		end

		if self.Phase == "Resolve" then
			self.PhaseElapsed = self.PhaseElapsed + delta
			if self.PhaseElapsed >= self.ResolveDuration then
				self:BeginNextTurn()
			end
		end
	end

	@ExecSpace("ServerOnly")
	method any GetCardState(integer ownerSide)
		-- 양 진영이 같은 카드 상태 구조와 함수를 공유한다.
		if ownerSide == 2 then
			return self.EnemyCardState
		end
		return self.PlayerCardState
	end

	@ExecSpace("ServerOnly")
	method any BuildDefaultDeckState(integer ownerSide, integer seed)
		-- 확정 기본 덱 15장을 독립 CardInstance로 만들고 편성 제약을 서버에서 검증한다.
		local monsterIds = {
			"slime", "slime", "slime",
			"orange_mushroom", "orange_mushroom",
			"ribbon_pig", "ribbon_pig", "ribbon_pig",
			"green_mushroom", "green_mushroom", "green_mushroom",
			"stone_golem", "stone_golem",
			"yeti", "yeti"
		}
		local prefix = "P"
		if ownerSide == 2 then
			prefix = "E"
		end
		local state = {
			OwnerSide = ownerSide,
			Seed = seed,
			RngState = seed,
			InstanceById = {},
			Deck = {},
			Hand = {},
			Burned = {},
			Installed = {},
			RerollUsed = false,
			LastDrawTurn = 0,
			NextPlacementOrder = 0
		}
		local monsterCounts = {}
		local costCounts = {}

		for index, monsterId in ipairs(monsterIds) do
			local monster = self:GetMonsterById(monsterId)
			if monster == nil or monster.CardIndex <= 0 then
				log_error("[Phase2C4A][Deck] runtime monster missing Id=" .. monsterId)
				return nil
			end
			local instanceId = prefix .. "-" .. tostring(index) .. "-" .. monsterId
			local instance = {
				InstanceId = instanceId,
				MonsterId = monsterId,
				CardIndex = monster.CardIndex,
				Cost = monster.Cost,
				State = "Deck",
				PermanentSlotIndex = 0,
				PlacementOrder = 0,
				EffectTargetInstanceId = "",
				EffectDestinationSlotIndex = 0,
				RevealEffectResolved = false
			}
			state.InstanceById[instanceId] = instance
			table.insert(state.Deck, instanceId)
			monsterCounts[monsterId] = (monsterCounts[monsterId] or 0) + 1
			costCounts[monster.Cost] = (costCounts[monster.Cost] or 0) + 1
		end

		if #state.Deck ~= 15 then
			log_error("[Phase2C4A][Deck] deck size must be 15")
			return nil
		end
		for monsterId, count in pairs(monsterCounts) do
			if count > 3 then
				log_error("[Phase2C4A][Deck] monster limit exceeded Id=" .. monsterId)
				return nil
			end
		end
		for cost, count in pairs(costCounts) do
			if count > 5 then
				log_error("[Phase2C4A][Deck] cost limit exceeded Cost=" .. tostring(cost))
				return nil
			end
		end

		self:ShuffleInstanceIds(state, state.Deck)
		return state
	end

	@ExecSpace("ServerOnly")
	method integer NextCardRandom(any state)
		-- Park-Miller LCG로 테스트 Seed 재현성을 유지한다.
		local nextValue = math.floor(math.fmod(state.RngState * 48271, 2147483647))
		if nextValue <= 0 then
			nextValue = 1
		end
		state.RngState = nextValue
		return nextValue
	end

	@ExecSpace("ServerOnly")
	method void ShuffleInstanceIds(any state, table values)
		-- 서버 내부 Fisher-Yates 셔플. 카드 정체나 순서는 동기화하지 않는다.
		for index = #values, 2, -1 do
			local randomValue = self:NextCardRandom(state)
			local swapIndex = math.floor(math.fmod(randomValue, index)) + 1
			local temporary = values[index]
			values[index] = values[swapIndex]
			values[swapIndex] = temporary
		end
	end

	@ExecSpace("ServerOnly")
	method integer FindIdIndex(table values, string instanceId)
		for index, value in ipairs(values) do
			if value == instanceId then
				return index
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method any DrawOneCard(integer ownerSide)
		-- 덱 앞에서 한 장만 처리하고 손패 상한이면 영구 소실한다.
		local state = self:GetCardState(ownerSide)
		if state == nil or state.Deck == nil or #state.Deck == 0 then
			return nil
		end
		local instanceId = table.remove(state.Deck, 1)
		local instance = state.InstanceById[instanceId]
		if instance == nil then
			log_error("[Phase2C4A][Draw] instance missing Id=" .. tostring(instanceId))
			return nil
		end

		if #state.Hand >= 7 then
			instance.State = "Burned"
			table.insert(state.Burned, instanceId)
			log(
				"[Phase2C4A][Draw] Burn Side="
				.. tostring(ownerSide)
				.. ", Deck="
				.. tostring(#state.Deck)
				.. ", Hand=7, Burned="
				.. tostring(#state.Burned)
			)
		else
			instance.State = "Hand"
			table.insert(state.Hand, instanceId)
		end
		return instance
	end

	@ExecSpace("ServerOnly")
	method boolean DrawForTurn(integer ownerSide, integer turnNumber)
		-- 같은 턴의 중복 호출을 무시해 Placement마다 정확히 한 번만 드로우한다.
		local state = self:GetCardState(ownerSide)
		if state == nil or state.LastDrawTurn == turnNumber then
			return false
		end
		state.LastDrawTurn = turnNumber
		local drawn = self:DrawOneCard(ownerSide)
		self:SyncPublicCardCounts()
		if ownerSide == 1 then
			self:RefreshUsedCardMask()
			self:RefreshPlayerSlotOccupancy()
			if drawn == nil then
				self:SendPrivateCardState("DeckEmpty", nil)
			elseif drawn.State == "Burned" then
				self:SendPrivateCardState("Burn", drawn)
			else
				self:SendPrivateCardState("Draw", drawn)
			end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ConfirmInitialReroll(integer ownerSide, boolean replaceAll)
		-- 첫 패 4장을 유지하거나, 전부 임시 제외한 뒤 새 4장을 먼저 뽑고 제외 카드를 덱에 되돌린다.
		local state = self:GetCardState(ownerSide)
		if state == nil or state.RerollUsed or #state.Hand ~= 4 then
			return false
		end
		local excluded = {}
		if replaceAll then
			for _, instanceId in ipairs(state.Hand) do
				table.insert(excluded, instanceId)
			end
			state.Hand = {}

			for _ = 1, 4 do
				if self:DrawOneCard(ownerSide) == nil then
					return false
				end
			end
			for _, instanceId in ipairs(excluded) do
				local instance = state.InstanceById[instanceId]
				instance.State = "Deck"
				table.insert(state.Deck, instanceId)
			end
			self:ShuffleInstanceIds(state, state.Deck)
		end
		state.RerollUsed = true
		self:SyncPublicCardCounts()
		if ownerSide == 1 then
			self:RefreshUsedCardMask()
		end
		log(
			"[Phase2C4A][Reroll] Confirm Side="
			.. tostring(ownerSide)
			.. ", Choice="
			.. (replaceAll and "ReplaceAll" or "Keep")
			.. ", Replaced="
			.. tostring(replaceAll and 4 or 0)
			.. ", Hand="
			.. tostring(#state.Hand)
			.. ", Deck="
			.. tostring(#state.Deck)
		)
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ConfirmInitialMulliganChoice(integer ownerSide, string choice)
		-- RPC와 테스트가 공유하는 화이트리스트. 카드 ID/CSV 등 부분 선택 입력은 허용하지 않는다.
		if choice == "ReplaceAll" then
			return self:ConfirmInitialReroll(ownerSide, true)
		end
		if choice == "Keep" then
			return self:ConfirmInitialReroll(ownerSide, false)
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean InitializeMatchCardStates(integer playerSeed, integer enemySeed)
		-- 양측을 같은 기본 덱 규칙으로 초기화하고 실제 플레이는 Mulligan 4장에서 대기한다.
		self.PlayerCardState = self:BuildDefaultDeckState(1, playerSeed)
		self.EnemyCardState = self:BuildDefaultDeckState(2, enemySeed)
		if self.PlayerCardState == nil or self.EnemyCardState == nil then
			return false
		end
		for _ = 1, 4 do
			self:DrawOneCard(1)
			self:DrawOneCard(2)
		end
		self.Phase = "Mulligan"
		self.PlayerMulliganReady = false
		self.EnemyMulliganReady = false
		local combat = self:GetCombat()
		local autoConfirm = self.AutoConfirmRerollWithoutUI
			or (isvalid(combat) and combat.MakerHarnessRunning)
		if autoConfirm then
			self:ConfirmInitialReroll(1, false)
			self:ConfirmInitialReroll(2, false)
			self.PlayerMulliganReady = true
			self.EnemyMulliganReady = true
		else
			-- M1 AI는 플레이어와 같은 양자 선택 중 Keep을 비공개로 확정한다.
			self:ConfirmInitialReroll(2, false)
			self.EnemyMulliganReady = true
		end
		self:SyncPublicCardCounts()
		if autoConfirm then
			self:TryFinishInitialMulligan()
		end
		log(
			"[Phase2C4A][Deck] Ready PlayerSeed="
			.. tostring(playerSeed)
			.. ", EnemySeed="
			.. tostring(enemySeed)
			.. ", Player=Deck"
			.. tostring(self.PlayerDeckCount)
			.. "/Hand"
			.. tostring(self.PlayerHandCount)
			.. ", Enemy=Deck"
			.. tostring(self.EnemyDeckCount)
			.. "/Hand"
			.. tostring(self.EnemyHandCount)
			.. ", Phase="
			.. self.Phase
		)
		return true
	end

	@ExecSpace("ServerOnly")
	method void SyncPublicCardCounts()
		-- 카드 정체 없이 공개 가능한 네 가지 장수만 양측에 동기화한다.
		local player = self.PlayerCardState
		local enemy = self.EnemyCardState
		if player ~= nil and player.Deck ~= nil then
			-- 예약 인스턴스도 확정 전에는 손패 HUD에 남으므로 공개 패 장수에 포함한다.
			self.PlayerHandCount = #player.Hand + #self.PendingPlacements
			self.PlayerDeckCount = #player.Deck
			self.PlayerInstalledCount = #player.Installed
			self.PlayerBurnedCount = #player.Burned
		else
			self.PlayerHandCount = 0
			self.PlayerDeckCount = 0
			self.PlayerInstalledCount = 0
			self.PlayerBurnedCount = 0
		end
		if enemy ~= nil and enemy.Deck ~= nil then
			self.EnemyHandCount = #enemy.Hand + #self.EnemyPendingPlacements
			self.EnemyDeckCount = #enemy.Deck
			self.EnemyInstalledCount = #enemy.Installed
			self.EnemyBurnedCount = #enemy.Burned
		else
			self.EnemyHandCount = 0
			self.EnemyDeckCount = 0
			self.EnemyInstalledCount = 0
			self.EnemyBurnedCount = 0
		end
	end

	@ExecSpace("ServerOnly")
	method string FindHandInstanceByCardIndex(integer ownerSide, integer cardIndex)
		local state = self:GetCardState(ownerSide)
		if state == nil or state.Hand == nil then
			return ""
		end
		for _, instanceId in ipairs(state.Hand) do
			local instance = state.InstanceById[instanceId]
			if instance ~= nil and instance.CardIndex == cardIndex and instance.State == "Hand" then
				return instanceId
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string BuildCardDisplayRecord(any instance)
		-- 소유자 전용 HUD에 필요한 표시 필드만 직렬화한다. 덱 순서와 상대 손패는 포함하지 않는다.
		if instance == nil then
			return ""
		end
		local monster = self:GetMonsterById(instance.MonsterId)
		local data = self:GetData()
		if monster == nil or not isvalid(data) then
			return ""
		end
		return instance.InstanceId
			.. "|" .. monster.MonsterId
			.. "|" .. tostring(monster.CardIndex)
			.. "|" .. tostring(monster.Cost)
			.. "|" .. monster.DevName
			.. "|" .. monster.RangeClass
			.. "|" .. monster.EffectType
			.. "|" .. instance.State
			.. "|" .. data:GetCardImageRuid(monster.MonsterId)
			.. "|" .. tostring(monster.HP)
			.. "|" .. tostring(monster.Attack)
			.. "|" .. tostring(monster.AttackInterval)
			.. "|" .. tostring(monster.MoveSpeed)
			.. "|" .. tostring(monster.NexusDamage)
			.. "|" .. monster.NameKey
			.. "|" .. monster.EffectTextKey
	end

	@ExecSpace("ServerOnly")
	method string BuildPrivateCardPayload()
		-- 플레이어의 손패·예약·영구 설치만 대상 지정 RPC용 문자열로 만든다.
		local state = self.PlayerCardState
		if state == nil or state.InstanceById == nil then
			return "#"
		end
		local handInstances = {}
		for _, instanceId in ipairs(state.Hand) do
			local instance = state.InstanceById[instanceId]
			if instance ~= nil and instance.State == "Hand" then
				table.insert(handInstances, instance)
			end
		end
		for _, command in ipairs(self.PendingPlacements) do
			local instance = state.InstanceById[command.CardInstanceId]
			if instance ~= nil and instance.State == "Reserved" then
				table.insert(handInstances, instance)
			end
		end
		table.sort(
			handInstances,
			function(a, b)
				if a.Cost ~= b.Cost then
					return a.Cost < b.Cost
				end
				if a.MonsterId ~= b.MonsterId then
					return a.MonsterId < b.MonsterId
				end
				return a.InstanceId < b.InstanceId
			end
		)
		local handRecords = {}
		for _, instance in ipairs(handInstances) do
			local reservedSlotIndex = 0
			if instance.State == "Reserved" then
				for _, command in ipairs(self.PendingPlacements) do
					if command.CardInstanceId == instance.InstanceId then
						reservedSlotIndex = command.SlotIndex
						break
					end
				end
			end
			table.insert(
				handRecords,
				self:BuildCardDisplayRecord(instance) .. "|" .. tostring(reservedSlotIndex)
			)
		end

		local installedInstances = {}
		for _, instanceId in ipairs(state.Installed) do
			local instance = state.InstanceById[instanceId]
			if instance ~= nil and instance.State == "Installed" then
				table.insert(installedInstances, instance)
			end
		end
		table.sort(
			installedInstances,
			function(a, b)
				return a.PlacementOrder < b.PlacementOrder
			end
		)
		local installedRecords = {}
		for _, instance in ipairs(installedInstances) do
			local visualState = "Dead"
			if self.Phase == "Reveal" then
				visualState = "Alive"
			elseif self.Phase == "Battle"
				and string.sub(self.PlayerDeadSlotMask, instance.PermanentSlotIndex, instance.PermanentSlotIndex) ~= "1" then
				visualState = "Alive"
			end
			table.insert(
				installedRecords,
				self:BuildCardDisplayRecord(instance)
					.. "|" .. tostring(instance.PermanentSlotIndex)
					.. "|" .. visualState
					.. "|" .. tostring(instance.PlacementOrder)
			)
		end
		return table.concat(handRecords, ";") .. "#" .. table.concat(installedRecords, ";")
	end

	@ExecSpace("ServerOnly")
	method table ParseInstanceIdList(string value)
		local result = {}
		if value == nil or value == "" then
			return result
		end
		for instanceId in string.gmatch(value, "[^,]+") do
			table.insert(result, instanceId)
		end
		return result
	end

	@ExecSpace("Server")
	method void RequestPrivateCardSnapshot()
		-- 첫 로컬 플레이어를 M1 PvE 카드 상태의 소유자로 고정하고 자기 정보만 돌려준다.
		if self.PlayerOwnerUserId ~= "" and self.PlayerOwnerUserId ~= senderUserId then
			log_warning("[Phase2C4B][Private] snapshot rejected - owner mismatch")
			return
		end
		self.PlayerOwnerUserId = senderUserId
		self:SendPrivateCardState("Snapshot", nil)
	end

	@ExecSpace("Server")
	method void RequestConfirmMulligan(string choice)
		-- Mulligan에서만 Keep/ReplaceAll 중 하나를 한 번 허용하며 부분 선택 입력은 거부한다.
		if self.PlayerOwnerUserId ~= "" and self.PlayerOwnerUserId ~= senderUserId then
			log_warning("[Phase2C4B][Mulligan] rejected - owner mismatch")
			return
		end
		self.PlayerOwnerUserId = senderUserId
		if self.Phase ~= "Mulligan" or self.PlayerMulliganReady then
			log("[Phase2C4B][Mulligan] rejected - Phase=" .. self.Phase .. ", Ready=" .. tostring(self.PlayerMulliganReady))
			self:SendPrivateCardState("MulliganRejected", nil)
			return
		end
		if not self:ConfirmInitialMulliganChoice(1, choice) then
			log("[Phase2C4B][Mulligan] rejected - invalid choice=" .. tostring(choice))
			self:SendPrivateCardState("MulliganRejected", nil)
			return
		end
		self.PlayerMulliganReady = true
		self:SendPrivateCardState("MulliganResult", nil)
		self:TryFinishInitialMulligan()
	end

	@ExecSpace("ServerOnly")
	method void SendPrivateCardState(string eventType, any eventInstance)
		if self.PlayerOwnerUserId == "" then
			return
		end
		local eventRecord = self:BuildCardDisplayRecord(eventInstance)
		self:ClientReceivePrivateCardState(
			self:BuildPrivateCardPayload(),
			eventType,
			eventRecord,
			self.PlayerOwnerUserId
		)
	end

	@ExecSpace("Client")
	method void ClientReceivePrivateCardState(string payload, string eventType, string eventRecord)
		-- 대상 사용자 클라이언트에서만 HUD에 자기 카드 상태를 전달한다.
		local controller = _EntityService:GetEntityByPath("/ui/ThreeLaneHUD/Controller")
		if not isvalid(controller) then
			return
		end
		---@type ThreeLaneHUD
		local hud = controller:GetComponent("script.ThreeLaneHUD")
		if isvalid(hud) then
			hud:ReceivePrivateCardState(payload, eventType, eventRecord)
		end
	end

	@ExecSpace("ServerOnly")
	method void TryFinishInitialMulligan()
		-- 양측이 비공개 리롤을 끝낸 뒤에만 첫 턴 드로우와 Placement를 연다.
		if self.Phase ~= "Mulligan" or not self.PlayerMulliganReady or not self.EnemyMulliganReady then
			return
		end
		self:DrawForTurn(1, 1)
		self:DrawForTurn(2, 1)
		self.Phase = "Placement"
		self.PhaseElapsed = 0
		self:PrepareEnemyPlacementForTurn()
		self:RefreshPlayerSlotOccupancy()
		self:RefreshUsedCardMask()
		self:SyncPublicCardCounts()
		self:SendPrivateCardState("MulliganComplete", nil)
		log(
			"[Phase2C4B][Mulligan] Complete - PlayerHand="
			.. tostring(self.PlayerHandCount)
			.. ", EnemyHand="
			.. tostring(self.EnemyHandCount)
			.. ", Phase=Placement"
		)
	end

	@ExecSpace("Server")
	method void RequestPlaceCard(integer slotIndex, Vector3 spawnPosition, integer cardIndex)
		-- 클라이언트 배치 요청을 서버 검증 경로로 연결한다.
		if self.PlayerOwnerUserId ~= "" and senderUserId ~= self.PlayerOwnerUserId then
			log_warning("[Phase2C4B] Placement rejected - non-owner request")
			return
		end
		self:TryPlaceCardForOwner(slotIndex, spawnPosition, cardIndex, senderUserId)
	end

	@ExecSpace("Server")
	method void RequestPlaceCardInstance(integer slotIndex, string cardInstanceId)
		-- Phase 2C-4B 실제 HUD는 정확한 카드 복사본 ID를 제출한다.
		if self.PlayerOwnerUserId ~= "" and self.PlayerOwnerUserId ~= senderUserId then
			log_warning("[Phase2C4B][Placement] rejected - owner mismatch")
			return
		end
		self.PlayerOwnerUserId = senderUserId
		self:TryReserveCardInstance(1, slotIndex, cardInstanceId, senderUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean TryPlaceCardForOwner(integer slotIndex, Vector3 spawnPosition, integer cardIndex, string ownerUserId)
		-- 2C-4B 전 카드 번호 호환 경로: 서버 손패에서 정확한 복사본을 선택해 코어 함수에 넘긴다.
		local instanceId = self:FindHandInstanceByCardIndex(1, cardIndex)
		if instanceId == "" then
			log("[ThreeLaneBoard] Placement rejected - no matching card in hand " .. tostring(cardIndex))
			return false
		end
		return self:TryReserveCardInstance(1, slotIndex, instanceId, ownerUserId)
	end

	@ExecSpace("ServerOnly")
	method boolean IsPermanentSlotOccupied(integer ownerSide, integer slotIndex)
		local state = self:GetCardState(ownerSide)
		if state == nil or state.Installed == nil then
			return false
		end
		for _, instanceId in ipairs(state.Installed) do
			local instance = state.InstanceById[instanceId]
			if instance ~= nil and instance.PermanentSlotIndex == slotIndex then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean IsReservedSlotOccupied(integer ownerSide, integer slotIndex)
		local placements = self.PendingPlacements
		if ownerSide == 2 then
			placements = self.EnemyPendingPlacements
		end
		for _, command in ipairs(placements) do
			if command.SlotIndex == slotIndex
				or command.EffectDestinationSlotIndex == slotIndex then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean TryReserveCardInstance(
		integer ownerSide,
		integer slotIndex,
		string instanceId,
		string ownerUserId
	)
		-- 서버가 인스턴스 소유권·손패·코스트·영구/예약 점유를 검증하고 예약 상태만 기록한다.
		if self.BattleState ~= "Playing" then
			log("[ThreeLaneBoard] Placement rejected - battle is " .. self.BattleState)
			return false
		end

		if self.Phase ~= "Placement" then
			log("[ThreeLaneBoard] Placement rejected - phase is " .. self.Phase)
			return false
		end

		if slotIndex < 1 or slotIndex > 15 then
			log("[ThreeLaneBoard] Placement rejected - invalid slot " .. tostring(slotIndex))
			return false
		end

		if ownerSide ~= 1 and ownerSide ~= 2 then
			log("[ThreeLaneBoard] Placement rejected - invalid owner side")
			return false
		end
		if self:HasUnresolvedRibbonSelection(ownerSide) then
			log("[Phase2C5][RibbonManual] Placement rejected - target selection incomplete")
			return false
		end

		if self:IsPermanentSlotOccupied(ownerSide, slotIndex)
			or self:IsReservedSlotOccupied(ownerSide, slotIndex) then
			log("[ThreeLaneBoard] Placement rejected - slot occupied " .. tostring(slotIndex))
			return false
		end

		local state = self:GetCardState(ownerSide)
		if state == nil or state.InstanceById == nil then
			return false
		end
		local instance = state.InstanceById[instanceId]
		local handIndex = self:FindIdIndex(state.Hand, instanceId)
		if instance == nil or instance.State ~= "Hand" or handIndex == 0 then
			log("[ThreeLaneBoard] Placement rejected - instance not in hand " .. tostring(instanceId))
			return false
		end
		local monster = self:GetMonsterById(instance.MonsterId)
		if monster == nil or monster.CardIndex ~= instance.CardIndex then
			log_error("[ThreeLaneBoard] Placement rejected - runtime data mismatch")
			return false
		end
		local availableCost = self.CurrentCost
		if ownerSide == 2 then
			availableCost = self.EnemyCurrentCost
		end
		if availableCost < instance.Cost then
			log(
				"[ThreeLaneBoard] Placement rejected - not enough cost. need="
				.. tostring(instance.Cost)
				.. ", have="
				.. tostring(availableCost)
			)
			return false
		end
		local position = self:GetSlotWorldPosition(ownerSide, slotIndex)
		if position == nil then
			log_error("[ThreeLaneBoard] Placement rejected - slot entity missing " .. tostring(slotIndex))
			return false
		end

		table.remove(state.Hand, handIndex)
		instance.State = "Reserved"
		local placements = self.PendingPlacements
		local order = self.PlacementSerial + 1
		if ownerSide == 2 then
			placements = self.EnemyPendingPlacements
			order = self.EnemyPlacementSerial + 1
			self.EnemyPlacementSerial = order
			self.EnemyCurrentCost = availableCost - instance.Cost
		else
			self.PlacementSerial = order
			self.CurrentCost = availableCost - instance.Cost
		end
		local command = {
				Order = order,
				CardIndex = instance.CardIndex,
				MonsterId = instance.MonsterId,
				CardInstanceId = instanceId,
				Cost = instance.Cost,
				SlotIndex = slotIndex,
				Position = position,
				OwnerUserId = ownerUserId,
				OwnerSide = ownerSide,
				OriginalHandIndex = handIndex,
				EffectSelectionState = "NotApplicable",
				EffectTargetInstanceId = "",
				EffectDestinationSlotIndex = 0
			}
		table.insert(placements, command)
		if monster.EffectType == "MoveDownOneLane"
			and monster.EffectTarget == "EarlierAllySameColumn" then
			self:InitializeRibbonEffectSelection(ownerSide, command)
		end
		self.PendingCount = #self.PendingPlacements
		self.EnemyPendingCount = #self.EnemyPendingPlacements
		self:SyncPublicCardCounts()
		if ownerSide == 1 then
			self:RefreshUsedCardMask()
			self:RefreshPlayerSlotOccupancy()
			self:SendPrivateCardState("Reserve", instance)
			self:SendRibbonEffectSelectionState(command)
		end

		log(
			"[ThreeLaneBoard] Placement accepted - Order="
			.. tostring(order)
			.. ", Card="
			.. tostring(instance.CardIndex)
			.. ", Instance="
			.. instanceId
			.. ", Slot="
			.. tostring(slotIndex)
			.. ", Cost=-"
			.. tostring(instance.Cost)
			.. ", Left="
			.. tostring(availableCost - instance.Cost)
		)
		return true
	end

	@ExecSpace("ServerOnly")
	method table GetPlacementsForSide(integer ownerSide)
		if ownerSide == 2 then
			return self.EnemyPendingPlacements
		end
		return self.PendingPlacements
	end

	@ExecSpace("ServerOnly")
	method integer FindPlacementCommandIndex(integer ownerSide, string sourceInstanceId)
		for index, command in ipairs(self:GetPlacementsForSide(ownerSide)) do
			if command.CardInstanceId == sourceInstanceId then
				return index
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method boolean IsRibbonDestinationOccupied(integer ownerSide, integer slotIndex, string ignoredSourceInstanceId)
		if self:IsPermanentSlotOccupied(ownerSide, slotIndex) then
			return true
		end
		for _, command in ipairs(self:GetPlacementsForSide(ownerSide)) do
			if command.SlotIndex == slotIndex then
				return true
			end
			if command.CardInstanceId ~= ignoredSourceInstanceId
				and command.EffectDestinationSlotIndex == slotIndex then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method table BuildRibbonEffectCandidates(integer ownerSide, any sourceCommand)
		local candidates = {}
		if sourceCommand == nil then
			return candidates
		end
		local state = self:GetCardState(ownerSide)
		if state == nil or state.InstanceById == nil then
			return candidates
		end
		local sourceIndex = self:FindPlacementCommandIndex(ownerSide, sourceCommand.CardInstanceId)
		local sourceOrder = state.NextPlacementOrder + sourceIndex
		for _, instanceId in ipairs(state.Installed) do
			local instance = state.InstanceById[instanceId]
			if instance ~= nil
				and instance.PlacementOrder > 0
				and instance.PlacementOrder < sourceOrder then
				local slotIndex = instance.PermanentSlotIndex
				local laneIndex = math.floor((slotIndex - 1) / 5) + 1
				local destinationSlot = slotIndex + 5
				if laneIndex < 3
					and not self:IsRibbonDestinationOccupied(ownerSide, destinationSlot, sourceCommand.CardInstanceId) then
					table.insert(candidates, {
						InstanceId = instance.InstanceId,
						SlotIndex = slotIndex,
						DestinationSlotIndex = destinationSlot,
						PlacementOrder = instance.PlacementOrder
					})
				end
			end
		end
		local placements = self:GetPlacementsForSide(ownerSide)
		for index = 1, sourceIndex - 1 do
			local command = placements[index]
			local instance = state.InstanceById[command.CardInstanceId]
			if instance ~= nil then
				local slotIndex = command.SlotIndex
				local laneIndex = math.floor((slotIndex - 1) / 5) + 1
				local destinationSlot = slotIndex + 5
				if laneIndex < 3
					and not self:IsRibbonDestinationOccupied(ownerSide, destinationSlot, sourceCommand.CardInstanceId) then
					table.insert(candidates, {
						InstanceId = instance.InstanceId,
						SlotIndex = slotIndex,
						DestinationSlotIndex = destinationSlot,
						PlacementOrder = state.NextPlacementOrder + index
					})
				end
			end
		end
		table.sort(candidates, function(a, b)
			if a.PlacementOrder == b.PlacementOrder then
				return a.InstanceId < b.InstanceId
			end
			return a.PlacementOrder > b.PlacementOrder
		end)
		return candidates
	end

	@ExecSpace("ServerOnly")
	method void InitializeRibbonEffectSelection(integer ownerSide, any command)
		local candidates = self:BuildRibbonEffectCandidates(ownerSide, command)
		command.EffectTargetInstanceId = ""
		command.EffectDestinationSlotIndex = 0
		if #candidates == 0 then
			command.EffectSelectionState = "NoTarget"
			log(
				"[Phase2C5][RibbonManual] NoTarget Side="
				.. tostring(ownerSide)
				.. ", Source=" .. command.CardInstanceId
			)
			return
		end
		command.EffectSelectionState = "Selecting"
		if ownerSide == 2 then
			self:ApplyRibbonTargetSelection(command, candidates[1])
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyRibbonTargetSelection(any command, any candidate)
		command.EffectSelectionState = "Selected"
		command.EffectTargetInstanceId = candidate.InstanceId
		command.EffectDestinationSlotIndex = candidate.DestinationSlotIndex
		log(
			"[Phase2C5][RibbonManual] Selected Side="
			.. tostring(command.OwnerSide)
			.. ", Source=" .. command.CardInstanceId
			.. ", Target=" .. candidate.InstanceId
			.. ", Slot=" .. tostring(candidate.SlotIndex)
			.. "->" .. tostring(candidate.DestinationSlotIndex)
		)
	end

	@ExecSpace("ServerOnly")
	method boolean TrySelectRibbonEffectTarget(integer ownerSide, string sourceInstanceId, string targetInstanceId)
		local sourceIndex = self:FindPlacementCommandIndex(ownerSide, sourceInstanceId)
		if sourceIndex == 0 then
			return false
		end
		local command = self:GetPlacementsForSide(ownerSide)[sourceIndex]
		if command.EffectSelectionState ~= "Selecting"
			and command.EffectSelectionState ~= "Selected" then
			return false
		end
		local candidates = self:BuildRibbonEffectCandidates(ownerSide, command)
		for _, candidate in ipairs(candidates) do
			if candidate.InstanceId == targetInstanceId then
				self:ApplyRibbonTargetSelection(command, candidate)
				return true
			end
		end
		log_warning(
			"[Phase2C5][RibbonManual] rejected invalid target Source="
			.. sourceInstanceId
			.. ", Target=" .. targetInstanceId
		)
		return false
	end

	@ExecSpace("Server")
	method void RequestSelectRibbonEffectTarget(string sourceInstanceId, string targetInstanceId)
		if self.PlayerOwnerUserId ~= "" and senderUserId ~= self.PlayerOwnerUserId then
			log_warning("[Phase2C5][RibbonManual] rejected - owner mismatch")
			return
		end
		if self.Phase ~= "Placement" or self.BattleState ~= "Playing" then
			return
		end
		if self:TrySelectRibbonEffectTarget(1, sourceInstanceId, targetInstanceId) then
			local index = self:FindPlacementCommandIndex(1, sourceInstanceId)
			self:SendRibbonEffectSelectionState(self.PendingPlacements[index])
		else
			local index = self:FindPlacementCommandIndex(1, sourceInstanceId)
			if index > 0 then
				self:SendRibbonEffectSelectionState(self.PendingPlacements[index])
			end
		end
	end

	@ExecSpace("ServerOnly")
	method boolean HasUnresolvedRibbonSelection(integer ownerSide)
		for _, command in ipairs(self:GetPlacementsForSide(ownerSide)) do
			if command.EffectSelectionState == "Selecting" then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void ReconcileRibbonEffectSelections(integer ownerSide)
		local placements = self:GetPlacementsForSide(ownerSide)
		for _, command in ipairs(placements) do
			if command.MonsterId == "ribbon_pig" then
				command.PreviousEffectTargetInstanceId = command.EffectTargetInstanceId or ""
				command.EffectTargetInstanceId = ""
				command.EffectDestinationSlotIndex = 0
			end
		end
		for _, command in ipairs(placements) do
			if command.MonsterId == "ribbon_pig" then
				local selectedId = command.PreviousEffectTargetInstanceId or ""
				local candidates = self:BuildRibbonEffectCandidates(ownerSide, command)
				local selected = nil
				for _, candidate in ipairs(candidates) do
					if candidate.InstanceId == selectedId then
						selected = candidate
						break
					end
				end
				if selected ~= nil then
					self:ApplyRibbonTargetSelection(command, selected)
				elseif selectedId ~= "" then
					-- 이미 고른 대상이 Undo 등으로 사라졌다면 자동 무효화로 확정하지 않는다.
					-- 후보가 0기여도 리본돼지 예약을 취소하거나 새 유효 대상을 만들기 전까지 확정을 막는다.
					command.EffectSelectionState = "Selecting"
					command.EffectTargetInstanceId = ""
					command.EffectDestinationSlotIndex = 0
				elseif #candidates > 0 then
					command.EffectSelectionState = "Selecting"
					command.EffectTargetInstanceId = ""
					command.EffectDestinationSlotIndex = 0
				else
					command.EffectSelectionState = "NoTarget"
					command.EffectTargetInstanceId = ""
					command.EffectDestinationSlotIndex = 0
				end
				command.PreviousEffectTargetInstanceId = nil
			end
		end
		if ownerSide == 1 then
			local sent = false
			for _, command in ipairs(self.PendingPlacements) do
				if command.MonsterId == "ribbon_pig" and command.EffectSelectionState == "Selecting" then
					self:SendRibbonEffectSelectionState(command)
					sent = true
					break
				end
			end
			if not sent then
				self:ClientReceiveRibbonEffectSelection("", "Idle", "", self.PlayerOwnerUserId)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SendRibbonEffectSelectionState(any command)
		if self.PlayerOwnerUserId == "" or command == nil or command.MonsterId ~= "ribbon_pig" then
			return
		end
		local candidates = self:BuildRibbonEffectCandidates(1, command)
		local records = {}
		for _, candidate in ipairs(candidates) do
			if command.EffectSelectionState ~= "Selected"
				or candidate.InstanceId == command.EffectTargetInstanceId then
				table.insert(
					records,
					candidate.InstanceId
						.. ":" .. tostring(candidate.SlotIndex)
						.. ":" .. tostring(candidate.DestinationSlotIndex)
				)
			end
		end
		self:ClientReceiveRibbonEffectSelection(
			command.CardInstanceId,
			command.EffectSelectionState,
			table.concat(records, ","),
			self.PlayerOwnerUserId
		)
	end

	@ExecSpace("Client")
	method void ClientReceiveRibbonEffectSelection(string sourceInstanceId, string state, string payload)
		local controller = _EntityService:GetEntityByPath("/ui/ThreeLaneHUD/Controller")
		if not isvalid(controller) then
			return
		end
		---@type ThreeLaneHUD
		local hud = controller:GetComponent("script.ThreeLaneHUD")
		if isvalid(hud) then
			hud:ReceiveRibbonEffectSelection(sourceInstanceId, state, payload)
		end
	end

	@ExecSpace("Server")
	method void RequestUndoPlacement()
		-- 이번 턴에 가장 마지막으로 예약한 배치를 되돌린다(undo). 예약이 없어질 때까지 반복 가능.
		if self.PlayerOwnerUserId ~= "" and senderUserId ~= self.PlayerOwnerUserId then
			log_warning("[Phase2C4B] Undo rejected - non-owner request")
			return
		end
		if not self:CanCancelNow("Undo") then
			return
		end

		local count = #self.PendingPlacements
		if count == 0 then
			log("[ThreeLaneBoard] Undo rejected - no reservation to undo")
			return
		end

		self:CancelPlacementAt(count, senderUserId, "Undo")
	end

	@ExecSpace("Server")
	method void RequestCancelPlacement(integer slotIndex)
		-- 특정 슬롯의 예약 배치를 지정해 취소한다.
		if not self:CanCancelNow("Cancel") then
			return
		end

		local foundIndex = 0
		for index, command in ipairs(self.PendingPlacements) do
			if command.SlotIndex == slotIndex then
				foundIndex = index
				break
			end
		end

		if foundIndex == 0 then
			log("[ThreeLaneBoard] Cancel rejected - no reservation on slot " .. tostring(slotIndex))
			return
		end

		self:CancelPlacementAt(foundIndex, senderUserId, "Cancel")
	end

	@ExecSpace("ServerOnly")
	method boolean CanCancelNow(string source)
		-- 취소·되돌리기가 허용되는 상태인지 확인한다. 확정 이후에는 항상 거부한다.
		if self.BattleState ~= "Playing" then
			log("[ThreeLaneBoard] " .. source .. " rejected - battle is " .. self.BattleState)
			return false
		end

		if self.Phase ~= "Placement" then
			log("[ThreeLaneBoard] " .. source .. " rejected - phase is " .. self.Phase)
			return false
		end

		return true
	end

	@ExecSpace("ServerOnly")
	method void CancelPlacementAt(integer commandIndex, string requesterUserId, string source)
		-- 예약 명령 하나를 제거하고 슬롯·코스트·카드·순번을 배치 이전 상태로 되돌린다.
		local target = self.PendingPlacements[commandIndex]
		if target == nil then
			log("[ThreeLaneBoard] " .. source .. " rejected - reservation not found")
			return
		end

		if target.OwnerUserId ~= requesterUserId then
			log(
				"[ThreeLaneBoard] "
				.. source
				.. " rejected - not the owner of slot "
				.. tostring(target.SlotIndex)
			)
			return
		end

		local slotIndex = target.SlotIndex
		local refund = target.Cost
		if refund == nil then
			refund = self:GetCardCost(target.CardIndex)
		end
		self.CurrentCost = self.CurrentCost + refund
		local state = self.PlayerCardState
		local instance = nil
		if state ~= nil and state.InstanceById ~= nil then
			instance = state.InstanceById[target.CardInstanceId]
		end
		if instance == nil or instance.State ~= "Reserved" then
			log_error("[ThreeLaneBoard] " .. source .. " failed - reserved instance missing")
			self.CurrentCost = self.CurrentCost - refund
			return
		end
		instance.State = "Hand"
		local insertIndex = target.OriginalHandIndex or (#state.Hand + 1)
		if insertIndex < 1 then
			insertIndex = 1
		end
		if insertIndex > #state.Hand + 1 then
			insertIndex = #state.Hand + 1
		end
		table.insert(state.Hand, insertIndex, target.CardInstanceId)

		table.remove(self.PendingPlacements, commandIndex)
		self:ReorderPlacements()
		self:ReconcileRibbonEffectSelections(1)
		self.PendingCount = #self.PendingPlacements
		self:SyncPublicCardCounts()
		self:RefreshUsedCardMask()

		self:ReleaseSlot(slotIndex)
		self:SendPrivateCardState("Undo", instance)

		log(
			"[ThreeLaneBoard] "
			.. source
			.. " accepted - Slot="
			.. tostring(slotIndex)
			.. ", Card="
			.. tostring(target.CardIndex)
			.. ", Instance="
			.. tostring(target.CardInstanceId)
			.. ", Refund=+"
			.. tostring(refund)
			.. ", Cost="
			.. tostring(self.CurrentCost)
			.. ", Pending="
			.. tostring(self.PendingCount)
			.. ", UsedCardMask="
			.. self.UsedCardMask
		)
	end

	@ExecSpace("ServerOnly")
	method void ReorderPlacements()
		-- 남은 예약 명령의 상대 순서를 유지한 채 1부터 연속된 PlacementOrder로 재정렬한다.
		local order = ""
		for index, command in ipairs(self.PendingPlacements) do
			command.Order = index
			order = order
				.. " ["
				.. tostring(index)
				.. "]Card"
				.. tostring(command.CardIndex)
				.. "@Slot"
				.. tostring(command.SlotIndex)
		end

		self.PlacementSerial = #self.PendingPlacements
		log("[ThreeLaneBoard] PlacementOrder reordered ->" .. order)
	end

	@ExecSpace("ServerOnly")
	method void ReleaseSlot(integer slotIndex)
		-- 취소된 예약의 슬롯 점유와 표식 색을 되돌린다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return
		end

		local slotEntity = map:GetChildByName("PlayerSlot_" .. tostring(slotIndex))
		if not isvalid(slotEntity) then
			return
		end

		---@type ThreeLaneSlot
		local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
		if isvalid(slot) then
			slot:ResetSlot()
		end
	end

	@ExecSpace("Server")
	method void RequestConfirmPlacement()
		-- 배치 확정 입력을 받아 공개 단계로 넘어간다. 배치 0건도 허용한다.
		if self.PlayerOwnerUserId ~= "" and senderUserId ~= self.PlayerOwnerUserId then
			log_warning("[Phase2C4B] Confirm rejected - non-owner request")
			return
		end
		if self.BattleState ~= "Playing" then
			return
		end

		if self.Phase ~= "Placement" then
			log("[ThreeLaneBoard] Confirm ignored - phase is " .. self.Phase)
			return
		end
		if self:HasUnresolvedRibbonSelection(1) then
			log("[Phase2C5][RibbonManual] Confirm rejected - target selection incomplete")
			for _, command in ipairs(self.PendingPlacements) do
				if command.EffectSelectionState == "Selecting" then
					self:SendRibbonEffectSelectionState(command)
					break
				end
			end
			return
		end

		self:EnterReveal()
	end

	@ExecSpace("ServerOnly")
	method void EnterReveal()
		-- 예약을 영구 설치로 확정하고 양측 설치 카드 전체를 재출전시킨 뒤 Tick 0 Reveal 효과를 해결한다.
		self.Phase = "Reveal"
		self.PhaseElapsed = 0
		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[ThreeLaneBoard] EnterReveal failed - ThreeLaneCombat missing")
			return
		end
		self:CommitPendingPlacements(1)
		self:CommitPendingPlacements(2)
		self:ResetDeadSlotMasks()
		combat:PrepareReveal()
		log(
			"[ThreeLaneBoard] Phase=Reveal - Turn="
			.. tostring(self.TurnNumber)
			.. ", Pending="
			.. tostring(#self.PendingPlacements)
			.. ", EnemyPending="
			.. tostring(#self.EnemyPendingPlacements)
		)

		self:SpawnInstalledCards(1)
		self:SpawnInstalledCards(2)

		self:ResolveRevealEffects()

		self.PendingPlacements = {}
		self.PendingCount = 0
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		self:SyncPublicCardCounts()
		self:RefreshUsedCardMask()
		self:RefreshPlayerSlotOccupancy()
		self:SendPrivateCardState("Install", nil)
		if self.PlayerOwnerUserId ~= "" then
			self:ClientReceiveRibbonEffectSelection("", "Idle", "", self.PlayerOwnerUserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void CommitPendingPlacements(integer ownerSide)
		-- 예약 상대 순서를 보존해 영구 PlacementOrder와 SlotId를 한 번만 부여한다.
		local state = self:GetCardState(ownerSide)
		local placements = self.PendingPlacements
		if ownerSide == 2 then
			placements = self.EnemyPendingPlacements
		end
		if state == nil or state.InstanceById == nil then
			return
		end
		for _, command in ipairs(placements) do
			local instance = state.InstanceById[command.CardInstanceId]
			if instance ~= nil and instance.State == "Reserved" then
				state.NextPlacementOrder = state.NextPlacementOrder + 1
				instance.State = "Installed"
				instance.PermanentSlotIndex = command.SlotIndex
				instance.PlacementOrder = state.NextPlacementOrder
				instance.EffectTargetInstanceId = command.EffectTargetInstanceId or ""
				instance.EffectDestinationSlotIndex = command.EffectDestinationSlotIndex or 0
				instance.RevealEffectResolved = false
				command.Order = instance.PlacementOrder
				table.insert(state.Installed, instance.InstanceId)
				log(
					"[Phase2C4A][Install] Side="
					.. tostring(ownerSide)
					.. ", Instance="
					.. instance.InstanceId
					.. ", Slot="
					.. tostring(instance.PermanentSlotIndex)
					.. ", Order="
					.. tostring(instance.PlacementOrder)
				)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnInstalledCards(integer ownerSide)
		-- 모든 영구 설치 카드를 PlacementOrder 오름차순으로 새 전투 개체로 소환한다.
		local state = self:GetCardState(ownerSide)
		if state == nil or state.Installed == nil then
			return
		end
		local ordered = {}
		for _, instanceId in ipairs(state.Installed) do
			local instance = state.InstanceById[instanceId]
			if instance ~= nil and instance.State == "Installed" then
				table.insert(ordered, instance)
			end
		end
		table.sort(
			ordered,
			function(a, b)
				return a.PlacementOrder < b.PlacementOrder
			end
		)
		for _, instance in ipairs(ordered) do
			local position = self:GetSlotWorldPosition(ownerSide, instance.PermanentSlotIndex)
			if position ~= nil then
				self:SpawnPlacement(
					{
						Order = instance.PlacementOrder,
						CardIndex = instance.CardIndex,
						MonsterId = instance.MonsterId,
						CardInstanceId = instance.InstanceId,
						Cost = instance.Cost,
						SlotIndex = instance.PermanentSlotIndex,
						Position = position,
					OwnerUserId = ownerSide == 2 and "EnemyAI" or "Player",
					OwnerSide = ownerSide,
					EffectTargetInstanceId = instance.EffectTargetInstanceId or "",
					EffectDestinationSlotIndex = instance.EffectDestinationSlotIndex or 0,
					RevealEffectResolved = instance.RevealEffectResolved == true
					}
				)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnPlacement(table command)
		-- 양 진영 공통 명령의 MonsterData를 실제 유닛 상태에 주입하고 Combat에 등록한다.
		local monster = nil
		if command.MonsterId ~= nil and command.MonsterId ~= "" then
			monster = self:GetMonsterById(command.MonsterId)
		end
		if monster == nil then
			monster = self:GetMonsterByCardIndex(command.CardIndex)
		end
		if monster == nil then
			log_error(
				"[ThreeLaneBoard] Spawn rejected - MonsterData missing Card="
				.. tostring(command.CardIndex)
			)
			return
		end

		self.SpawnSerial = self.SpawnSerial + 1
		local ownerSide = command.OwnerSide
		if ownerSide ~= 2 then
			ownerSide = 1
		end
		local sideName = "Player"
		if ownerSide == 2 then
			sideName = "Enemy"
		end
		local unitName =
			sideName
			.. "Unit_T"
			.. tostring(self.TurnNumber)
			.. "_C"
			.. tostring(command.CardIndex)
			.. "_"
			.. tostring(self.SpawnSerial)

		local map = self.Entity.CurrentMap
		local unit = _SpawnService:SpawnByModelId(
			self.UnitModelId,
			unitName,
			command.Position,
			map
		)

		if not isvalid(unit) then
			log_error("[ThreeLaneBoard] SpawnByModelId failed for slot " .. tostring(command.SlotIndex))
			return
		end

		---@type ThreeLaneUnit
		local unitComponent = unit:GetComponent("script.ThreeLaneUnit")
		if not isvalid(unitComponent) then
			log_error("[ThreeLaneBoard] Spawned unit has no ThreeLaneUnit")
			_EntityService:Destroy(unit)
			return
		end

		local laneIndex = math.floor((command.SlotIndex - 1) / 5) + 1
		unitComponent.OwnerSide = ownerSide
		unitComponent.LaneIndex = laneIndex
		unitComponent.BaseLaneIndex = laneIndex
		unitComponent.SlotIndex = command.SlotIndex
		unitComponent.BaseSlotIndex = command.SlotIndex
		unitComponent.PlacementOrder = command.Order
		unitComponent.CardIndex = monster.CardIndex
		unitComponent.CardInstanceId = command.CardInstanceId or ""
		unitComponent.MonsterId = monster.MonsterId
		unitComponent.RangeClass = monster.RangeClass
		unitComponent.Cost = monster.Cost
		unitComponent.HP = monster.HP
		unitComponent.MaxHP = monster.HP
		unitComponent.Attack = monster.Attack
		unitComponent.BaseAttack = monster.Attack
		unitComponent.CombatAttackBonus = 0
		unitComponent.AttackIntervalTicks = monster.AttackIntervalTicks
		unitComponent.FirstAttackDelayTicks = monster.FirstAttackDelayTicks
		unitComponent.MoveSpeed = monster.MoveSpeed
		unitComponent.AttackRange = monster.AttackRange
		unitComponent.NexusDamage = monster.NexusDamage
		unitComponent.SecondaryTargetLane = monster.SecondaryTargetLane
		unitComponent.SecondaryDamageRate = monster.SecondaryDamageRate
		unitComponent.RevealEffectTargetInstanceId = command.EffectTargetInstanceId or ""
		unitComponent.RevealEffectDestinationSlotIndex = command.EffectDestinationSlotIndex or 0
		unitComponent.RevealEffectResolved = command.RevealEffectResolved == true
		unitComponent.SimX = command.Position.x
		unitComponent.CombatStartX = command.Position.x
		unitComponent.CombatStartY = command.Position.y
		unitComponent.TargetNexusX = 5.35
		if ownerSide == 2 then
			unitComponent.TargetNexusX = -5.35
		end
		local data = self:GetData()
		local visualProfile = nil
		if isvalid(data) then
			visualProfile = data:GetCombatVisualProfile(monster.MonsterId)
		end

		if isvalid(unit.SpriteRendererComponent) then
			if visualProfile ~= nil then
				unit.SpriteRendererComponent.Color = Color(1.0, 1.0, 1.0, 1.0)
			elseif ownerSide == 2 then
				unit.SpriteRendererComponent.Color = Color(1.0, 0.45, 0.45, 1.0)
			else
				unit.SpriteRendererComponent.Color = Color(0.45, 0.75, 1.0, 1.0)
			end
		end

		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[ThreeLaneBoard] ThreeLaneCombat missing on PrototypeBoard")
			_EntityService:Destroy(unit)
			return
		end
		combat:RegisterUnit(unitComponent)
		unitComponent:InitializePresentation(visualProfile, self.SimSpeed)
		table.insert(self.ActiveUnits, unit)

		log(
			"[ThreeLaneBoard] Spawn Side="
			.. sideName
			.. ", CombatUnitId="
			.. tostring(unitComponent.CombatUnitId)
			.. ", Order="
			.. tostring(command.Order)
			.. ", Card="
			.. tostring(unitComponent.CardIndex)
			.. ", Instance="
			.. unitComponent.CardInstanceId
			.. ", MonsterId="
			.. unitComponent.MonsterId
			.. ", Slot="
			.. tostring(command.SlotIndex)
			.. ", Cost="
			.. tostring(unitComponent.Cost)
			.. ", HP="
			.. tostring(unitComponent.HP)
			.. ", Attack="
			.. tostring(unitComponent.Attack)
			.. ", AttackIntervalTicks="
			.. tostring(unitComponent.AttackIntervalTicks)
			.. ", FirstAttackDelayTicks="
			.. tostring(unitComponent.FirstAttackDelayTicks)
			.. ", MoveSpeed="
			.. tostring(unitComponent.MoveSpeed)
			.. ", RangeClass="
			.. unitComponent.RangeClass
			.. ", AttackRange="
			.. tostring(unitComponent.AttackRange)
			.. ", NexusDamage="
			.. tostring(unitComponent.NexusDamage)
			.. ", Secondary="
			.. unitComponent.SecondaryTargetLane
			.. "/"
			.. tostring(unitComponent.SecondaryDamageRate)
		)
	end

	@ExecSpace("ServerOnly")
	method boolean ResolveRevealEffects()
		-- 모든 소환이 끝난 뒤 양 진영을 독립적으로 처리하고 Battle Tick은 건드리지 않는다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[Phase2C3A][Reveal] FAIL - ThreeLaneCombat missing")
			return false
		end
		if self.LastRevealEffectTurn == self.TurnNumber then
			log_warning("[Phase2C3A][Reveal] duplicate resolve ignored - Turn=" .. tostring(self.TurnNumber))
			return false
		end

		local tickBefore = combat.SimTick
		local playerSources = self:ResolveRevealEffectsForSide(1)
		local enemySources = self:ResolveRevealEffectsForSide(2)
		self.LastRevealEffectTurn = self.TurnNumber
		local tickStable = tickBefore == 0 and combat.SimTick == 0 and not combat.IsRunning
		if not tickStable then
			log_error(
				"[Phase2C3A][Reveal] FAIL - combat advanced before Battle. Before="
				.. tostring(tickBefore)
				.. ", After="
				.. tostring(combat.SimTick)
			)
			return false
		end

		log(
			"[Phase2C3A][Reveal] PASS - Turn="
			.. tostring(self.TurnNumber)
			.. ", PlayerSources="
			.. tostring(playerSources)
			.. ", EnemySources="
			.. tostring(enemySources)
			.. ", Tick=0"
		)
		return true
	end

	@ExecSpace("ServerOnly")
	method integer ResolveRevealEffectsForSide(integer ownerSide)
		-- 효과 소스를 PlacementOrder 오름차순, 동률은 CombatUnitId 오름차순으로 고정한다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return 0
		end
		local sources = {}
		local snapshot = combat:BuildStableSnapshot()
		for _, unit in ipairs(snapshot) do
			if unit.OwnerSide == ownerSide and unit.PlacementOrder > 0 then
				local monster = self:GetMonsterById(unit.MonsterId)
				if monster ~= nil
					and monster.EffectType ~= ""
					and monster.EffectType ~= "None"
					and not (monster.EffectType == "MoveDownOneLane" and unit.RevealEffectResolved == true)
					and (monster.EffectDuration == "CurrentCombat"
						or monster.EffectDuration == "PermanentPlacement") then
					table.insert(sources, { Unit = unit, Monster = monster })
				end
			end
		end

		table.sort(
			sources,
			function(a, b)
				if a.Unit.PlacementOrder == b.Unit.PlacementOrder then
					return a.Unit.CombatUnitId < b.Unit.CombatUnitId
				end
				return a.Unit.PlacementOrder < b.Unit.PlacementOrder
			end
		)

		for _, source in ipairs(sources) do
			self:ResolveRevealEffectSource(source.Unit, source.Monster)
		end
		return #sources
	end

	@ExecSpace("ServerOnly")
	method void ResolveRevealEffectSource(any source, any monster)
		-- 데이터 계약에 맞는 공개 시점 효과만 처리하고 미지원 효과는 이후 단계로 남긴다.
		if source == nil or monster == nil then
			return
		end

		if monster.EffectType == "MoveDownOneLane"
			and monster.EffectTarget == "EarlierAllySameColumn" then
			local target = self:FindRevealUnitByInstanceId(source.RevealEffectTargetInstanceId)
			local valid = self:IsManualRibbonRevealTargetValid(source, target)
			if valid then
				self:MoveRevealUnitDownOneLane(source, target)
			elseif source.IsTestUnit == true
				and (source.RevealEffectTargetInstanceId == nil or source.RevealEffectTargetInstanceId == "") then
				-- Phase 2C-3A 과거 회귀 테이블은 런타임 카드 인스턴스가 없으므로 테스트에서만 옛 후보를 명시적으로 재사용한다.
				local candidates = self:GetRevealEffectCandidates(source, monster.EffectTarget)
				if #candidates > 0 then
					self:MoveRevealUnitDownOneLane(source, candidates[1])
				end
			else
				log(
					"[Phase2C5][RibbonManual] RevealNoTarget Source="
					.. tostring(source.CombatUnitId)
					.. ", TargetInstance=" .. tostring(source.RevealEffectTargetInstanceId)
				)
			end
			self:MarkRibbonRevealResolved(source)
			return
		end

		if monster.EffectType == "AttackBuff"
			and monster.EffectTarget == "EarlierAlliesMiddle" then
			local candidates = self:GetRevealEffectCandidates(source, monster.EffectTarget)
			local applied = 0
			for _, target in ipairs(candidates) do
				if applied >= monster.EffectMaxTargets then
					break
				end
				self:ApplyRevealAttackBonus(source, target, monster.EffectValue)
				applied = applied + 1
			end
			if applied == 0 then
				log(
					"[Phase2C3A][AttackBuff] NoTarget Source="
					.. tostring(source.CombatUnitId)
					.. ", Order="
					.. tostring(source.PlacementOrder)
				)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method any FindRevealUnitByInstanceId(string instanceId)
		if instanceId == nil or instanceId == "" then
			return nil
		end
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return nil
		end
		for _, unit in ipairs(combat:BuildStableSnapshot()) do
			if unit.CardInstanceId == instanceId then
				return unit
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean IsManualRibbonRevealTargetValid(any source, any target)
		if source == nil or target == nil then
			return false
		end
		local destinationSlot = target.SlotIndex + 5
		return target.OwnerSide == source.OwnerSide
			and target.PlacementOrder > 0
			and target.PlacementOrder < source.PlacementOrder
			and target.LaneIndex < 3
			and source.RevealEffectDestinationSlotIndex == destinationSlot
			and not self:IsRevealSlotOccupied(target.OwnerSide, destinationSlot, target.CombatUnitId)
	end

	@ExecSpace("ServerOnly")
	method void MarkRibbonRevealResolved(any source)
		if source == nil then
			return
		end
		source.RevealEffectResolved = true
		if source.CardInstanceId == nil or source.CardInstanceId == "" then
			return
		end
		local state = self:GetCardState(source.OwnerSide)
		if state == nil or state.InstanceById == nil then
			return
		end
		local instance = state.InstanceById[source.CardInstanceId]
		if instance ~= nil then
			instance.RevealEffectResolved = true
		end
	end

	@ExecSpace("ServerOnly")
	method table GetRevealEffectCandidates(any source, string targetRule)
		-- 앞순번 아군만 모은 뒤 현재 위치 기준 유효성을 검사하고 최근 배치 순으로 정렬한다.
		local candidates = {}
		local combat = self:GetCombat()
		if source == nil or not isvalid(combat) then
			return candidates
		end

		local sourceColumn = self:GetSlotColumn(source.SlotIndex)
		local snapshot = combat:BuildStableSnapshot()
		for _, candidate in ipairs(snapshot) do
			local earlierAlly = candidate.CombatUnitId ~= source.CombatUnitId
				and candidate.OwnerSide == source.OwnerSide
				and candidate.PlacementOrder > 0
				and candidate.PlacementOrder < source.PlacementOrder
			if earlierAlly then
				local valid = false
				if targetRule == "EarlierAllySameColumn" then
					local destinationSlot = candidate.SlotIndex + 5
					valid = candidate.LaneIndex < 3
						and self:GetSlotColumn(candidate.SlotIndex) == sourceColumn
						and not self:IsRevealSlotOccupied(candidate.OwnerSide, destinationSlot, candidate.CombatUnitId)
				elseif targetRule == "EarlierAlliesMiddle" then
					valid = candidate.LaneIndex == 2
				end
				if valid then
					table.insert(candidates, candidate)
				end
			end
		end

		table.sort(
			candidates,
			function(a, b)
				if a.PlacementOrder == b.PlacementOrder then
					return a.CombatUnitId < b.CombatUnitId
				end
				return a.PlacementOrder > b.PlacementOrder
			end
		)
		return candidates
	end

	@ExecSpace("ServerOnly")
	method boolean IsRevealSlotOccupied(integer ownerSide, integer slotIndex, integer ignoredCombatUnitId)
		-- 현재 전투 위치에서 같은 진영의 목적지 점유를 검사하며 위치 교환은 허용하지 않는다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return true
		end
		for _, unit in ipairs(combat:BuildStableSnapshot()) do
			if unit.CombatUnitId ~= ignoredCombatUnitId
				and unit.OwnerSide == ownerSide
				and unit.SlotIndex == slotIndex then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void MoveRevealUnitDownOneLane(any source, any target)
		-- Slot·라인·논리 X·월드 위치·전투 시작 위치를 같은 목적지 값으로 원자적으로 갱신한다.
		if source == nil or target == nil or target.LaneIndex >= 3 then
			return
		end
		local destinationSlot = target.SlotIndex + 5
		local slotPosition = self:GetSlotWorldPosition(target.OwnerSide, destinationSlot)
		if slotPosition == nil then
			log_error("[Phase2C3A][MoveDownOneLane] destination slot missing " .. tostring(destinationSlot))
			return
		end

		local oldSlot = target.SlotIndex
		target.SlotIndex = destinationSlot
		target.LaneIndex = math.floor((destinationSlot - 1) / 5) + 1
		target.SimX = slotPosition.x
		target.CombatStartX = slotPosition.x
		target.CombatStartY = slotPosition.y
		if target.IsTestUnit ~= true and isvalid(target) and isvalid(target.Entity) then
			target:SetVisualVelocity(0)
			if isvalid(target.Entity.KinematicbodyComponent) then
				target.Entity.KinematicbodyComponent:SetWorldPosition(Vector2(slotPosition.x, slotPosition.y))
			else
				target.Entity.TransformComponent.WorldPosition = slotPosition
			end
		end
		self:UpdatePermanentSlotFromUnit(target)

		log(
			"[Phase2C3A][MoveDownOneLane] Source="
			.. tostring(source.CombatUnitId)
			.. ", Target="
			.. tostring(target.CombatUnitId)
			.. ", Order="
			.. tostring(target.PlacementOrder)
			.. ", Slot="
			.. tostring(oldSlot)
			.. "->"
			.. tostring(destinationSlot)
			.. ", Lane="
			.. tostring(target.LaneIndex)
		)
	end

	@ExecSpace("ServerOnly")
	method void UpdatePermanentSlotFromUnit(any unit)
		-- 실제 카드 인스턴스가 있는 Reveal 이동만 경기 종료까지 영구 SlotId에 반영한다.
		if unit == nil or unit.CardInstanceId == nil or unit.CardInstanceId == "" then
			return
		end
		local state = self:GetCardState(unit.OwnerSide)
		if state == nil or state.InstanceById == nil then
			return
		end
		local instance = state.InstanceById[unit.CardInstanceId]
		if instance == nil or instance.State ~= "Installed" then
			return
		end
		local previous = instance.PermanentSlotIndex
		instance.PermanentSlotIndex = unit.SlotIndex
		log(
			"[Phase2C4A][PermanentMove] Instance="
			.. instance.InstanceId
			.. ", Slot="
			.. tostring(previous)
			.. "->"
			.. tostring(instance.PermanentSlotIndex)
		)
	end

	@ExecSpace("ServerOnly")
	method void ApplyRevealAttackBonus(any source, any target, integer amount)
		-- 원본 공격력과 전투 보너스를 분리하고 HP·주기·수호석 피해·MonsterData는 건드리지 않는다.
		if source == nil or target == nil then
			return
		end
		local before = target.Attack
		target.CombatAttackBonus = target.CombatAttackBonus + amount
		target.Attack = target.BaseAttack + target.CombatAttackBonus
		log(
			"[Phase2C3A][AttackBuff] Source="
			.. tostring(source.CombatUnitId)
			.. ", Target="
			.. tostring(target.CombatUnitId)
			.. ", Order="
			.. tostring(target.PlacementOrder)
			.. ", Attack="
			.. tostring(before)
			.. "->"
			.. tostring(target.Attack)
		)
	end

	@ExecSpace("ServerOnly")
	method integer GetSlotColumn(integer slotIndex)
		-- 1~15 SlotId를 진영 관점의 1~5 열 번호로 변환한다.
		return ((slotIndex - 1) % 5) + 1
	end

	@ExecSpace("ServerOnly")
	method any GetSlotWorldPosition(integer ownerSide, integer slotIndex)
		-- 플레이어·적의 현재 SlotId에 대응하는 실제 월드 좌표를 반환한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return nil
		end
		local prefix = "PlayerSlot_"
		if ownerSide == 2 then
			prefix = "EnemySlot_"
		end
		local slot = map:GetChildByName(prefix .. tostring(slotIndex))
		if not isvalid(slot) then
			return nil
		end
		return slot.TransformComponent.WorldPosition
	end

	@ExecSpace("ServerOnly")
	method void EnterBattle()
		-- 페이즈 권위를 Battle로 바꾸고 단일 Combat 고정 Tick 시뮬레이션을 시작한다.
		self.Phase = "Battle"
		self.PhaseElapsed = 0
		self.BattleRemaining = self.BattleTimeLimit
		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[ThreeLaneBoard] EnterBattle failed - ThreeLaneCombat missing")
			return
		end
		combat:StartBattle(self.SimSpeed)
		log(
			"[ThreeLaneBoard] Phase=Battle - Turn="
			.. tostring(self.TurnNumber)
			.. ", Units="
			.. tostring(self:CountActiveUnits())
			.. ", Limit="
			.. tostring(self.BattleTimeLimit)
			.. "s/3600ticks, SimSpeed="
			.. tostring(self.SimSpeed)
		)
	end

	@ExecSpace("ServerOnly")
	method void EnterResolve(string reason)
		-- 전투 페이즈를 끝내고 다음 턴 정산 단계로 넘어간다.
		self.Phase = "Resolve"
		self.PhaseElapsed = 0
		log(
			"[ThreeLaneBoard] Phase=Resolve - Turn="
			.. tostring(self.TurnNumber)
			.. ", Reason="
			.. reason
			.. ", PlayerCost="
			.. tostring(self.CurrentCost)
			.. ", EnemyCost="
			.. tostring(self.EnemyCurrentCost)
		)
	end

	@ExecSpace("ServerOnly")
	method void BeginNextTurn()
		-- 전투 개체를 비우고 영구 설치는 유지한 채 코스트·한 장 드로우 후 다음 Placement를 연다.
		self:ClearSlots()

		-- 예약 상대 순번만 턴마다 초기화하며 영구 PlacementOrder는 카드 상태에 보존한다.
		self.PlacementSerial = 0
		self.EnemyPlacementSerial = 0
		self.LastRevealEffectTurn = 0
		self.TurnNumber = self.TurnNumber + 1
		local gained = self.CurrentCost + self.CostGainPerTurn
		if gained > self.MaxCost then
			gained = self.MaxCost
		end
		self.CurrentCost = gained
		local enemyGained = self.EnemyCurrentCost + self.CostGainPerTurn
		if enemyGained > self.MaxCost then
			enemyGained = self.MaxCost
		end
		self.EnemyCurrentCost = enemyGained

		self.Phase = "Placement"
		self.PhaseElapsed = 0
		self.BattleRemaining = self.BattleTimeLimit
		self:DrawForTurn(1, self.TurnNumber)
		self:DrawForTurn(2, self.TurnNumber)
		self:PrepareEnemyPlacementForTurn()
		self:RefreshPlayerSlotOccupancy()
		self:RefreshUsedCardMask()

		log(
			"[ThreeLaneBoard] Phase=Placement - Turn="
			.. tostring(self.TurnNumber)
			.. ", Cost="
			.. tostring(self.CurrentCost)
			.. "/"
			.. tostring(self.MaxCost)
			.. ", UsedCardMask="
			.. self.UsedCardMask
			.. ", EnemyCost="
			.. tostring(self.EnemyCurrentCost)
			.. ", EnemyPending="
			.. tostring(self.EnemyPendingCount)
			.. ", PlayerCards=Hand"
			.. tostring(self.PlayerHandCount)
			.. "/Deck"
			.. tostring(self.PlayerDeckCount)
			.. "/Installed"
			.. tostring(self.PlayerInstalledCount)
		)
	end

	@ExecSpace("ServerOnly")
	method integer CountActiveUnits()
		-- 활성 개체 수는 전투 단일 권위인 Combat 레지스트리에서만 읽는다.
		local combat = self:GetCombat()
		if isvalid(combat) then
			return combat:CountActiveUnits()
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void KillActiveUnits()
		-- 재시작·정리 시 Combat 레지스트리와 실제 엔티티를 함께 비운다.
		local combat = self:GetCombat()
		if isvalid(combat) then
			combat:ResetSimulation(true)
		else
			for _, unit in ipairs(self.ActiveUnits) do
				if isvalid(unit) then
					_EntityService:Destroy(unit)
				end
			end
		end
		self.ActiveUnits = {}
	end

	@ExecSpace("ServerOnly")
	method void StopActiveUnits()
		-- 승패가 결정되면 Combat이 관리하는 모든 시각 이동을 멈춘다.
		local combat = self:GetCombat()
		if isvalid(combat) then
			combat:StopAllVisuals()
		end
	end

	@ExecSpace("ServerOnly")
	method void ResolveEnemyNexusHit(integer damage, Entity sourceUnit)
		-- 구 Phase 1 호출도 단일 수호석 피해 묶음 경로로 호환 처리한다.
		self:ApplyNexusDamageBatch(0, damage, 0)
		if isvalid(sourceUnit) then
			_EntityService:Destroy(sourceUnit)
		end
	end

	@ExecSpace("ServerOnly")
	method void ResolvePlayerNexusHit(integer damage)
		-- 구 호출도 양측 일괄 수호석 피해 메서드로 연결한다.
		self:ApplyNexusDamageBatch(damage, 0, 0)
	end

	@ExecSpace("ServerOnly")
	method void ApplyNexusDamageBatch(integer playerDamage, integer enemyDamage, integer simTick)
		-- 같은 Tick의 양측 수호석 피해를 모두 적용한 뒤 한 번만 결과를 확정한다.
		if self.BattleState ~= "Playing" then
			return
		end

		local playerBefore = self.PlayerNexusHp
		local enemyBefore = self.EnemyNexusHp
		self.PlayerNexusHp = self.PlayerNexusHp - playerDamage
		self.EnemyNexusHp = self.EnemyNexusHp - enemyDamage
		if self.PlayerNexusHp < 0 then
			self.PlayerNexusHp = 0
		end
		if self.EnemyNexusHp < 0 then
			self.EnemyNexusHp = 0
		end

		if playerDamage > 0 or enemyDamage > 0 then
			log(
				"[ThreeLaneBoard][NexusBatch] Tick="
				.. tostring(simTick)
				.. ", PlayerHP="
				.. tostring(playerBefore)
				.. "->"
				.. tostring(self.PlayerNexusHp)
				.. ", EnemyHP="
				.. tostring(enemyBefore)
				.. "->"
				.. tostring(self.EnemyNexusHp)
			)
		end

		if self.PlayerNexusHp <= 0 and self.EnemyNexusHp <= 0 then
			self.BattleState = "Draw"
		elseif self.EnemyNexusHp <= 0 then
			self.BattleState = "Victory"
		elseif self.PlayerNexusHp <= 0 then
			self.BattleState = "Defeat"
		end

		if self.BattleState ~= "Playing" then
			self:StopActiveUnits()
			log(
				"[ThreeLaneBoard] RESULT="
				.. self.BattleState
				.. ", Tick="
				.. tostring(simTick)
				.. ", PlayerCost="
				.. tostring(self.CurrentCost)
				.. ", EnemyCost="
				.. tostring(self.EnemyCurrentCost)
			)
		end
	end

	@ExecSpace("Server")
	method void RequestRestart()
		-- HUD 재시작 입력을 서버 초기화로 연결한다.
		self:ResetBattle()
	end

	@ExecSpace("ServerOnly")
	method string SetSlotMaskValue(string mask, integer slotIndex, string value)
		if slotIndex < 1 or slotIndex > 15 then
			return mask
		end
		local prefix = ""
		local suffix = ""
		if slotIndex > 1 then
			prefix = string.sub(mask, 1, slotIndex - 1)
		end
		if slotIndex < 15 then
			suffix = string.sub(mask, slotIndex + 1, 15)
		end
		return prefix .. value .. suffix
	end

	@ExecSpace("ServerOnly")
	method void ResetDeadSlotMasks()
		self.PlayerDeadSlotMask = "000000000000000"
		self.EnemyDeadSlotMask = "000000000000000"
	end

	@ExecSpace("ServerOnly")
	method void MarkPermanentUnitResolved(integer ownerSide, string cardInstanceId)
		-- 전투 개체가 사망·퇴장하면 영구 카드는 유지하고 슬롯만 다음 턴 재출전 상태로 표시한다.
		if cardInstanceId == nil or cardInstanceId == "" then
			return
		end
		local state = self:GetCardState(ownerSide)
		if state == nil or state.InstanceById == nil then
			return
		end
		local instance = state.InstanceById[cardInstanceId]
		if instance == nil or instance.State ~= "Installed" then
			return
		end
		if ownerSide == 2 then
			self.EnemyDeadSlotMask = self:SetSlotMaskValue(
				self.EnemyDeadSlotMask,
				instance.PermanentSlotIndex,
				"1"
			)
		else
			self.PlayerDeadSlotMask = self:SetSlotMaskValue(
				self.PlayerDeadSlotMask,
				instance.PermanentSlotIndex,
				"1"
			)
			self:SendPrivateCardState("PermanentResolved", instance)
		end
		log(
			"[Phase2C4B][PermanentSlot] Resolved Side="
			.. tostring(ownerSide)
			.. ", Instance="
			.. cardInstanceId
			.. ", Slot="
			.. tostring(instance.PermanentSlotIndex)
		)
	end

	@ExecSpace("ServerOnly")
	method void ResetBattle()
		-- 전투·턴·코스트와 양측 15장 서버 카드 상태를 초기값으로 되돌린다.
		self:KillActiveUnits()

		self.PendingPlacements = {}
		self.PendingCount = 0
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		self.UsedCardMask = "0000000"
		self.PlacementSerial = 0
		self.EnemyPlacementSerial = 0
		self.LastRevealEffectTurn = 0
		self.PlayerNexusHp = 30
		self.EnemyNexusHp = 30
		self.BattleState = "Playing"
		self.Phase = "Mulligan"
		self.PhaseElapsed = 0
		self.TurnNumber = 1
		self.BattleRemaining = self.BattleTimeLimit
		self.CurrentCost = self.StartCost
		self.EnemyCurrentCost = self.StartCost
		self.MaxCost = 10
		self.SimSpeed = 1
		self.PlayerMulliganReady = false
		self.EnemyMulliganReady = false
		self:ResetDeadSlotMasks()
		local playerSeed = self.FixedPlayerSeed
		local enemySeed = self.FixedEnemySeed
		if not self.UseFixedMatchSeed then
			playerSeed = _UtilLogic:RandomIntegerRange(1, 2147483000)
			enemySeed = _UtilLogic:RandomIntegerRange(1, 2147483000)
		end
		if not self:InitializeMatchCardStates(playerSeed, enemySeed) then
			log_error("[Phase2C4A][Deck] ResetBattle initialization failed")
		end

		self:ClearSlots()
		if self.Phase == "Placement" then
			self:PrepareEnemyPlacementForTurn()
		end
		self:RefreshPlayerSlotOccupancy()
		self:RefreshUsedCardMask()
		self:SendPrivateCardState("Reset", nil)

		log(
			"[ThreeLaneBoard] Battle reset - PlayerHP=30, EnemyHP=30, Turn=1, Cost="
			.. tostring(self.CurrentCost)
			.. "/"
			.. tostring(self.MaxCost)
			.. ", Phase="
			.. self.Phase
			.. ", EnemyCost="
			.. tostring(self.EnemyCurrentCost)
			.. ", PlayerHand="
			.. tostring(self.PlayerHandCount)
			.. ", EnemyHand="
			.. tostring(self.EnemyHandCount)
		)
	end

	@ExecSpace("ServerOnly")
	method ThreeLaneCombat GetCombat()
		-- 같은 PrototypeBoard 엔티티의 전투 단일 권위 컴포넌트를 반환한다.
		---@type ThreeLaneCombat
		local combat = self.Entity:GetComponent("script.ThreeLaneCombat")
		if not isvalid(combat) then
			return nil
		end
		return combat
	end

	@ExecSpace("ServerOnly")
	method ThreeLaneData GetData()
		-- 같은 PrototypeBoard의 검증 완료 MonsterData 캐시를 반환한다.
		---@type ThreeLaneData
		local data = self.Entity:GetComponent("script.ThreeLaneData")
		if not isvalid(data) then
			return nil
		end
		if not data.IsReady and not data:LoadAndValidate() then
			return nil
		end
		return data
	end

	@ExecSpace("ServerOnly")
	method any GetMonsterByCardIndex(integer cardIndex)
		-- 실제 플레이 카드 번호를 MonsterData 기본 7종 행으로 변환한다.
		local data = self:GetData()
		if not isvalid(data) then
			return nil
		end
		return data:GetMonsterByCardIndex(cardIndex)
	end

	@ExecSpace("ServerOnly")
	method any GetMonsterById(string monsterId)
		-- 테스트 기준 드레이크를 포함해 MonsterId로 데이터 행을 조회한다.
		local data = self:GetData()
		if not isvalid(data) then
			return nil
		end
		return data:GetMonsterById(monsterId)
	end

	@ExecSpace("ServerOnly")
	method void PrepareEnemyPlacementForTurn()
		-- AI 자신의 손패·코스트·영구 빈 슬롯만 읽는 결정론적 기본 배치기다.
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		self.EnemyPlacementSerial = 0
		local state = self.EnemyCardState
		if state == nil or state.Hand == nil then
			return
		end
		local safety = 0
		while safety < 15 do
			safety = safety + 1
			local candidateId = ""
			for _, instanceId in ipairs(state.Hand) do
				local instance = state.InstanceById[instanceId]
				if instance ~= nil and instance.Cost <= self.EnemyCurrentCost then
					candidateId = instanceId
					break
				end
			end
			local slotIndex = self:GetFirstFreePermanentSlot(2)
			if candidateId == "" or slotIndex == 0 then
				break
			end
			if not self:TryReserveCardInstance(2, slotIndex, candidateId, "EnemyAI") then
				break
			end
		end
		log(
			"[ThreeLaneBoard][EnemyPlan] Turn="
			.. tostring(self.TurnNumber)
			.. ", Pending="
			.. tostring(self.EnemyPendingCount)
			.. ", Cost="
			.. tostring(self.EnemyCurrentCost)
			.. ", Hand="
			.. tostring(self.EnemyHandCount)
		)
	end

	@ExecSpace("ServerOnly")
	method integer GetFirstFreePermanentSlot(integer ownerSide)
		-- AI는 자기 상태만 사용하고 중앙 우선 고정 순서로 빈 슬롯을 찾는다.
		local priority = { 8, 7, 9, 6, 10, 3, 13, 2, 12, 4, 14, 1, 11, 5, 15 }
		for _, slotIndex in ipairs(priority) do
			if not self:IsPermanentSlotOccupied(ownerSide, slotIndex)
				and not self:IsReservedSlotOccupied(ownerSide, slotIndex) then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void UpdateBattleRemainingFromCombat(integer simTick, integer limitTicks)
		-- HUD 표시값을 Combat의 정수 Tick에서만 파생해 동기화한다.
		local remainingTicks = limitTicks - simTick
		if remainingTicks < 0 then
			remainingTicks = 0
		end
		self.BattleRemaining = remainingTicks / 60
	end

	@ExecSpace("ServerOnly")
	method void OnCombatResolved(string reason, integer simTick)
		-- Combat의 활성 개체 0 또는 타임아웃 통지를 한 번만 Resolve 페이즈로 전환한다.
		if self.BattleState ~= "Playing" or self.Phase ~= "Battle" then
			return
		end
		log(
			"[ThreeLaneBoard] Combat resolved - Tick="
			.. tostring(simTick)
			.. ", Reason="
			.. reason
			.. ", PlayerCost="
			.. tostring(self.CurrentCost)
			.. ", EnemyCost="
			.. tostring(self.EnemyCurrentCost)
		)
		self:EnterResolve(reason)
	end

	@ExecSpace("Server")
	method void RequestSetSimulationSpeed(integer speed)
		-- 클라이언트 배속 버튼 요청을 서버의 1/2 배속 검증 경로로 연결한다.
		self:SetSimulationSpeed(speed)
	end

	@ExecSpace("ServerOnly")
	method void SetSimulationSpeed(integer speed)
		-- 현재 배속을 1 또는 2로 제한하고 Combat 처리 Tick 수에만 반영한다.
		if speed ~= 2 then
			self.SimSpeed = 1
		else
			self.SimSpeed = 2
		end
		local combat = self:GetCombat()
		if isvalid(combat) then
			combat:SetSimulationSpeed(self.SimSpeed)
		end
		log("[ThreeLaneBoard] SimSpeed=x" .. tostring(self.SimSpeed))
	end

	@ExecSpace("ServerOnly")
	method string GetDeckMonsterSignature(any state)
		-- InstanceId 접두사와 무관하게 셔플된 MonsterId 순서를 비교한다.
		if state == nil or state.Deck == nil then
			return ""
		end
		local values = {}
		for _, instanceId in ipairs(state.Deck) do
			local instance = state.InstanceById[instanceId]
			table.insert(values, instance.MonsterId)
		end
		return table.concat(values, ">")
	end

	@ExecSpace("ServerOnly")
	method table ForceTestHand(integer ownerSide, table monsterIds)
		-- Maker ServerOnly 테스트에서만 원하는 복사본을 손패에 두고 모든 영역을 일관되게 초기화한다.
		local state = self:GetCardState(ownerSide)
		local selected = {}
		if state == nil or state.InstanceById == nil then
			return selected
		end
		local allIds = {}
		for instanceId, _ in pairs(state.InstanceById) do
			table.insert(allIds, instanceId)
		end
		table.sort(allIds)
		local used = {}
		for _, monsterId in ipairs(monsterIds) do
			for _, instanceId in ipairs(allIds) do
				local instance = state.InstanceById[instanceId]
				if used[instanceId] ~= true and instance.MonsterId == monsterId then
					used[instanceId] = true
					table.insert(selected, instanceId)
					break
				end
			end
		end
		state.Deck = {}
		state.Hand = {}
		state.Burned = {}
		state.Installed = {}
		state.NextPlacementOrder = 0
		state.LastDrawTurn = 0
		for _, instanceId in ipairs(allIds) do
			local instance = state.InstanceById[instanceId]
			instance.PermanentSlotIndex = 0
			instance.PlacementOrder = 0
			instance.EffectTargetInstanceId = ""
			instance.EffectDestinationSlotIndex = 0
			instance.RevealEffectResolved = false
			if used[instanceId] == true then
				instance.State = "Hand"
				table.insert(state.Hand, instanceId)
			else
				instance.State = "Deck"
				table.insert(state.Deck, instanceId)
			end
		end
		self:SyncPublicCardCounts()
		self:RefreshUsedCardMask()
		return selected
	end

	@ExecSpace("ServerOnly")
	method boolean InstallCardForTest(integer ownerSide, string instanceId, integer slotIndex, integer order)
		local state = self:GetCardState(ownerSide)
		if state == nil or state.InstanceById == nil then
			return false
		end
		local instance = state.InstanceById[instanceId]
		if instance == nil then
			return false
		end
		local handIndex = self:FindIdIndex(state.Hand, instanceId)
		if handIndex > 0 then
			table.remove(state.Hand, handIndex)
		end
		local deckIndex = self:FindIdIndex(state.Deck, instanceId)
		if deckIndex > 0 then
			table.remove(state.Deck, deckIndex)
		end
		instance.State = "Installed"
		instance.PermanentSlotIndex = slotIndex
		instance.PlacementOrder = order
		instance.EffectTargetInstanceId = ""
		instance.EffectDestinationSlotIndex = 0
		instance.RevealEffectResolved = false
		state.NextPlacementOrder = math.max(state.NextPlacementOrder, order)
		if self:FindIdIndex(state.Installed, instanceId) == 0 then
			table.insert(state.Installed, instanceId)
		end
		self:SyncPublicCardCounts()
		return true
	end

	@ExecSpace("ServerOnly")
	method any FindActiveUnitByInstanceId(string instanceId)
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return nil
		end
		for _, unit in ipairs(combat.Units) do
			if unit.CardInstanceId == instanceId then
				return unit
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean PreparePhase2C4ATestState(integer playerSeed, integer enemySeed)
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return false
		end
		self:KillActiveUnits()
		combat:ResetSimulation(false)
		combat.MakerHarnessRunning = true
		self.PendingPlacements = {}
		self.EnemyPendingPlacements = {}
		self.PendingCount = 0
		self.EnemyPendingCount = 0
		self.PlacementSerial = 0
		self.EnemyPlacementSerial = 0
		self.LastRevealEffectTurn = 0
		self.BattleState = "Playing"
		self.Phase = "Placement"
		self.TurnNumber = 1
		self.CurrentCost = 10
		self.EnemyCurrentCost = 10
		self.PlayerNexusHp = 30
		self.EnemyNexusHp = 30
		self.PlayerCardState = self:BuildDefaultDeckState(1, playerSeed)
		self.EnemyCardState = self:BuildDefaultDeckState(2, enemySeed)
		if self.PlayerCardState == nil or self.EnemyCardState == nil then
			return false
		end
		self:ClearSlots()
		self:SyncPublicCardCounts()
		self:RefreshUsedCardMask()
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean RecordPhase2C4ARegression(string name, boolean passed)
		if passed then
			log("[Phase2C4A][TEST][" .. name .. "] PASS")
		else
			log_error("[Phase2C4A][TEST][" .. name .. "] FAIL")
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C4ARegression()
		-- 덱·리롤·드로우·인스턴스 예약·영구 설치·AI 동등 제약을 실제 Maker 서버에서 검증한다.
		local allPassed = true
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return false
		end
		combat.MakerHarnessRunning = true

		local playerA = self:BuildDefaultDeckState(1, 424242)
		local playerB = self:BuildDefaultDeckState(1, 424242)
		local enemyA = self:BuildDefaultDeckState(2, 424242)
		local enemyB = self:BuildDefaultDeckState(2, 424242)
		local seedPassed = playerA ~= nil and playerB ~= nil and enemyA ~= nil and enemyB ~= nil
			and self:GetDeckMonsterSignature(playerA) == self:GetDeckMonsterSignature(playerB)
			and self:GetDeckMonsterSignature(enemyA) == self:GetDeckMonsterSignature(enemyB)
			and self:GetDeckMonsterSignature(playerA) == self:GetDeckMonsterSignature(enemyA)
		allPassed = self:RecordPhase2C4ARegression("SeedReproducibilityBothSides", seedPassed) and allPassed

		self:PreparePhase2C4ATestState(11111, 22222)
		for _ = 1, 4 do
			self:DrawOneCard(1)
		end
		local initial = {}
		for index, instanceId in ipairs(self.PlayerCardState.Hand) do
			initial[index] = instanceId
		end
		local rerollPassed = self:ConfirmInitialReroll(1, true)
		local allReplaced = true
		for _, instanceId in ipairs(initial) do
			if self:FindIdIndex(self.PlayerCardState.Hand, instanceId) > 0 then
				allReplaced = false
			end
		end
		local noImmediateReturn = allReplaced
		self:DrawForTurn(1, 1)
		allPassed = self:RecordPhase2C4ARegression(
			"Initial4FullRerollTurn1Draw5",
			rerollPassed and #self.PlayerCardState.Hand == 5
		) and allPassed
		allPassed = self:RecordPhase2C4ARegression("FullRerollReplacesAll", allReplaced) and allPassed
		allPassed = self:RecordPhase2C4ARegression(
			"RerolledInstanceNoImmediateReturn",
			noImmediateReturn
		) and allPassed
		local deckBeforeDuplicate = #self.PlayerCardState.Deck
		local duplicateDrawRejected = not self:DrawForTurn(1, 1)
		local nextTurnDraw = self:DrawForTurn(1, 2)
		allPassed = self:RecordPhase2C4ARegression(
			"ExactlyOneDrawPerTurn",
			duplicateDrawRejected and nextTurnDraw and #self.PlayerCardState.Deck == deckBeforeDuplicate - 1
		) and allPassed

		self:PreparePhase2C4ATestState(33333, 44444)
		for _ = 1, 7 do
			self:DrawOneCard(1)
		end
		local burnId = self.PlayerCardState.Deck[1]
		self:DrawOneCard(1)
		local burnInstance = self.PlayerCardState.InstanceById[burnId]
		allPassed = self:RecordPhase2C4ARegression(
			"HandOverflowBurn",
			#self.PlayerCardState.Hand == 7 and #self.PlayerCardState.Burned == 1
				and burnInstance.State == "Burned"
		) and allPassed

		local unique = {}
		local uniqueCount = 0
		local slimeCount = 0
		for instanceId, instance in pairs(self.PlayerCardState.InstanceById) do
			if unique[instanceId] ~= true then
				unique[instanceId] = true
				uniqueCount = uniqueCount + 1
			end
			if instance.MonsterId == "slime" then
				slimeCount = slimeCount + 1
			end
		end
		allPassed = self:RecordPhase2C4ARegression(
			"DuplicateInstancesUnique",
			uniqueCount == 15 and slimeCount == 3
		) and allPassed

		self:PreparePhase2C4ATestState(55555, 66666)
		local placementIds = self:ForceTestHand(1, { "slime", "slime", "ribbon_pig" })
		local firstPlaced = self:TryReserveCardInstance(1, 1, placementIds[1], "Phase2C4A")
		local secondPlaced = self:TryReserveCardInstance(1, 2, placementIds[2], "Phase2C4A")
		local costAfterTwo = self.CurrentCost
		allPassed = self:RecordPhase2C4ARegression(
			"MultiplePlacementsOneTurn",
			firstPlaced and secondPlaced and self.PendingCount == 2 and costAfterTwo == 8
		) and allPassed
		self:CancelPlacementAt(2, "Phase2C4A", "Phase2C4AUndo")
		local exactUndo = self.PlayerCardState.InstanceById[placementIds[2]].State == "Hand"
			and self:FindIdIndex(self.PlayerCardState.Hand, placementIds[2]) > 0
			and self.CurrentCost == 9 and self.PendingCount == 1
		allPassed = self:RecordPhase2C4ARegression("UndoExactInstanceAndRefund", exactUndo) and allPassed
		self:CommitPendingPlacements(1)
		self.PendingPlacements = {}
		self.PendingCount = 0
		local installedInstance = self.PlayerCardState.InstanceById[placementIds[1]]
		local permanentPassed = installedInstance.State == "Installed"
			and installedInstance.PermanentSlotIndex == 1
			and self:FindIdIndex(self.PlayerCardState.Hand, placementIds[1]) == 0
			and self:FindIdIndex(self.PlayerCardState.Deck, placementIds[1]) == 0
		allPassed = self:RecordPhase2C4ARegression("ConfirmPermanentNoRedraw", permanentPassed) and allPassed

		combat:PrepareReveal()
		self:SpawnInstalledCards(1)
		local firstUnit = self:FindActiveUnitByInstanceId(placementIds[1])
		local firstHp = firstUnit ~= nil and firstUnit.HP or 0
		self:KillActiveUnits()
		self.Phase = "Resolve"
		self:BeginNextTurn()
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		self:ForceTestHand(2, {})
		self:EnterReveal()
		local respawnedUnit = self:FindActiveUnitByInstanceId(placementIds[1])
		allPassed = self:RecordPhase2C4ARegression(
			"DeadUnitRespawnsPermanentSlot",
			firstHp > 0 and self.TurnNumber == 2
				and respawnedUnit ~= nil and respawnedUnit.SlotIndex == 1
				and respawnedUnit.HP == respawnedUnit.MaxHP
		) and allPassed

		self:PreparePhase2C4ATestState(77777, 88888)
		local moveIds = self:ForceTestHand(1, { "slime", "ribbon_pig" })
		self:InstallCardForTest(1, moveIds[1], 3, 1)
		self:InstallCardForTest(1, moveIds[2], 13, 2)
		local moveRibbonInstance = self.PlayerCardState.InstanceById[moveIds[2]]
		moveRibbonInstance.EffectTargetInstanceId = moveIds[1]
		moveRibbonInstance.EffectDestinationSlotIndex = 8
		moveRibbonInstance.RevealEffectResolved = false
		combat:PrepareReveal()
		self:SpawnInstalledCards(1)
		self:ResolveRevealEffects()
		local movedPermanent = self.PlayerCardState.InstanceById[moveIds[1]].PermanentSlotIndex == 8
		self:KillActiveUnits()
		combat:PrepareReveal()
		self.LastRevealEffectTurn = 0
		self.TurnNumber = 2
		self:SpawnInstalledCards(1)
		local movedRespawn = self:FindActiveUnitByInstanceId(moveIds[1])
		allPassed = self:RecordPhase2C4ARegression(
			"RibbonPermanentMoveNextTurn",
			movedPermanent and movedRespawn ~= nil and movedRespawn.SlotIndex == 8
		) and allPassed

		self:PreparePhase2C4ATestState(99999, 12345)
		while #self.PlayerCardState.Deck > 0 do
			self:DrawOneCard(1)
		end
		local handAtEmpty = #self.PlayerCardState.Hand
		local burnedAtEmpty = #self.PlayerCardState.Burned
		local hpAtEmpty = self.PlayerNexusHp
		local noCard = self:DrawOneCard(1)
		allPassed = self:RecordPhase2C4ARegression(
			"EmptyDeckNoRecycleNoFatigue",
			noCard == nil and #self.PlayerCardState.Deck == 0
				and #self.PlayerCardState.Hand == handAtEmpty
				and #self.PlayerCardState.Burned == burnedAtEmpty
				and self.PlayerNexusHp == hpAtEmpty
		) and allPassed

		self:PreparePhase2C4ATestState(24680, 13579)
		for _ = 1, 4 do
			self:DrawOneCard(1)
			self:DrawOneCard(2)
		end
		self:ConfirmInitialReroll(1, false)
		self:ConfirmInitialReroll(2, false)
		self:DrawForTurn(1, 1)
		self:DrawForTurn(2, 1)
		local playerSignatureBeforeAi = self:GetDeckMonsterSignature(self.PlayerCardState)
		self.CurrentCost = 2
		self.EnemyCurrentCost = 2
		self:PrepareEnemyPlacementForTurn()
		local enemyConstrained = self.PlayerHandCount == 5
			and self:GetDeckMonsterSignature(self.PlayerCardState) == playerSignatureBeforeAi
			and self.EnemyPendingCount >= 0
			and self.EnemyHandCount == 5
			and self.PlayerDeckCount == #self.PlayerCardState.Deck
			and self.EnemyDeckCount == #self.EnemyCardState.Deck
		allPassed = self:RecordPhase2C4ARegression(
			"EnemySameConstraintsAndPublicCounts",
			enemyConstrained
		) and allPassed

		local orange = self:GetMonsterByCardIndex(8)
		allPassed = self:RecordPhase2C4ARegression(
			"OrangeMushroomRuntimeCard",
			orange ~= nil and orange.MonsterId == "orange_mushroom" and orange.Cost == 1
		) and allPassed

		self.UseFixedMatchSeed = false
		self.AutoConfirmRerollWithoutUI = false
		combat.MakerHarnessRunning = false
		self:ResetBattle()
		if allPassed then
			log("[Phase2C4A][TEST][ALL] PASS - normal play state restored")
		else
			log_error("[Phase2C4A][TEST][ALL] FAIL - see scenario logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2ARegression()
		-- 새 손패·영구 설치 규칙 아래 Phase 2A 페이즈·코스트·취소·확정·타임아웃·재시작을 회귀한다.
		local allPassed = true
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return false
		end
		combat.MakerHarnessRunning = true

		self.UseFixedMatchSeed = true
		self:ResetBattle()
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		local phaseStart = self.Phase == "Placement" and self.TurnNumber == 1 and self.CurrentCost == 2
		allPassed = self:RecordMakerRegression("PhaseStart", phaseStart) and allPassed
		self:EnterReveal()
		self:EnterBattle()
		combat:StepBattle()
		local phaseFlow = self.Phase == "Resolve"
		self:BeginNextTurn()
		phaseFlow = phaseFlow and self.Phase == "Placement" and self.TurnNumber == 2 and self.CurrentCost == 4
		allPassed = self:RecordMakerRegression("PhaseFlowAndCarry", phaseFlow) and allPassed

		self:ResetBattle()
		self.PendingPlacements = {}
		self.PendingCount = 0
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		local cancelCards = self:ForceTestHand(1, { "ribbon_pig" })
		local map = self.Entity.CurrentMap
		local slot = map:GetChildByName("PlayerSlot_1")
		local accepted = self:TryReserveCardInstance(1, 1, cancelCards[1], "MakerRegression")
		local spent = accepted and self.CurrentCost == 0 and self.PendingCount == 1
		self:CancelPlacementAt(1, "MakerRegression", "RegressionCancel")
		local refunded = self.CurrentCost == 2 and self.PendingCount == 0
			and self.PlayerCardState.InstanceById[cancelCards[1]].State == "Hand"
		allPassed = self:RecordMakerRegression("CostSpendCancelRefund", spent and refunded) and allPassed

		self:ResetBattle()
		self:ForceTestHand(2, {})
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		self.CurrentCost = 9
		self.EnemyCurrentCost = 9
		self:BeginNextTurn()
		allPassed = self:RecordMakerRegression(
			"CostCap",
			self.CurrentCost == 10 and self.MaxCost == 10
		) and allPassed

		self:ResetBattle()
		local playerDeckBeforeAi = self:GetDeckMonsterSignature(self.PlayerCardState)
		local enemyPlan = self.EnemyPendingCount >= 0
			and self.EnemyHandCount + self.EnemyPendingCount == 5
			and self:GetDeckMonsterSignature(self.PlayerCardState) == playerDeckBeforeAi
		allPassed = self:RecordMakerRegression("IndependentEnemyCardPlan", enemyPlan) and allPassed

		self:ResetBattle()
		self.PendingPlacements = {}
		self.PendingCount = 0
		self.EnemyPendingPlacements = {}
		self.EnemyPendingCount = 0
		self:ForceTestHand(2, {})
		local confirmCards = self:ForceTestHand(1, { "slime" })
		local confirmSlot = map:GetChildByName("PlayerSlot_1")
		local confirmAccepted = self:TryReserveCardInstance(1, 1, confirmCards[1], "MakerRegression")
		self:EnterReveal()
		local confirmPassed = confirmAccepted
			and self.Phase == "Reveal"
			and self.PendingCount == 0
			and self.PlayerInstalledCount == 1
			and combat:CountActiveUnits() == 1
		allPassed = self:RecordMakerRegression("PlacementConfirm", confirmPassed) and allPassed

		local timeoutConfigured = self.BattleTimeLimit == 60 and combat.BattleTimeLimitTicks == 3600
		allPassed = self:RecordMakerRegression("Battle60SecondTimeoutConfig", timeoutConfigured) and allPassed

		self.PlayerNexusHp = 1
		self.EnemyNexusHp = 2
		self.CurrentCost = 0
		self:ResetBattle()
		local restartPassed = self.PlayerNexusHp == 30
			and self.EnemyNexusHp == 30
			and self.CurrentCost == 2
			and self.TurnNumber == 1
			and self.Phase == "Placement"
			and self.PlayerHandCount == 5
			and self.EnemyHandCount + self.EnemyPendingCount == 5
		allPassed = self:RecordMakerRegression("Restart", restartPassed) and allPassed
		self.UseFixedMatchSeed = false
		combat.MakerHarnessRunning = false

		if allPassed then
			log("[ThreeLaneBoard][REGRESSION][ALL] PASS")
		else
			log_error("[ThreeLaneBoard][REGRESSION][ALL] FAIL")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean RecordMakerRegression(string name, boolean passed)
		-- 회귀 항목별 PASS/FAIL을 같은 로그 형식으로 기록한다.
		if passed then
			log("[ThreeLaneBoard][REGRESSION][" .. name .. "] PASS")
		else
			log_error("[ThreeLaneBoard][REGRESSION][" .. name .. "] FAIL")
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C2DataRegression()
		-- 기본 7종을 실제 프로토타입 모델로 소환해 MonsterData 전달 계약을 전부 비교한다.
		local combat = self:GetCombat()
		local data = self:GetData()
		if not isvalid(combat) or not isvalid(data) then
			log_error("[Phase2C2][DATA][ALL] FAIL - combat or data component missing")
			return false
		end

		combat.MakerHarnessRunning = true
		self:ResetBattle()
		local allPassed = true
		local map = self.Entity.CurrentMap
		local expectedIds = {
			"slime",
			"ribbon_pig",
			"green_mushroom",
			"stone_golem",
			"yeti",
			"junior_balrog",
			"pink_bean"
		}
		local meleeCount = 0
		local rangedCount = 0

		allPassed = self:RecordPhase2C2Regression(
			"DataCounts",
			data.MonsterCount == 13 and data.GradeRuleCount == 5
		) and allPassed

		for cardIndex = 1, 7 do
			local monster = data:GetMonsterByCardIndex(cardIndex)
			local slot = nil
			if isvalid(map) then
				slot = map:GetChildByName("PlayerSlot_" .. tostring(cardIndex))
			end
			local mappingPassed = monster ~= nil
				and monster.MonsterId == expectedIds[cardIndex]
				and isvalid(slot)
			allPassed = self:RecordPhase2C2Regression(
				"CardMap" .. tostring(cardIndex),
				mappingPassed
			) and allPassed

			if mappingPassed then
				local beforeCount = #combat.Units
				self:SpawnPlacement(
					{
						Order = cardIndex,
						CardIndex = cardIndex,
						MonsterId = monster.MonsterId,
						Cost = monster.Cost,
						SlotIndex = cardIndex,
						Position = slot.TransformComponent.WorldPosition,
						OwnerUserId = "Phase2C2Regression",
						OwnerSide = 1
					}
				)
				local unit = combat.Units[beforeCount + 1]
				local spawnPassed = self:IsSpawnDataMatch(unit, monster)
				allPassed = self:RecordPhase2C2Regression(
					"SpawnData" .. tostring(cardIndex),
					spawnPassed
				) and allPassed

				if monster.RangeClass == "Melee" then
					meleeCount = meleeCount + 1
				elseif monster.RangeClass == "Ranged" then
					rangedCount = rangedCount + 1
				end
			end
		end

		allPassed = self:RecordPhase2C2Regression(
			"RangeClassCounts",
			meleeCount == 4 and rangedCount == 3
		) and allPassed

		local yeti = data:GetMonsterById("yeti")
		local yetiPassed = yeti ~= nil
			and yeti.CardIndex == 5
			and yeti.Cost == 5
			and yeti.HP == 550
			and yeti.Attack == 135
			and yeti.AttackIntervalTicks == 90
			and yeti.FirstAttackDelayTicks == 18
			and yeti.NexusDamage == 8
			and yeti.Cost ~= yeti.NexusDamage
		allPassed = self:RecordPhase2C2Regression("YetiCost5Nexus8", yetiPassed) and allPassed

		self:ResetBattle()
		combat.MakerHarnessRunning = false
		if allPassed then
			log("[Phase2C2][DATA][ALL] PASS - 7 actual spawns restored to normal play")
		else
			log_error("[Phase2C2][DATA][ALL] FAIL - see item logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C3ARegression()
		-- 공개 효과 11개 규칙 시나리오와 실제 엔티티 위치 갱신을 한 번에 검증한다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[Phase2C3A][TEST][ALL] FAIL - combat missing")
			return false
		end
		combat.MakerHarnessRunning = true
		local allPassed = true
		local scenarios = {
			"RibbonTopToMiddle",
			"RibbonMiddleToBottom",
			"RibbonBlockedDestination",
			"RibbonNoTarget",
			"BalrogTwoLatestMiddle",
			"BalrogFewerTargets",
			"RibbonThenBalrogChain",
			"BalrogThenRibbonOrder",
			"RevealNoEarlyCombatTick",
			"SpeedDeterminism",
			"NextTurnReset"
		}

		for _, scenarioName in ipairs(scenarios) do
			local passed = self:RunPhase2C3AScenario(scenarioName)
			allPassed = self:RecordPhase2C3ARegression(scenarioName, passed) and allPassed
		end

		local actualPassed = self:RunPhase2C3AActualSpawnRegression()
		allPassed = self:RecordPhase2C3ARegression("ActualSpawnRevealState", actualPassed) and allPassed
		self:ResetBattle()
		combat.MakerHarnessRunning = false
		if allPassed then
			log("[Phase2C3A][TEST][ALL] PASS - normal play state restored")
		else
			log_error("[Phase2C3A][TEST][ALL] FAIL - see scenario logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean PreparePhase2C3ATestState()
		-- 시나리오마다 레지스트리·Tick·턴 효과 가드를 초기화한다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return false
		end
		combat.MakerHarnessRunning = true
		self:ResetBattle()
		combat.MakerHarnessRunning = true
		self.Phase = "Reveal"
		self.LastRevealEffectTurn = 0
		combat:PrepareReveal()
		return combat.SimTick == 0 and not combat.IsRunning
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C3AScenario(string scenarioName)
		-- 각 시나리오는 동일한 효과 해결 메서드만 사용하며 테스트 전용 분기에서 결과를 조작하지 않는다.
		if scenarioName == "SpeedDeterminism" then
			local speed1 = self:BuildRevealDeterminismSignature(1)
			local speed2 = self:BuildRevealDeterminismSignature(2)
			log(
				"[Phase2C3A][SpeedCompare] Speed1="
				.. speed1
				.. ", Speed2="
				.. speed2
				.. ", Equal="
				.. tostring(speed1 ~= "" and speed1 == speed2)
			)
			return speed1 ~= "" and speed1 == speed2
		end

		if not self:PreparePhase2C3ATestState() then
			return false
		end
		local combat = self:GetCombat()

		if scenarioName == "RibbonTopToMiddle" then
			local target = self:CreateRevealTestUnit("slime", 1, 1, 3)
			self:CreateRevealTestUnit("ribbon_pig", 1, 2, 13)
			local resolved = self:ResolveRevealEffects()
			return resolved and target ~= nil and target.SlotIndex == 8 and target.LaneIndex == 2
		end

		if scenarioName == "RibbonMiddleToBottom" then
			local target = self:CreateRevealTestUnit("slime", 1, 1, 8)
			self:CreateRevealTestUnit("ribbon_pig", 1, 2, 3)
			local resolved = self:ResolveRevealEffects()
			return resolved and target ~= nil and target.SlotIndex == 13 and target.LaneIndex == 3
		end

		if scenarioName == "RibbonBlockedDestination" then
			local top = self:CreateRevealTestUnit("slime", 1, 1, 3)
			local middle = self:CreateRevealTestUnit("stone_golem", 1, 2, 8)
			local ribbon = self:CreateRevealTestUnit("ribbon_pig", 1, 3, 13)
			local resolved = self:ResolveRevealEffects()
			return resolved
				and top ~= nil and top.SlotIndex == 3
				and middle ~= nil and middle.SlotIndex == 8
				and ribbon ~= nil and ribbon.SlotIndex == 13
		end

		if scenarioName == "RibbonNoTarget" then
			local bottom = self:CreateRevealTestUnit("slime", 1, 1, 13)
			self:CreateRevealTestUnit("ribbon_pig", 1, 2, 3)
			local resolved = self:ResolveRevealEffects()
			return resolved and bottom ~= nil and bottom.SlotIndex == 13
		end

		if scenarioName == "BalrogTwoLatestMiddle" then
			local first = self:CreateRevealTestUnit("slime", 1, 1, 6)
			local second = self:CreateRevealTestUnit("green_mushroom", 1, 2, 7)
			local third = self:CreateRevealTestUnit("stone_golem", 1, 3, 8)
			self:CreateRevealTestUnit("junior_balrog", 1, 4, 1)
			local resolved = self:ResolveRevealEffects()
			return resolved
				and first ~= nil and first.CombatAttackBonus == 0 and first.Attack == first.BaseAttack
				and second ~= nil and second.CombatAttackBonus == 30 and second.Attack == second.BaseAttack + 30
				and third ~= nil and third.CombatAttackBonus == 30 and third.Attack == third.BaseAttack + 30
		end

		if scenarioName == "BalrogFewerTargets" then
			local only = self:CreateRevealTestUnit("slime", 1, 1, 6)
			local balrog = self:CreateRevealTestUnit("junior_balrog", 1, 2, 1)
			local resolved = self:ResolveRevealEffects()
			return resolved
				and only ~= nil and only.CombatAttackBonus == 30 and only.Attack == only.BaseAttack + 30
				and balrog ~= nil and balrog.CombatAttackBonus == 0
		end

		if scenarioName == "RibbonThenBalrogChain" then
			local target = self:CreateRevealTestUnit("slime", 1, 1, 3)
			self:CreateRevealTestUnit("ribbon_pig", 1, 2, 13)
			self:CreateRevealTestUnit("junior_balrog", 1, 3, 1)
			local resolved = self:ResolveRevealEffects()
			return resolved
				and target ~= nil and target.SlotIndex == 8 and target.LaneIndex == 2
				and target.CombatAttackBonus == 30 and target.Attack == target.BaseAttack + 30
		end

		if scenarioName == "BalrogThenRibbonOrder" then
			local target = self:CreateRevealTestUnit("slime", 1, 1, 3)
			self:CreateRevealTestUnit("junior_balrog", 1, 2, 1)
			self:CreateRevealTestUnit("ribbon_pig", 1, 3, 13)
			local resolved = self:ResolveRevealEffects()
			return resolved
				and target ~= nil and target.SlotIndex == 8 and target.LaneIndex == 2
				and target.CombatAttackBonus == 0 and target.Attack == target.BaseAttack
		end

		if scenarioName == "RevealNoEarlyCombatTick" then
			self:CreateRevealTestUnit("slime", 1, 1, 3)
			self:CreateRevealTestUnit("ribbon_pig", 1, 2, 13)
			local beforeTick = combat.SimTick
			local resolved = self:ResolveRevealEffects()
			return resolved and beforeTick == 0 and combat.SimTick == 0 and not combat.IsRunning
		end

		if scenarioName == "NextTurnReset" then
			local oldTarget = self:CreateRevealTestUnit("slime", 1, 1, 3)
			self:CreateRevealTestUnit("ribbon_pig", 1, 2, 13)
			self:CreateRevealTestUnit("junior_balrog", 1, 3, 1)
			local firstResolved = self:ResolveRevealEffects()
			local oldChanged = firstResolved
				and oldTarget ~= nil and oldTarget.SlotIndex == 8
				and oldTarget.CombatAttackBonus == 30
			oldTarget.Alive = false
			oldTarget.Exited = true
			for _, oldUnit in ipairs(combat.Units) do
				oldUnit.Alive = false
				oldUnit.Exited = true
			end
			self.TurnNumber = self.TurnNumber + 1
			self.LastRevealEffectTurn = 0
			combat:PrepareReveal()
			local fresh = self:CreateRevealTestUnit("slime", 1, 1, 3)
			return oldChanged
				and fresh ~= nil
				and fresh.SlotIndex == fresh.BaseSlotIndex
				and fresh.LaneIndex == fresh.BaseLaneIndex
				and fresh.Attack == fresh.BaseAttack
				and fresh.CombatAttackBonus == 0
		end

		return false
	end

	@ExecSpace("ServerOnly")
	method any CreateRevealTestUnit(string monsterId, integer ownerSide, integer placementOrder, integer slotIndex)
		-- 실제 슬롯 좌표를 쓰는 테스트 테이블을 만들어 위치·공격력 효과를 같은 코어 경로로 검증한다.
		local combat = self:GetCombat()
		local position = self:GetSlotWorldPosition(ownerSide, slotIndex)
		if not isvalid(combat) or position == nil then
			return nil
		end
		local laneIndex = math.floor((slotIndex - 1) / 5) + 1
		local unit = combat:CreateTestMonster(monsterId, ownerSide, laneIndex, position.x)
		if unit == nil then
			return nil
		end
		unit.PlacementOrder = placementOrder
		unit.SlotIndex = slotIndex
		unit.BaseSlotIndex = slotIndex
		unit.LaneIndex = laneIndex
		unit.BaseLaneIndex = laneIndex
		unit.SimX = position.x
		unit.CombatStartX = position.x
		unit.CombatStartY = position.y
		return unit
	end

	@ExecSpace("ServerOnly")
	method string BuildRevealDeterminismSignature(integer speed)
		-- 같은 배치 명령을 배속 값만 바꿔 두 번 해결하고 효과 결과만 직렬화한다.
		if not self:PreparePhase2C3ATestState() then
			return ""
		end
		self.SimSpeed = speed
		self:CreateRevealTestUnit("slime", 1, 1, 3)
		self:CreateRevealTestUnit("ribbon_pig", 1, 2, 13)
		self:CreateRevealTestUnit("green_mushroom", 1, 3, 7)
		self:CreateRevealTestUnit("junior_balrog", 1, 4, 1)
		if not self:ResolveRevealEffects() then
			return ""
		end
		return self:GetRevealStateSignature(1)
	end

	@ExecSpace("ServerOnly")
	method string GetRevealStateSignature(integer ownerSide)
		-- 배치 순서·현재 슬롯·라인·최종 공격력·보너스를 안정적인 문자열로 만든다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			return ""
		end
		local units = {}
		for _, unit in ipairs(combat:BuildStableSnapshot()) do
			if unit.OwnerSide == ownerSide and unit.PlacementOrder > 0 then
				table.insert(units, unit)
			end
		end
		table.sort(
			units,
			function(a, b)
				if a.PlacementOrder == b.PlacementOrder then
					return a.CombatUnitId < b.CombatUnitId
				end
				return a.PlacementOrder < b.PlacementOrder
			end
		)
		local signature = ""
		for _, unit in ipairs(units) do
			signature = signature
				.. tostring(unit.PlacementOrder)
				.. ":"
				.. unit.MonsterId
				.. "@"
				.. tostring(unit.SlotIndex)
				.. "/L"
				.. tostring(unit.LaneIndex)
				.. "/A"
				.. tostring(unit.Attack)
				.. "+"
				.. tostring(unit.CombatAttackBonus)
				.. ";"
		end
		return signature
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C3AActualSpawnRegression()
		-- 양 진영 실제 컴포넌트를 모두 소환한 뒤 Transform·논리 상태·원본 데이터 분리를 확인한다.
		if not self:PreparePhase2C3ATestState() then
			return false
		end
		local combat = self:GetCombat()
		local data = self:GetData()
		if not isvalid(combat) or not isvalid(data) then
			return false
		end

		local ids = { "slime", "ribbon_pig", "junior_balrog" }
		local slots = { 3, 13, 1 }
		for ownerSide = 1, 2 do
			local targetInstanceId = "P2C3A_" .. tostring(ownerSide) .. "_TARGET"
			for index = 1, 3 do
				local monster = data:GetMonsterById(ids[index])
				local position = self:GetSlotWorldPosition(ownerSide, slots[index])
				if monster == nil or position == nil then
					return false
				end
				self:SpawnPlacement(
					{
						Order = index,
						CardIndex = monster.CardIndex,
						MonsterId = monster.MonsterId,
						CardInstanceId = index == 1
							and targetInstanceId
							or ("P2C3A_" .. tostring(ownerSide) .. "_" .. tostring(index)),
						Cost = monster.Cost,
						SlotIndex = slots[index],
						Position = position,
						OwnerUserId = "Phase2C3ARegression",
						OwnerSide = ownerSide,
						EffectTargetInstanceId = index == 2 and targetInstanceId or "",
						EffectDestinationSlotIndex = index == 2 and 8 or 0,
						RevealEffectResolved = false
					}
				)
			end
		end

		local resolved = self:ResolveRevealEffects()
		local playerTarget = combat:GetUnitById(1)
		local enemyTarget = combat:GetUnitById(4)
		local playerSlot = self:GetSlotWorldPosition(1, 8)
		local enemySlot = self:GetSlotWorldPosition(2, 8)
		local slimeData = data:GetMonsterById("slime")
		if not resolved
			or playerTarget == nil or enemyTarget == nil
			or playerSlot == nil or enemySlot == nil
			or slimeData == nil then
			return false
		end

		local playerWorld = playerTarget.Entity.TransformComponent.WorldPosition
		local enemyWorld = enemyTarget.Entity.TransformComponent.WorldPosition
		local passed = #combat.Units == 6
			and combat.SimTick == 0 and not combat.IsRunning
			and playerTarget.SlotIndex == 8 and playerTarget.LaneIndex == 2
			and enemyTarget.SlotIndex == 8 and enemyTarget.LaneIndex == 2
			and math.abs(playerTarget.SimX - playerSlot.x) <= 0.000001
			and math.abs(enemyTarget.SimX - enemySlot.x) <= 0.000001
			and math.abs(playerTarget.CombatStartX - playerSlot.x) <= 0.000001
			and math.abs(playerTarget.CombatStartY - playerSlot.y) <= 0.000001
			and math.abs(enemyTarget.CombatStartX - enemySlot.x) <= 0.000001
			and math.abs(enemyTarget.CombatStartY - enemySlot.y) <= 0.000001
			and math.abs(playerWorld.x - playerSlot.x) <= 0.000001
			and math.abs(playerWorld.y - playerSlot.y) <= 0.000001
			and math.abs(enemyWorld.x - enemySlot.x) <= 0.000001
			and math.abs(enemyWorld.y - enemySlot.y) <= 0.000001
			and playerTarget.Attack == playerTarget.BaseAttack + 30
			and enemyTarget.Attack == enemyTarget.BaseAttack + 30
			and playerTarget.CombatAttackBonus == 30
			and enemyTarget.CombatAttackBonus == 30
			and slimeData.Attack == playerTarget.BaseAttack
			and playerTarget.NexusDamage == slimeData.NexusDamage
			and enemyTarget.NexusDamage == slimeData.NexusDamage

		log(
			"[Phase2C3A][ActualSpawn] Units="
			.. tostring(#combat.Units)
			.. ", PlayerSlot="
			.. tostring(playerTarget.SlotIndex)
			.. ", EnemySlot="
			.. tostring(enemyTarget.SlotIndex)
			.. ", Attack="
			.. tostring(playerTarget.BaseAttack)
			.. "->"
			.. tostring(playerTarget.Attack)
			.. ", Tick="
			.. tostring(combat.SimTick)
		)
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C3BActualSpawnRegression()
		-- 실제 ThreeLaneUnit 5기를 소환해 데이터 전달과 집중·분산 추가타를 정상 Combat Tick으로 검증한다.
		local combat = self:GetCombat()
		local data = self:GetData()
		if not isvalid(combat) or not isvalid(data) then
			return false
		end
		combat.MakerHarnessRunning = true
		self:ResetBattle()
		combat.MakerHarnessRunning = true
		combat.MakerTestMode = true
		combat.CurrentScenario = "Phase2C3BActualSpawn"
		self.BattleState = "Playing"
		self.Phase = "Battle"
		self.PlayerNexusHp = 30
		self.EnemyNexusHp = 30
		self.CurrentCost = 1
		self.EnemyCurrentCost = 1

		local green = self:SpawnPhase2C3BActualUnit("green_mushroom", 1, 1, Vector3(-0.3, 1.5, 0), 1)
		local greenTarget = self:SpawnPhase2C3BActualUnit("drake", 2, 1, Vector3(0.3, 1.5, 0), 1)
		local pink = self:SpawnPhase2C3BActualUnit("pink_bean", 1, 6, Vector3(-0.3, 0, 0), 2)
		local pinkPrimary = self:SpawnPhase2C3BActualUnit("drake", 2, 6, Vector3(0.3, 0, 0), 2)
		local pinkSecondary = self:SpawnPhase2C3BActualUnit("drake", 2, 11, Vector3(5.0, -1.5, 0), 3)
		if green == nil or greenTarget == nil or pink == nil
			or pinkPrimary == nil or pinkSecondary == nil then
			return false
		end

		green.MoveSpeed = 0
		pink.MoveSpeed = 0
		combat:ConfigurePhase2C3BPassiveTarget(greenTarget, 1000)
		combat:ConfigurePhase2C3BPassiveTarget(pinkPrimary, 1000)
		combat:ConfigurePhase2C3BPassiveTarget(pinkSecondary, 1000)
		combat.SimAccumulator = 0
		combat.SimTick = 0
		combat.ActiveBattleLimitTicks = combat.BattleTimeLimitTicks
		combat.SimulationSpeed = 1
		combat.IsRunning = true
		combat:RunPhase2C3BTicks(19)

		local passed = combat.SimTick == 19
			and green.SecondaryTargetLane == "Top"
			and math.abs(green.SecondaryDamageRate - 0.5) <= 0.000001
			and pink.SecondaryTargetLane == "Bottom"
			and math.abs(pink.SecondaryDamageRate - 0.5) <= 0.000001
			and greenTarget.HP == 865
			and pinkPrimary.HP == 820
			and pinkSecondary.HP == 910
			and #green.DamageIntentHistory == 2
			and #pink.DamageIntentHistory == 2
			and green.DamageIntentHistory[1].IntentKind == "Primary"
			and green.DamageIntentHistory[1].Damage == 90
			and green.DamageIntentHistory[2].IntentKind == "Secondary"
			and green.DamageIntentHistory[2].Damage == 45
			and pink.DamageIntentHistory[1].IntentKind == "Primary"
			and pink.DamageIntentHistory[1].Damage == 180
			and pink.DamageIntentHistory[2].IntentKind == "Secondary"
			and pink.DamageIntentHistory[2].Damage == 90

		log(
			"[Phase2C3B][ActualSpawn] Tick="
			.. tostring(combat.SimTick)
			.. ", Green="
			.. green.SecondaryTargetLane
			.. "/"
			.. tostring(green.SecondaryDamageRate)
			.. ", GreenTargetHP="
			.. tostring(greenTarget.HP)
			.. ", Pink="
			.. pink.SecondaryTargetLane
			.. "/"
			.. tostring(pink.SecondaryDamageRate)
			.. ", PinkTargetsHP="
			.. tostring(pinkPrimary.HP)
			.. "/"
			.. tostring(pinkSecondary.HP)
		)
		return passed
	end

	@ExecSpace("ServerOnly")
	method any SpawnPhase2C3BActualUnit(
		string monsterId,
		integer ownerSide,
		integer slotIndex,
		Vector3 position,
		integer placementOrder
	)
		-- 실제 SpawnPlacement 데이터 경로를 공유하고 새로 등록된 ThreeLaneUnit을 반환한다.
		local combat = self:GetCombat()
		local monster = self:GetMonsterById(monsterId)
		if not isvalid(combat) or monster == nil then
			return nil
		end
		local beforeCount = #combat.Units
		self:SpawnPlacement(
			{
				Order = placementOrder,
				CardIndex = monster.CardIndex,
				MonsterId = monster.MonsterId,
				Cost = monster.Cost,
				SlotIndex = slotIndex,
				Position = position,
				OwnerUserId = "Phase2C3BRegression",
				OwnerSide = ownerSide
			}
		)
		return combat.Units[beforeCount + 1]
	end

	@ExecSpace("ServerOnly")
	method boolean RecordPhase2C3ARegression(string name, boolean passed)
		-- Phase 2C-3A 항목별 결과를 독립 로그 접두사로 기록한다.
		if passed then
			log("[Phase2C3A][TEST][" .. name .. "] PASS")
		else
			log_error("[Phase2C3A][TEST][" .. name .. "] FAIL")
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean IsSpawnDataMatch(any unit, any monster)
		-- 실제 ThreeLaneUnit에 전달된 모든 Phase 2C-2 필드를 원본 행과 비교한다.
		if unit == nil or not isvalid(unit) or monster == nil then
			return false
		end
		return unit.MonsterId == monster.MonsterId
			and unit.CardIndex == monster.CardIndex
			and unit.Cost == monster.Cost
			and unit.HP == monster.HP
			and unit.MaxHP == monster.HP
			and unit.Attack == monster.Attack
			and unit.AttackIntervalTicks == monster.AttackIntervalTicks
			and unit.FirstAttackDelayTicks == monster.FirstAttackDelayTicks
			and math.abs(unit.MoveSpeed - monster.MoveSpeed) <= 0.000001
			and unit.RangeClass == monster.RangeClass
			and math.abs(unit.AttackRange - monster.AttackRange) <= 0.000001
			and unit.NexusDamage == monster.NexusDamage
			and unit.SecondaryTargetLane == monster.SecondaryTargetLane
			and math.abs(unit.SecondaryDamageRate - monster.SecondaryDamageRate) <= 0.000001
	end

	@ExecSpace("ServerOnly")
	method boolean RecordPhase2C2Regression(string name, boolean passed)
		-- Phase 2C-2 데이터 항목별 결과를 독립 로그 접두사로 기록한다.
		if passed then
			log("[Phase2C2][DATA][" .. name .. "] PASS")
		else
			log_error("[Phase2C2][DATA][" .. name .. "] FAIL")
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method void ClearSlots()
		-- 표시를 초기화하되 영구 점유는 RefreshPlayerSlotOccupancy에서 즉시 다시 표시한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return
		end

		for index = 1, 15 do
			local slotEntity = map:GetChildByName("PlayerSlot_" .. tostring(index))
			if isvalid(slotEntity) then
				---@type ThreeLaneSlot
				local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
				if isvalid(slot) then
					slot:ResetSlot()
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshPlayerSlotOccupancy()
		-- 플레이어의 영구 설치와 현재 예약 슬롯을 합쳐 서버 점유·표시를 갱신한다.
		self:ClearSlots()
		local occupied = {}
		local state = self.PlayerCardState
		if state ~= nil and state.Installed ~= nil then
			for _, instanceId in ipairs(state.Installed) do
				local instance = state.InstanceById[instanceId]
				if instance ~= nil then
					occupied[instance.PermanentSlotIndex] = true
				end
			end
		end
		for _, command in ipairs(self.PendingPlacements) do
			occupied[command.SlotIndex] = true
		end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return
		end
		for slotIndex, isOccupied in pairs(occupied) do
			if isOccupied and slotIndex >= 1 and slotIndex <= 15 then
				local slotEntity = map:GetChildByName("PlayerSlot_" .. tostring(slotIndex))
				if isvalid(slotEntity) then
					---@type ThreeLaneSlot
					local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
					if isvalid(slot) then
						slot.IsOccupied = true
						if isvalid(slotEntity.SpriteRendererComponent) then
							slotEntity.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.6)
						end
					end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshUsedCardMask()
		-- 2C-4B 전 호환 HUD에는 현재 손패에 해당 카드 복사본이 없음을 7자리 마스크로 표시한다.
		local mask = ""
		for index = 1, 7 do
			if self:FindHandInstanceByCardIndex(1, index) == "" then
				mask = mask .. "1"
			else
				mask = mask .. "0"
			end
		end

		self.UsedCardMask = mask
	end

	@ExecSpace("ServerOnly")
	method boolean Phase2C4BHandContains(table state, string instanceId)
		if state == nil or state.Hand == nil then
			return false
		end
		for _, currentId in ipairs(state.Hand) do
			if currentId == instanceId then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C4BMulliganChoiceScenario(boolean replaceAll, integer seed)
		-- Keep/ReplaceAll 양자 선택, 전면 교체 시 즉시 재등장 금지, 첫 턴 손패 5장을 검증한다.
		self.AutoConfirmRerollWithoutUI = false
		if not self:InitializeMatchCardStates(seed, seed + 5000) then
			return false
		end
		if self.Phase ~= "Mulligan" or #self.PlayerCardState.Hand ~= 4 then
			return false
		end

		local initialIds = {}
		for index, instanceId in ipairs(self.PlayerCardState.Hand) do
			initialIds[index] = instanceId
		end
		local choice = replaceAll and "ReplaceAll" or "Keep"
		if not self:ConfirmInitialMulliganChoice(1, choice) then
			return false
		end
		if self:ConfirmInitialMulliganChoice(1, choice) then
			return false
		end
		if #self.PlayerCardState.Hand ~= 4 then
			return false
		end
		for index, instanceId in ipairs(initialIds) do
			local remains = self:Phase2C4BHandContains(self.PlayerCardState, instanceId)
			if replaceAll and remains then
				return false
			end
			if not replaceAll and self.PlayerCardState.Hand[index] ~= instanceId then
				return false
			end
		end

		self.PlayerMulliganReady = true
		self.EnemyMulliganReady = true
		self:TryFinishInitialMulligan()
		return self.Phase == "Placement"
			and #self.PlayerCardState.Hand == 5
			and self.PlayerHandCount == 5
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C4BPartialSelectionRejected(integer seed)
		-- 구형 CardInstanceId/CSV 입력은 상태를 바꾸지 않고 거부되어야 한다.
		self.AutoConfirmRerollWithoutUI = false
		if not self:InitializeMatchCardStates(seed, seed + 5000) then
			return false
		end
		local initialIds = {}
		for index, instanceId in ipairs(self.PlayerCardState.Hand) do
			initialIds[index] = instanceId
		end
		local oldPartialChoice = initialIds[1] .. "," .. initialIds[2]
		if self:ConfirmInitialMulliganChoice(1, oldPartialChoice) then
			return false
		end
		if self.PlayerCardState.RerollUsed or #self.PlayerCardState.Hand ~= 4 then
			return false
		end
		for index, instanceId in ipairs(initialIds) do
			if self.PlayerCardState.Hand[index] ~= instanceId then
				return false
			end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C4BTests()
		-- Maker 전용 진입점. 실제 UI 클릭과 배치는 별도 Play 검증으로 남기고 서버 불변식만 결정론적으로 확인한다.
		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[Phase2C4B][TEST] Combat unavailable")
			return false
		end

		local savedOwnerUserId = self.PlayerOwnerUserId
		local savedMakerHarnessRunning = combat.MakerHarnessRunning
		self.PlayerOwnerUserId = ""
		-- 4B는 Mulligan 대기 자체를 검증하므로 구형 회귀용 자동 리롤 우회는 끈다.
		combat.MakerHarnessRunning = false
		self.UseFixedMatchSeed = true
		local allPassed = true

		self.AutoConfirmRerollWithoutUI = false
		self:InitializeMatchCardStates(4401, 9401)
		local firstId = self.PlayerCardState.Hand[1]
		local placementBlocked = self.Phase == "Mulligan"
			and self.PlayerMulliganReady == false
			and self.EnemyMulliganReady == true
			and self:TryReserveCardInstance(1, 1, firstId, "Maker4B") == false
		if placementBlocked then
			log("[Phase2C4B][TEST][PlacementBeforeMulligan] PASS")
		else
			log_error("[Phase2C4B][TEST][PlacementBeforeMulligan] FAIL")
			allPassed = false
		end

		local keepPassed = self:RunPhase2C4BMulliganChoiceScenario(false, 4500)
		if keepPassed then
			log("[Phase2C4B][TEST][KeepInitialFour] PASS")
		else
			log_error("[Phase2C4B][TEST][KeepInitialFour] FAIL")
			allPassed = false
		end

		local replacePassed = self:RunPhase2C4BMulliganChoiceScenario(true, 4501)
		if replacePassed then
			log("[Phase2C4B][TEST][ReplaceAllFourNoImmediateReturn] PASS")
		else
			log_error("[Phase2C4B][TEST][ReplaceAllFourNoImmediateReturn] FAIL")
			allPassed = false
		end

		local partialRejected = self:RunPhase2C4BPartialSelectionRejected(4502)
		if partialRejected then
			log("[Phase2C4B][TEST][PartialSelectionRejected] PASS")
		else
			log_error("[Phase2C4B][TEST][PartialSelectionRejected] FAIL")
			allPassed = false
		end

		self:InitializeMatchCardStates(4503, 9503)
		local firstAccepted = self:ConfirmInitialMulliganChoice(1, "Keep")
		local secondRejected = not self:ConfirmInitialMulliganChoice(1, "ReplaceAll")
		if firstAccepted and secondRejected then
			log("[Phase2C4B][TEST][SecondMulliganRejected] PASS")
		else
			log_error("[Phase2C4B][TEST][SecondMulliganRejected] FAIL")
			allPassed = false
		end

		local orange = self:GetMonsterByCardIndex(8)
		local orangePassed = orange ~= nil
			and orange.MonsterId == "orange_mushroom"
			and orange.Cost == 1
			and self:GetData():GetCardImageRuid("orange_mushroom") ~= ""
		if orangePassed then
			log("[Phase2C4B][TEST][OrangeCard8] PASS")
		else
			log_error("[Phase2C4B][TEST][OrangeCard8] FAIL")
			allPassed = false
		end

		self.UseFixedMatchSeed = false
		self.AutoConfirmRerollWithoutUI = false
		combat.MakerHarnessRunning = savedMakerHarnessRunning
		self.PlayerOwnerUserId = savedOwnerUserId
		self:ResetBattle()
		if allPassed then
			log("[Phase2C4B][TEST][ALL] PASS - normal play state restored")
		else
			log_error("[Phase2C4B][TEST][ALL] FAIL - see scenario logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method boolean RecordPhase2C5Regression(string name, boolean passed)
		if passed then
			log("[Phase2C5][TEST][" .. name .. "] PASS")
		else
			log_error("[Phase2C5][TEST][" .. name .. "] FAIL")
		end
		return passed
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C5RibbonScenario(string scenarioName)
		if not self:PreparePhase2C4ATestState(5200, 10200) then
			return false
		end
		self.PlayerOwnerUserId = ""

		if scenarioName == "OneCandidate" then
			local ids = self:ForceTestHand(1, { "slime", "ribbon_pig" })
			if #ids ~= 2 or not self:InstallCardForTest(1, ids[1], 1, 1) then return false end
			if not self:TryReserveCardInstance(1, 15, ids[2], "MakerC5") then return false end
			local command = self.PendingPlacements[1]
			local candidates = self:BuildRibbonEffectCandidates(1, command)
			self:RequestConfirmPlacement()
			local confirmBlocked = self.Phase == "Placement" and self:HasUnresolvedRibbonSelection(1)
			return #candidates == 1
				and candidates[1].InstanceId == ids[1]
				and confirmBlocked
				and self:TrySelectRibbonEffectTarget(1, ids[2], ids[1])
				and command.EffectSelectionState == "Selected"
				and command.EffectDestinationSlotIndex == 6
		end

		if scenarioName == "MultipleCandidates" then
			local ids = self:ForceTestHand(
				1,
				{ "slime", "orange_mushroom", "ribbon_pig", "green_mushroom" }
			)
			if #ids ~= 4 then return false end
			if not self:InstallCardForTest(1, ids[1], 1, 1) then return false end
			if not self:InstallCardForTest(1, ids[2], 7, 2) then return false end
			if not self:TryReserveCardInstance(1, 15, ids[3], "MakerC5") then return false end
			local command = self.PendingPlacements[1]
			local candidates = self:BuildRibbonEffectCandidates(1, command)
			local selected = self:TrySelectRibbonEffectTarget(1, ids[3], ids[1])
			local destinationBlocked = not self:TryReserveCardInstance(1, 6, ids[4], "MakerC5")
			return #candidates == 2
				and candidates[1].InstanceId == ids[2]
				and candidates[2].InstanceId == ids[1]
				and selected
				and command.EffectTargetInstanceId == ids[1]
				and command.EffectDestinationSlotIndex == 6
				and destinationBlocked
		end

		if scenarioName == "NoCandidate" then
			local ids = self:ForceTestHand(1, { "ribbon_pig" })
			if #ids ~= 1 or not self:TryReserveCardInstance(1, 15, ids[1], "MakerC5") then return false end
			local command = self.PendingPlacements[1]
			return command.EffectSelectionState == "NoTarget"
				and command.EffectTargetInstanceId == ""
				and not self:HasUnresolvedRibbonSelection(1)
		end

		if scenarioName == "BlockedDestination" then
			local ids = self:ForceTestHand(
				1,
				{ "slime", "orange_mushroom", "green_mushroom", "ribbon_pig" }
			)
			if #ids ~= 4 then return false end
			if not self:InstallCardForTest(1, ids[1], 1, 1) then return false end
			if not self:InstallCardForTest(1, ids[2], 6, 2) then return false end
			if not self:InstallCardForTest(1, ids[3], 11, 3) then return false end
			if not self:TryReserveCardInstance(1, 15, ids[4], "MakerC5") then return false end
			local command = self.PendingPlacements[1]
			return #self:BuildRibbonEffectCandidates(1, command) == 0
				and command.EffectSelectionState == "NoTarget"
		end

		if scenarioName == "TargetUndo" then
			local ids = self:ForceTestHand(1, { "slime", "ribbon_pig" })
			if #ids ~= 2 then return false end
			if not self:TryReserveCardInstance(1, 1, ids[1], "MakerC5") then return false end
			if not self:TryReserveCardInstance(1, 15, ids[2], "MakerC5") then return false end
			if not self:TrySelectRibbonEffectTarget(1, ids[2], ids[1]) then return false end
			self:CancelPlacementAt(1, "MakerC5", "Phase2C5TargetUndo")
			local command = self.PendingPlacements[1]
			local blocked = command ~= nil
				and command.CardInstanceId == ids[2]
				and command.EffectSelectionState == "Selecting"
				and self:HasUnresolvedRibbonSelection(1)
			if blocked then
				self:CancelPlacementAt(1, "MakerC5", "Phase2C5RibbonCancel")
			end
			local state = self:GetCardState(1)
			return blocked
				and #self.PendingPlacements == 0
				and state.InstanceById[ids[2]].State == "Hand"
				and self.CurrentCost == 10
		end

		if scenarioName == "SelectedReveal" then
			local ids = self:ForceTestHand(1, { "slime", "ribbon_pig" })
			if #ids ~= 2 or not self:InstallCardForTest(1, ids[1], 1, 1) then return false end
			if not self:TryReserveCardInstance(1, 15, ids[2], "MakerC5") then return false end
			if not self:TrySelectRibbonEffectTarget(1, ids[2], ids[1]) then return false end
			self:CommitPendingPlacements(1)
			self:SpawnInstalledCards(1)
			if not self:ResolveRevealEffects() then return false end
			local target = self:FindActiveUnitByInstanceId(ids[1])
			local source = self:FindActiveUnitByInstanceId(ids[2])
			local state = self:GetCardState(1)
			return target ~= nil and isvalid(target)
				and source ~= nil and isvalid(source)
				and target.SlotIndex == 6
				and target.LaneIndex == 2
				and state.InstanceById[ids[1]].PermanentSlotIndex == 6
				and source.RevealEffectResolved == true
				and self:GetCombat().SimTick == 0
		end

		return false
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C5PresentationRegression()
		if not self:PreparePhase2C4ATestState(5290, 10290) then
			return false
		end
		local combat = self:GetCombat()
		self:SpawnPlacement({
			Order = 1, CardIndex = 8, MonsterId = "orange_mushroom",
			CardInstanceId = "C5_VIS_ORANGE", SlotIndex = 1,
			Position = self:GetSlotWorldPosition(1, 1), OwnerSide = 1, OwnerUserId = "",
			EffectTargetInstanceId = "", EffectDestinationSlotIndex = 0, RevealEffectResolved = false
		})
		self:SpawnPlacement({
			Order = 2, CardIndex = 3, MonsterId = "green_mushroom",
			CardInstanceId = "C5_VIS_GREEN", SlotIndex = 7,
			Position = self:GetSlotWorldPosition(2, 7), OwnerSide = 2, OwnerUserId = "",
			EffectTargetInstanceId = "", EffectDestinationSlotIndex = 0, RevealEffectResolved = false
		})
		self:SpawnPlacement({
			Order = 3, CardIndex = 5, MonsterId = "yeti",
			CardInstanceId = "C5_VIS_YETI", SlotIndex = 13,
			Position = self:GetSlotWorldPosition(1, 13), OwnerSide = 1, OwnerUserId = "",
			EffectTargetInstanceId = "", EffectDestinationSlotIndex = 0, RevealEffectResolved = false
		})
		local orange = self:FindActiveUnitByInstanceId("C5_VIS_ORANGE")
		local green = self:FindActiveUnitByInstanceId("C5_VIS_GREEN")
		local yeti = self:FindActiveUnitByInstanceId("C5_VIS_YETI")
		if orange == nil or green == nil or yeti == nil
			or not isvalid(orange) or not isvalid(green) or not isvalid(yeti) then
			return false
		end
		local orangeProfile = self:GetData():GetCombatVisualProfile("orange_mushroom")
		local greenProfile = self:GetData():GetCombatVisualProfile("green_mushroom")
		local yetiProfile = self:GetData():GetCombatVisualProfile("yeti")
		local profilePassed = orangeProfile ~= nil and greenProfile ~= nil and yetiProfile ~= nil
			and orange.HasCombatVisualProfile and green.HasCombatVisualProfile and yeti.HasCombatVisualProfile
			and orange.Entity.SpriteRendererComponent.SpriteRUID == orangeProfile.IdleRuid
			and green.Entity.SpriteRendererComponent.SpriteRUID == greenProfile.IdleRuid
			and yeti.Entity.SpriteRendererComponent.SpriteRUID == yetiProfile.IdleRuid
			and orange.Entity.SpriteRendererComponent.FlipX == true
			and green.Entity.SpriteRendererComponent.FlipX == false

		orange:RefreshLocomotionVisual(1, true, 1)
		local movePassed = orange.VisualState == "Move"
			and orange.Entity.SpriteRendererComponent.SpriteRUID == orangeProfile.MoveRuid
		orange:PlayAttackVisual(2, 1)
		local attackPassed = orange.VisualState == "Attack"
			and orange.Entity.SpriteRendererComponent.SpriteRUID == orangeProfile.AttackRuid
		orange:PlayHitVisual(3, 1)
		local hitPassed = orange.VisualState == "Hit"
			and orange.Entity.SpriteRendererComponent.SpriteRUID == orangeProfile.HitRuid
		yeti:PlayNexusFinalVisual(4, 1)
		local nexusPassed = yeti.VisualState == "Nexus"
			and yeti.Entity.SpriteRendererComponent.SpriteRUID == yetiProfile.NexusRuid
		green:PlayDeathVisual(5, 1)
		local greenBar = green.Entity:GetChildByName("HealthBarBack")
		local deathPassed = green.VisualState == "Die"
			and green.Entity.SpriteRendererComponent.SpriteRUID == greenProfile.DieRuid
			and isvalid(greenBar) and greenBar.Enable == false

		local fill = orange.Entity:GetChildByName("HealthBarFill")
		local back = orange.Entity:GetChildByName("HealthBarBack")
		orange.HP = orange.MaxHP / 2
		orange:UpdateHealthBarVisual()
		local halfWidth = orange.HealthBarWidthScale * 0.5
		local damageBarPassed = isvalid(fill) and isvalid(back)
			and math.abs(fill.TransformComponent.Scale.x - halfWidth) <= 0.0001
		orange.HP = orange.MaxHP
		orange:ResetCombatState()
		local respawnBarPassed = back.Enable == true and fill.Enable == true
			and math.abs(fill.TransformComponent.Scale.x - orange.HealthBarWidthScale) <= 0.0001

		combat:SetSimulationSpeed(2)
		local speed2Passed = orange.VisualPlaybackSpeed == 2
			and green.VisualPlaybackSpeed == 2
			and yeti.VisualPlaybackSpeed == 2
			and orange.Entity.SpriteRendererComponent.PlayRate == 2
		combat:SetSimulationSpeed(1)
		local speed1Passed = orange.VisualPlaybackSpeed == 1
			and green.VisualPlaybackSpeed == 1
			and yeti.VisualPlaybackSpeed == 1
			and orange.Entity.SpriteRendererComponent.PlayRate == 1

		return profilePassed and movePassed and attackPassed and hitPassed
			and nexusPassed and deathPassed and damageBarPassed and respawnBarPassed
			and speed2Passed and speed1Passed
	end

	@ExecSpace("ServerOnly")
	method boolean RunPhase2C5ExpandedPresentationRegression()
		-- 3종 세로 슬라이스 통과 뒤 기본 8종 모두 같은 표현 상태·체력바 계약을 쓰는지 실제 엔티티로 확인한다.
		if not self:PreparePhase2C4ATestState(5291, 10291) then
			return false
		end
		local combat = self:GetCombat()
		local data = self:GetData()
		local entries = {
			{ MonsterId = "slime", Side = 1, Slot = 1 },
			{ MonsterId = "ribbon_pig", Side = 2, Slot = 2 },
			{ MonsterId = "orange_mushroom", Side = 1, Slot = 3 },
			{ MonsterId = "green_mushroom", Side = 2, Slot = 4 },
			{ MonsterId = "stone_golem", Side = 1, Slot = 6 },
			{ MonsterId = "yeti", Side = 2, Slot = 7 },
			{ MonsterId = "junior_balrog", Side = 1, Slot = 8 },
			{ MonsterId = "pink_bean", Side = 2, Slot = 9 }
		}

		for index, entry in ipairs(entries) do
			local monster = data:GetMonsterById(entry.MonsterId)
			local position = self:GetSlotWorldPosition(entry.Side, entry.Slot)
			if monster == nil or position == nil then return false end
			self:SpawnPlacement({
				Order = index,
				CardIndex = monster.CardIndex,
				MonsterId = entry.MonsterId,
				CardInstanceId = "C5_VIS8_" .. entry.MonsterId,
				SlotIndex = entry.Slot,
				Position = position,
				OwnerSide = entry.Side,
				OwnerUserId = "",
				EffectTargetInstanceId = "",
				EffectDestinationSlotIndex = 0,
				RevealEffectResolved = false
			})
		end

		local allPassed = #combat.Units == 8
		for _, entry in ipairs(entries) do
			local instanceId = "C5_VIS8_" .. entry.MonsterId
			local unit = self:FindActiveUnitByInstanceId(instanceId)
			local profile = data:GetCombatVisualProfile(entry.MonsterId)
			local passed = unit ~= nil and isvalid(unit) and profile ~= nil
			if passed then
				local back = unit.Entity:GetChildByName("HealthBarBack")
				local fill = unit.Entity:GetChildByName("HealthBarFill")
				passed = unit.HasCombatVisualProfile
					and unit.Entity.SpriteRendererComponent.SpriteRUID == profile.IdleRuid
					and unit.Entity.SpriteRendererComponent.FlipX == (entry.Side == 1)
					and isvalid(back) and isvalid(fill)
				unit:RefreshLocomotionVisual(100, true, 1)
				passed = passed and unit.VisualState == "Move"
					and unit.Entity.SpriteRendererComponent.SpriteRUID == profile.MoveRuid
				unit:PlayAttackVisual(120, 1)
				passed = passed and unit.VisualState == "Attack"
					and unit.Entity.SpriteRendererComponent.SpriteRUID == profile.AttackRuid
				unit:PlayHitVisual(140, 1)
				passed = passed and unit.VisualState == "Hit"
					and unit.Entity.SpriteRendererComponent.SpriteRUID == profile.HitRuid
				unit:PlayNexusFinalVisual(160, 1)
				passed = passed and unit.VisualState == "Nexus"
					and unit.Entity.SpriteRendererComponent.SpriteRUID == profile.NexusRuid
				unit:PlayDeathVisual(180, 1)
				passed = passed and unit.VisualState == "Die"
					and unit.Entity.SpriteRendererComponent.SpriteRUID == profile.DieRuid
					and back.Enable == false and fill.Enable == false
				unit.HP = unit.MaxHP
				unit:ResetCombatState()
				passed = passed and unit.VisualState == "Idle"
					and back.Enable == true and fill.Enable == true
					and math.abs(fill.TransformComponent.Scale.x - unit.HealthBarWidthScale) <= 0.0001
			end
			allPassed = self:RecordPhase2C5Regression(
				"Visual8_" .. entry.MonsterId,
				passed
			) and allPassed
		end

		combat:SetSimulationSpeed(2)
		for _, entry in ipairs(entries) do
			local unit = self:FindActiveUnitByInstanceId("C5_VIS8_" .. entry.MonsterId)
			allPassed = unit ~= nil and isvalid(unit)
				and unit.VisualPlaybackSpeed == 2
				and unit.Entity.SpriteRendererComponent.PlayRate == 2
				and allPassed
		end
		combat:SetSimulationSpeed(1)
		for _, entry in ipairs(entries) do
			local unit = self:FindActiveUnitByInstanceId("C5_VIS8_" .. entry.MonsterId)
			allPassed = unit ~= nil and isvalid(unit)
				and unit.VisualPlaybackSpeed == 1
				and unit.Entity.SpriteRendererComponent.PlayRate == 1
				and allPassed
		end
		return self:RecordPhase2C5Regression("Visual8SpeedRate", allPassed)
	end

	@ExecSpace("ServerOnly")
	method boolean RunMakerPhase2C5Tests()
		local combat = self:GetCombat()
		if not isvalid(combat) then
			log_error("[Phase2C5][TEST][ALL] FAIL - combat missing")
			return false
		end
		local savedOwnerUserId = self.PlayerOwnerUserId
		local allPassed = true
		local scenarios = {
			"OneCandidate", "MultipleCandidates", "NoCandidate",
			"BlockedDestination", "TargetUndo", "SelectedReveal"
		}
		for _, scenarioName in ipairs(scenarios) do
			allPassed = self:RecordPhase2C5Regression(
				"Ribbon" .. scenarioName,
				self:RunPhase2C5RibbonScenario(scenarioName)
			) and allPassed
		end
		allPassed = self:RecordPhase2C5Regression(
			"PresentationVerticalSlice",
			self:RunPhase2C5PresentationRegression()
		) and allPassed
		allPassed = self:RecordPhase2C5Regression(
			"PresentationExpandedEight",
			self:RunPhase2C5ExpandedPresentationRegression()
		) and allPassed
		self:KillActiveUnits()
		combat:ResetSimulation(false)
		combat.MakerHarnessRunning = false
		self.PlayerOwnerUserId = savedOwnerUserId
		self.UseFixedMatchSeed = false
		self.AutoConfirmRerollWithoutUI = false
		self:ResetBattle()
		if allPassed then
			log("[Phase2C5][TEST][ALL] PASS - normal play state restored")
		else
			log_error("[Phase2C5][TEST][ALL] FAIL - see scenario logs")
		end
		return allPassed
	end

	@ExecSpace("ServerOnly")
	method integer GetCardCost(integer cardIndex)
		-- 카드 번호의 MonsterData Cost를 반환한다. 범위를 벗어나거나 데이터가 없으면 0이다.
		if cardIndex < 1 or cardIndex > 8 then
			return 0
		end
		local monster = self:GetMonsterByCardIndex(cardIndex)
		if monster == nil then
			return 0
		end
		return monster.Cost
	end

end
