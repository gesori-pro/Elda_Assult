@Component
script ThreeLaneSlot extends Component

	property integer SlotIndex = 1

	@Sync
	property boolean IsOccupied = false

	property string OccupancyState = "Empty"

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleTouchEvent(TouchEvent event)
		-- 빈 슬롯은 배치 경로로, 예약된 슬롯은 취소 대상 선택 경로로 보낸다.
		local hudEntity = _EntityService:GetEntityByPath("/ui/ThreeLaneHUD/Controller")
		if not isvalid(hudEntity) then
			log_error("[ThreeLaneSlot] ThreeLaneHUD Controller not found")
			return
		end

		---@type ThreeLaneHUD
		local hud = hudEntity:GetComponent("script.ThreeLaneHUD")
		if not isvalid(hud) then
			log_error("[ThreeLaneSlot] ThreeLaneHUD component not found")
			return
		end

		if self.IsOccupied then
			if self.OccupancyState == "Permanent" then
				hud:SetCardHint("영구 설치된 슬롯입니다. 다음 턴에도 이 위치에서 재출전합니다.")
				return
			end
			hud:SelectReservedSlot(self.Entity)
			return
		end

		hud:RequestSelectedCardToSlot(self.Entity)
	end

	@ExecSpace("Server")
	method void RequestPlaceUnit(integer cardIndex)
		-- 서버에서 슬롯 점유와 페이즈를 다시 검증한 뒤 배치 명령을 보드에 기록한다.
		if cardIndex < 1 or cardIndex > 8 then
			log("[ThreeLaneSlot] Invalid card index: " .. tostring(cardIndex))
			return
		end

		if self.IsOccupied then
			log("[ThreeLaneSlot] Slot already used: " .. tostring(self.SlotIndex))
			return
		end

		local boardEntity = self.Entity.CurrentMap:GetChildByName("PrototypeBoard")
		if not isvalid(boardEntity) then
			log_error("[ThreeLaneSlot] PrototypeBoard not found")
			return
		end

		---@type ThreeLaneBoard
		local board = boardEntity:GetComponent("script.ThreeLaneBoard")
		if not isvalid(board) then
			log_error("[ThreeLaneSlot] ThreeLaneBoard component not found")
			return
		end

		if board.Phase ~= "Placement" then
			log(
				"[ThreeLaneSlot] Slot request ignored - phase is "
					.. board.Phase
					.. ", Slot="
					.. tostring(self.SlotIndex)
			)
			return
		end

		local spawnPosition = self.Entity.TransformComponent.WorldPosition
		local accepted = board:TryPlaceCardForOwner(
			self.SlotIndex,
			spawnPosition,
			cardIndex,
			senderUserId
		)

		if accepted then
			self.IsOccupied = true
			self.OccupancyState = "Reserved"
			if isvalid(self.Entity.SpriteRendererComponent) then
				self.Entity.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.6)
			end
			log(
				"[ThreeLaneSlot] Slot reserved: "
					.. tostring(self.SlotIndex)
					.. ", Card="
					.. tostring(cardIndex)
			)
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetSlot()
		-- 턴 정산과 재시작 시 슬롯 점유와 기본 파란색을 복구한다.
		self.IsOccupied = false
		self.OccupancyState = "Empty"
		if isvalid(self.Entity.SpriteRendererComponent) then
			self.Entity.SpriteRendererComponent.Color = Color(0.25, 0.65, 1.0, 0.85)
		end
	end

end
