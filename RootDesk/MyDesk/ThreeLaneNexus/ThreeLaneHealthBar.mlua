@Component
script ThreeLaneHealthBar extends Component

	property string BarRole = "Back"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- PixelRenderer 초기화는 ClientOnly이며 전투 HP 판정과 완전히 분리한다.
		local pixel = self.Entity.PixelRendererComponent
		if not isvalid(pixel) then
			return
		end
		if self.BarRole == "Fill" then
			pixel:ResetWithColor(16, 2, Color(0.24, 0.92, 0.34, 1.0))
		else
			pixel:ResetWithColor(16, 3, Color(0.08, 0.09, 0.12, 0.90))
		end
	end

end
