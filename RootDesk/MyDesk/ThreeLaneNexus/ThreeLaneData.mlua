	@ExecSpace("ServerOnly")
	method boolean ValidateDrakeReference()
		-- 드레이크 실제 수치와 다섯 표시 등급이 모두 GDD 기준값 보통 3인지 검증한다.
		local drake = self.MonsterById["drake"]
		if drake == nil then
			log_error("[ThreeLaneData][FAIL] drake reference row missing")
			return false
		end

		if drake.Cost ~= 5
			or drake.HP ~= 600
			or drake.Attack ~= 120
			or drake.AttackIntervalTicks ~= 72
			or drake.FirstAttackDelayTicks ~= 18
			or math.abs(drake.MoveSpeed - 1.0) > 0.000001
			or math.abs(drake.AttackRange - 0.70) > 0.000001
			or drake.NexusDamage ~= 5 then
			log_error("[ThreeLaneData][FAIL] drake reference stats mismatch")
			return false
		end

		local hpGrade = self:CalculateGrade("HP", drake.HP)
		local attackGrade = self:CalculateGrade("Attack", drake.Attack)
		local intervalGrade = self:CalculateGrade("AttackInterval", drake.AttackInterval)
		local moveGrade = self:CalculateGrade("MoveSpeed", drake.MoveSpeed)
		local nexusGrade = self:CalculateGrade("NexusDamage", drake.NexusDamage)
		if hpGrade ~= 3
			or attackGrade ~= 3
			or intervalGrade ~= 3
			or moveGrade ~= 3
			or nexusGrade ~= 3 then
			log_error(
				"[ThreeLaneData][FAIL] drake grades="
				.. tostring(hpGrade)
				.. "/"
				.. tostring(attackGrade)
				.. "/"
				.. tostring(intervalGrade)
				.. "/"
				.. tostring(moveGrade)
				.. "/"
				.. tostring(nexusGrade)
			)
			return false
		end

		return true
	end

end
