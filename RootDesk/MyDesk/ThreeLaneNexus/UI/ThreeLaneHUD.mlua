@Component
script ThreeLaneHUD extends Component
-- Phase 2C-4B: Mulligan, instance hand, draw/burn, and permanent slot HUD.

	property TextGUIRendererComponent TurnText = "9a1e9c4c-8e19-4907-a37e-414b6d65d72a"

	property TextGUIRendererComponent PhaseText = "b6d84341-179a-4593-b910-fbf29c00370b"

	property TextGUIRendererComponent TimerText = "71ca757a-45c9-41a2-b7bb-b04b7aaef8a8"

	property TextGUIRendererComponent PlayerHpText = "2172aeda-fb50-4b8b-b646-8efd6973606c"

	property TextGUIRendererComponent EnemyHpText = "b156395b-46a9-483b-8dec-ba8926fb44d6"

	property TextGUIRendererComponent CostText = "667b425f-e727-4ad0-877a-2de023376e45"

	property TextGUIRendererComponent CardHintText = "48ffe959-0e3c-4c8e-8351-78450d476a22"

	property Entity RestartButton = "9200f53f-74c8-4a81-99d6-d490a6bc4a2e"

	property Entity ConfirmButton = "c87b6ec8-c48d-4b2d-a65a-378f77691044"

	property Entity CancelButton = "fa48af91-1e96-4a45-9cce-76a367034251"

	property Entity Speed1Button = "137a029c-eadf-45f1-b833-71a3de249b6b"

	property Entity Speed2Button = "246cba26-1db6-4cb4-81f9-03bfe017a60f"

	property Entity Card1 = "55de8a28-8fbb-4aa6-90b7-1c509b00f9b2"

	property Entity Card2 = "4fbdebf7-8332-4b49-9b28-49027809e1e6"

	property Entity Card3 = "d72e7abc-7e5d-47f6-86a7-f0a3a87b563f"

	property Entity Card4 = "035912e6-dfb3-47c8-898e-0c9c8f1758d7"

	property Entity Card5 = "395b65ff-6c57-49bb-ae67-d087c0131cee"

	property Entity Card6 = "7f23a703-babc-40a4-bee3-c2f99635cbb4"

	property Entity Card7 = "4d3090e4-9267-47dc-a82e-88a18552974a"

	property Entity DragGhost = "12d9f41e-cf2b-4e00-90ae-d37341e26054"

	property table CardEntities = {}

	property table VisualRecordBySlot = {}

	property table HandCards = {}

	property table InstalledCards = {}

	property table MulliganCardEntities = {}

	property table PermanentMarkerEntities = {}

	property table CardDownHandlers = {}

	property table CardDragHandlers = {}

	property table CardUpHandlers = {}

	property table CardEnterHandlers = {}

	property table CardExitHandlers = {}

	property any RestartHandler = nil

	property any ConfirmHandler = nil

	property any CancelHandler = nil

	property any Speed1Handler = nil

	property any Speed2Handler = nil

	property any MulliganReplaceHandler = nil

	property any MulliganKeepHandler = nil

	property Entity MulliganOverlay = ""

	property Entity MulliganReplaceButton = ""

	property Entity MulliganKeepButton = ""

	property Entity DrawGhost = ""

	property Entity BurnToast = ""

	property Entity CardDetailPanel = ""

	property Entity PlayerPublicInfo = ""

	property Entity EnemyPublicInfo = ""

	property string SelectedCardInstanceId = ""

	property integer SelectedVisualSlot = 0

	property integer SelectedReservedSlot = 0

	property integer ActiveVisualSlot = 0

	property integer ActiveTouchId = -999

	property Vector2 DragStartPoint = Vector2(0, 0)

	property boolean IsDragging = false

	property boolean LongPressTriggered = false

	property number LongPressElapsed = 0

	property string DetailInstanceId = ""

	property string HoveredInstanceId = ""

	property Entity SnapSlotEntity = ""

	property number DragThreshold = 24

	property number SnapRadius = 0.72

	property number AmbiguityMargin = 0.12

	property boolean MulliganConfirmedLocally = false

	property number RefreshAccumulator = 0

	property number DrawAnimationElapsed = -1

	property number BurnToastRemaining = 0

	property boolean PrivateSnapshotRequested = false

	property string LastHudStateSignature = ""

	property string LastTimerText = ""

	property string LastMulliganSignature = ""

	property table CardVisualSignatureBySlot = {}

	property table PermanentVisualSignatureBySlot = {}

	property table ImageRuidByEntityId = {}

	property table PortraitBasePositionByEntityId = {}

	property integer HudDataRefreshCount = 0

	property integer DynamicTimerRefreshCount = 0

	property integer CardMutationCount = 0

	property integer PermanentMutationCount = 0

	property string RibbonSelectionSourceId = ""

	property string RibbonSelectionState = "Idle"

	property table RibbonCandidateBySlot = {}

	property table RibbonDestinationBySlot = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 동적 4B UI는 경로로 찾고 기존 2A 조작 엔티티는 기존 바인딩을 유지한다.
		self.CardEntities = { self.Card1, self.Card2, self.Card3, self.Card4, self.Card5, self.Card6, self.Card7 }
		self.VisualRecordBySlot = {}
		self.HandCards = {}
		self.InstalledCards = {}
		self.MulliganCardEntities = {}
		self.PermanentMarkerEntities = {}
		self.LastHudStateSignature = ""
		self.LastTimerText = ""
		self.LastMulliganSignature = ""
		self.CardVisualSignatureBySlot = {}
		self.PermanentVisualSignatureBySlot = {}
		self.ImageRuidByEntityId = {}
		self.PortraitBasePositionByEntityId = {}
		self.HudDataRefreshCount = 0
		self.DynamicTimerRefreshCount = 0
		self.CardMutationCount = 0
		self.PermanentMutationCount = 0
		self.RibbonSelectionSourceId = ""
		self.RibbonSelectionState = "Idle"
		self.RibbonCandidateBySlot = {}
		self.RibbonDestinationBySlot = {}

		self.MulliganOverlay = self:GetHudEntity("MulliganOverlay")
		self.MulliganReplaceButton = self:GetHudEntity("MulliganOverlay/Window/ReplaceButton")
		self.MulliganKeepButton = self:GetHudEntity("MulliganOverlay/Window/KeepButton")
		self.DrawGhost = self:GetHudEntity("DrawGhost")
		self.BurnToast = self:GetHudEntity("BurnToast")
		self.CardDetailPanel = self:GetHudEntity("CardDetailPanel")
		self.PlayerPublicInfo = self:GetHudEntity("PlayerCardPublicInfo")
		self.EnemyPublicInfo = self:GetHudEntity("EnemyCardPublicInfo")

		self:ConnectHandCardEvents()
		self:ConnectMulliganEvents()
		self:ConnectButtonEvents()

		for index = 1, 15 do
			self.PermanentMarkerEntities[index] = self:GetHudEntity(
				"PermanentMarkers/Slot_" .. tostring(index)
			)
		end

		if isvalid(self.DragGhost) then
			self.DragGhost.Enable = false
		end
		if isvalid(self.DrawGhost) then
			self.DrawGhost.Enable = false
		end
		if isvalid(self.BurnToast) then
			self.BurnToast.Enable = false
		end
		if isvalid(self.CardDetailPanel) then
			self.CardDetailPanel.Enable = false
		end

		local board = self:GetBoard()
		if board ~= nil then
			board:RequestPrivateCardSnapshot()
			self.PrivateSnapshotRequested = true
		end
		self:SetCardHint("첫 패 정보를 불러오는 중입니다.")
		self:RefreshHud()
		log("[Phase2C4B][HUD] OnBeginPlay - private hand UI requested")
	end

	@ExecSpace("ClientOnly")
	method void ConnectHandCardEvents()
		self.CardDownHandlers = {}
		self.CardDragHandlers = {}
		self.CardUpHandlers = {}
		self.CardEnterHandlers = {}
		self.CardExitHandlers = {}
		for index, cardEntity in ipairs(self.CardEntities) do
			local visualSlot = index
			if isvalid(cardEntity) then
				self.CardDownHandlers[index] = cardEntity:ConnectEvent(
					UITouchDownEvent,
					function(event)
						self:OnCardTouchDown(visualSlot, event)
					end
				)
				self.CardDragHandlers[index] = cardEntity:ConnectEvent(
					UITouchDragEvent,
					function(event)
						self:OnCardTouchDrag(visualSlot, event)
					end
				)
				self.CardUpHandlers[index] = cardEntity:ConnectEvent(
					UITouchUpEvent,
					function(event)
						self:OnCardTouchUp(visualSlot, event)
					end
				)
				self.CardEnterHandlers[index] = cardEntity:ConnectEvent(
					UITouchEnterEvent,
					function(event)
						self:OnCardTouchEnter(visualSlot, event)
					end
				)
				self.CardExitHandlers[index] = cardEntity:ConnectEvent(
					UITouchExitEvent,
					function(event)
						self:OnCardTouchExit(visualSlot, event)
					end
				)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectMulliganEvents()
		for index = 1, 4 do
			local cardEntity = self:GetHudEntity(
				"MulliganOverlay/Window/Card_" .. tostring(index)
			)
			self.MulliganCardEntities[index] = cardEntity
		end
		if isvalid(self.MulliganReplaceButton) then
			self.MulliganReplaceHandler = self.MulliganReplaceButton:ConnectEvent(
				ButtonClickEvent,
				self.OnMulliganReplaceClicked
			)
		end
		if isvalid(self.MulliganKeepButton) then
			self.MulliganKeepHandler = self.MulliganKeepButton:ConnectEvent(
				ButtonClickEvent,
				self.OnMulliganKeepClicked
			)
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectButtonEvents()
		if isvalid(self.RestartButton) then
			self.RestartHandler = self.RestartButton:ConnectEvent(ButtonClickEvent, self.OnRestartClicked)
		end
		if isvalid(self.ConfirmButton) then
			self.ConfirmHandler = self.ConfirmButton:ConnectEvent(ButtonClickEvent, self.OnConfirmClicked)
		end
		if isvalid(self.CancelButton) then
			self.CancelHandler = self.CancelButton:ConnectEvent(ButtonClickEvent, self.OnCancelClicked)
		end
		if isvalid(self.Speed1Button) then
			self.Speed1Handler = self.Speed1Button:ConnectEvent(ButtonClickEvent, self.OnSpeed1Clicked)
		end
		if isvalid(self.Speed2Button) then
			self.Speed2Handler = self.Speed2Button:ConnectEvent(ButtonClickEvent, self.OnSpeed2Clicked)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self:UpdateLongPress(delta)
		self:UpdateDrawAnimation(delta)
		self:UpdateBurnToast(delta)

		self.RefreshAccumulator = self.RefreshAccumulator + delta
		if self.RefreshAccumulator >= 0.1 then
			self.RefreshAccumulator = 0
			local board = self:GetBoard()
			if board ~= nil then
				self:RefreshDynamicTimer(board)
				local signature = self:BuildHudStateSignature(board)
				if signature ~= self.LastHudStateSignature then
					self:RefreshHud()
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		for index, cardEntity in ipairs(self.CardEntities) do
			if isvalid(cardEntity) then
				if self.CardDownHandlers[index] ~= nil then
					cardEntity:DisconnectEvent(UITouchDownEvent, self.CardDownHandlers[index])
				end
				if self.CardDragHandlers[index] ~= nil then
					cardEntity:DisconnectEvent(UITouchDragEvent, self.CardDragHandlers[index])
				end
				if self.CardUpHandlers[index] ~= nil then
					cardEntity:DisconnectEvent(UITouchUpEvent, self.CardUpHandlers[index])
				end
				if self.CardEnterHandlers[index] ~= nil then
					cardEntity:DisconnectEvent(UITouchEnterEvent, self.CardEnterHandlers[index])
				end
				if self.CardExitHandlers[index] ~= nil then
					cardEntity:DisconnectEvent(UITouchExitEvent, self.CardExitHandlers[index])
				end
			end
		end
		self:DisconnectButtons()
		self:ClearSnapTarget()
	end

	@ExecSpace("ClientOnly")
	method void DisconnectButtons()
		if isvalid(self.RestartButton) and self.RestartHandler ~= nil then
			self.RestartButton:DisconnectEvent(ButtonClickEvent, self.RestartHandler)
		end
		if isvalid(self.ConfirmButton) and self.ConfirmHandler ~= nil then
			self.ConfirmButton:DisconnectEvent(ButtonClickEvent, self.ConfirmHandler)
		end
		if isvalid(self.CancelButton) and self.CancelHandler ~= nil then
			self.CancelButton:DisconnectEvent(ButtonClickEvent, self.CancelHandler)
		end
		if isvalid(self.Speed1Button) and self.Speed1Handler ~= nil then
			self.Speed1Button:DisconnectEvent(ButtonClickEvent, self.Speed1Handler)
		end
		if isvalid(self.Speed2Button) and self.Speed2Handler ~= nil then
			self.Speed2Button:DisconnectEvent(ButtonClickEvent, self.Speed2Handler)
		end
		if isvalid(self.MulliganReplaceButton) and self.MulliganReplaceHandler ~= nil then
			self.MulliganReplaceButton:DisconnectEvent(ButtonClickEvent, self.MulliganReplaceHandler)
		end
		if isvalid(self.MulliganKeepButton) and self.MulliganKeepHandler ~= nil then
			self.MulliganKeepButton:DisconnectEvent(ButtonClickEvent, self.MulliganKeepHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method Entity GetHudEntity(string relativePath)
		return _EntityService:GetEntityByPath("/ui/ThreeLaneHUD/" .. relativePath)
	end

	@ExecSpace("ClientOnly")
	method ThreeLaneBoard GetBoard()
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) or not isvalid(localPlayer.CurrentMap) then
			return nil
		end
		local boardEntity = localPlayer.CurrentMap:GetChildByName("PrototypeBoard")
		if not isvalid(boardEntity) then
			return nil
		end
		---@type ThreeLaneBoard
		local board = boardEntity:GetComponent("script.ThreeLaneBoard")
		if not isvalid(board) then
			return nil
		end
		return board
	end

	@ExecSpace("ClientOnly")
	method Entity GetSlotEntity(integer slotIndex)
		if slotIndex < 1 or slotIndex > 15 then
			return nil
		end
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) or not isvalid(localPlayer.CurrentMap) then
			return nil
		end
		return localPlayer.CurrentMap:GetChildByName("PlayerSlot_" .. tostring(slotIndex))
	end

	@ExecSpace("ClientOnly")
	method table SplitRecord(string value)
		local fields = {}
		if value == nil or value == "" then
			return fields
		end
		for field in string.gmatch(value, "[^|]+") do
			table.insert(fields, field)
		end
		return fields
	end

	@ExecSpace("ClientOnly")
	method table ParseCardRecord(string value)
		local fields = self:SplitRecord(value)
		if #fields < 24 then
			return nil
		end
		return {
			InstanceId = fields[1], MonsterId = fields[2], CardIndex = tonumber(fields[3]) or 0,
			Cost = tonumber(fields[4]) or 0, DevName = fields[5], RangeClass = fields[6],
			EffectType = fields[7], State = fields[8], ImageRuid = fields[9],
			HP = tonumber(fields[10]) or 0, Attack = tonumber(fields[11]) or 0,
			AttackInterval = tonumber(fields[12]) or 0, MoveSpeed = tonumber(fields[13]) or 0,
			NexusDamage = tonumber(fields[14]) or 0, NameKey = fields[15], EffectTextKey = fields[16],
			HPGrade = tonumber(fields[17]) or 0, AttackGrade = tonumber(fields[18]) or 0,
			AttackSpeedGrade = tonumber(fields[19]) or 0, MoveSpeedGrade = tonumber(fields[20]) or 0,
			NexusDamageGrade = tonumber(fields[21]) or 0, PortraitScale = tonumber(fields[22]) or 1,
			PortraitOffsetX = tonumber(fields[23]) or 0, PortraitOffsetY = tonumber(fields[24]) or 0,
			ReservedSlotIndex = tonumber(fields[25]) or 0,
			PermanentSlotIndex = tonumber(fields[25]) or 0,
			VisualState = fields[26] or "Alive",
			PlacementOrder = tonumber(fields[27]) or 0
		}
	end

	@ExecSpace("ClientOnly")
	method string BuildPrivateVisualSignature()
		local parts = {}
		for _, record in ipairs(self.HandCards) do
			table.insert(
				parts,
					record.InstanceId
						.. ":" .. record.State
						.. ":" .. tostring(record.ReservedSlotIndex)
						.. ":" .. record.ImageRuid
						.. ":" .. tostring(record.PortraitScale)
						.. ":" .. tostring(record.PortraitOffsetX)
						.. ":" .. tostring(record.PortraitOffsetY)
			)
		end
		table.insert(parts, "#")
		for _, record in ipairs(self.InstalledCards) do
			table.insert(
				parts,
					record.InstanceId
						.. ":" .. tostring(record.PermanentSlotIndex)
						.. ":" .. record.VisualState
						.. ":" .. record.ImageRuid
						.. ":" .. tostring(record.PortraitScale)
						.. ":" .. tostring(record.PortraitOffsetX)
						.. ":" .. tostring(record.PortraitOffsetY)
			)
		end
		return table.concat(parts, ",")
	end

	@ExecSpace("ClientOnly")
	method string BuildHudStateSignature(ThreeLaneBoard board)
		if board == nil then
			return ""
		end
		return board.BattleState
			.. "|" .. board.Phase
			.. "|" .. tostring(board.TurnNumber)
			.. "|" .. tostring(board.CurrentCost)
			.. "|" .. tostring(board.MaxCost)
			.. "|" .. tostring(board.PendingCount)
			.. "|" .. tostring(board.PlayerNexusHp)
			.. "|" .. tostring(board.EnemyNexusHp)
			.. "|" .. tostring(board.PlayerHandCount)
			.. "|" .. tostring(board.PlayerDeckCount)
			.. "|" .. tostring(board.PlayerInstalledCount)
			.. "|" .. tostring(board.PlayerBurnedCount)
			.. "|" .. tostring(board.EnemyHandCount)
			.. "|" .. tostring(board.EnemyDeckCount)
			.. "|" .. tostring(board.EnemyInstalledCount)
			.. "|" .. tostring(board.EnemyBurnedCount)
			.. "|" .. tostring(board.SimSpeed)
			.. "|" .. tostring(self.MulliganConfirmedLocally)
			.. "|" .. self.SelectedCardInstanceId
			.. "|" .. tostring(self.SelectedReservedSlot)
			.. "|" .. self:BuildPrivateVisualSignature()
	end

	@ExecSpace("ClientOnly")
	method void SetEntityEnable(Entity entity, boolean enabled)
		if isvalid(entity) and entity.Enable ~= enabled then
			entity.Enable = enabled
		end
	end

	@ExecSpace("ClientOnly")
	method void SetImageIfChanged(Entity entity, string ruid)
		if not isvalid(entity) or not isvalid(entity.SpriteGUIRendererComponent) then
			return
		end
		local key = entity.Id
		if self.ImageRuidByEntityId[key] == ruid then
			return
		end
		entity.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		self.ImageRuidByEntityId[key] = ruid
	end

	@ExecSpace("ClientOnly")
	method void ApplyPortraitProfile(Entity portrait, table record)
		-- 모든 카드 표면은 UIBuilder가 만든 하단 중앙 Portrait 영역과 같은 정규화 프로필을 사용한다.
		if not isvalid(portrait) or record == nil
			or not isvalid(portrait.UITransformComponent)
			or not isvalid(portrait.SpriteGUIRendererComponent) then
			return
		end
		self:SetImageIfChanged(portrait, record.ImageRuid)
		if portrait.SpriteGUIRendererComponent.PreserveSprite ~= PreserveSpriteType.AspectOnly then
			portrait.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
		end
		local key = portrait.Id
		local basePosition = self.PortraitBasePositionByEntityId[key]
		if basePosition == nil then
			basePosition = Vector2(
				portrait.UITransformComponent.anchoredPosition.x,
				portrait.UITransformComponent.anchoredPosition.y
			)
			self.PortraitBasePositionByEntityId[key] = basePosition
		end
		local scale = record.PortraitScale or 1
		local offsetX = (record.PortraitOffsetX or 0) * portrait.UITransformComponent.RectSize.x
		local offsetY = (record.PortraitOffsetY or 0) * portrait.UITransformComponent.RectSize.y
		local targetX = basePosition.x + offsetX
		local targetY = basePosition.y + offsetY
		if math.abs(portrait.UITransformComponent.anchoredPosition.x - targetX) > 0.0001
			or math.abs(portrait.UITransformComponent.anchoredPosition.y - targetY) > 0.0001 then
			portrait.UITransformComponent.anchoredPosition = Vector2(targetX, targetY)
		end
		if math.abs(portrait.UITransformComponent.UIScale.x - scale) > 0.0001
			or math.abs(portrait.UITransformComponent.UIScale.y - scale) > 0.0001 then
			portrait.UITransformComponent.UIScale = Vector3(scale, scale, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshDynamicTimer(ThreeLaneBoard board)
		if board == nil or not isvalid(self.TimerText) then
			return
		end
		local value = "전투 대기"
		if board.BattleState ~= "Playing" then
			value = "전투 종료"
		elseif board.Phase == "Mulligan" then
			value = "첫 패 선택 · 시간 제한 없음"
		elseif board.Phase == "Battle" then
			value = "전투 시간  " .. tostring(math.ceil(board.BattleRemaining)) .. "초"
		end
		if self.LastTimerText ~= value then
			self.TimerText.Text = value
			self.LastTimerText = value
			self.DynamicTimerRefreshCount = self.DynamicTimerRefreshCount + 1
		end
	end

	@ExecSpace("ClientOnly")
	method void RequestVisualRefresh()
		self.LastHudStateSignature = ""
		self:RefreshHud()
	end

	@ExecSpace("ClientOnly")
	method void ReceivePrivateCardState(string payload, string eventType, string eventRecord)
		-- 서버가 소유자에게만 보낸 손패·예약·영구 설치 스냅샷을 교체한다.
		local separator = string.find(payload, "#", 1, true)
		local handPart = payload
		local installedPart = ""
		if separator ~= nil then
			handPart = string.sub(payload, 1, separator - 1)
			installedPart = string.sub(payload, separator + 1)
		end

		local hand = {}
		for recordText in string.gmatch(handPart, "[^;]+") do
			local record = self:ParseCardRecord(recordText)
			if record ~= nil then
				table.insert(hand, record)
			end
		end
		table.sort(hand, function(a, b)
			if a.Cost ~= b.Cost then
				return a.Cost < b.Cost
			end
			if a.MonsterId ~= b.MonsterId then
				return a.MonsterId < b.MonsterId
			end
			return a.InstanceId < b.InstanceId
		end)

		local installed = {}
		for recordText in string.gmatch(installedPart, "[^;]+") do
			local record = self:ParseCardRecord(recordText)
			if record ~= nil then
				table.insert(installed, record)
			end
		end
		self.HandCards = hand
		self.InstalledCards = installed

		if eventType == "Reset" then
			self.MulliganConfirmedLocally = false
			self.SelectedCardInstanceId = ""
			self.SelectedVisualSlot = 0
			self.RibbonSelectionSourceId = ""
			self.RibbonSelectionState = "Idle"
			self.RibbonCandidateBySlot = {}
			self.RibbonDestinationBySlot = {}
		elseif eventType == "MulliganRejected" then
			self.MulliganConfirmedLocally = false
			self:SetCardHint("리롤 요청이 거부되었습니다. 현재 첫 패를 다시 확인해 주세요.")
		elseif eventType == "MulliganComplete" then
			self:SetCardHint("첫 턴 드로우가 완료되었습니다. 손패에서 배치할 카드를 고르세요.")
		elseif eventType == "Burn" then
			self:ShowBurnToast(self:ParseCardRecord(eventRecord))
		elseif eventType == "Draw" then
			self:StartDrawAnimation(self:ParseCardRecord(eventRecord))
		elseif eventType == "DeckEmpty" then
			self:SetCardHint("덱이 비어 추가 드로우가 없습니다.")
		elseif eventType == "Undo" then
			self:SetCardHint("정확한 카드 복사본과 코스트가 손패로 돌아왔습니다.")
		elseif eventType == "Install" then
			self:SetCardHint("배치가 영구 설치되었습니다. 전투 후에도 슬롯을 유지합니다.")
		end

		self.LastHudStateSignature = ""
		self:RefreshHud()
		log(
			"[Phase2C4B][Private] Event=" .. eventType
			.. ", Hand=" .. tostring(#self.HandCards)
			.. ", Installed=" .. tostring(#self.InstalledCards)
		)
	end

	@ExecSpace("ClientOnly")
	method void ReceiveRibbonEffectSelection(string sourceInstanceId, string state, string payload)
		self.RibbonSelectionSourceId = sourceInstanceId or ""
		self.RibbonSelectionState = state or "Idle"
		self.RibbonCandidateBySlot = {}
		self.RibbonDestinationBySlot = {}
		if payload ~= nil and payload ~= "" then
			for recordText in string.gmatch(payload, "[^,]+") do
				local fields = {}
				for field in string.gmatch(recordText, "[^:]+") do
					table.insert(fields, field)
				end
				local targetSlot = tonumber(fields[2]) or 0
				local destinationSlot = tonumber(fields[3]) or 0
				if targetSlot > 0 then
					self.RibbonCandidateBySlot[targetSlot] = fields[1]
				end
				if destinationSlot > 0 then
					self.RibbonDestinationBySlot[destinationSlot] = true
				end
			end
		end
		if self.RibbonSelectionState == "Selecting" then
			self:SetCardHint("아래 라인으로 이동할 아군을 선택하세요. 초록색 슬롯만 선택할 수 있습니다.")
		elseif self.RibbonSelectionState == "Selected" then
			self:SetCardHint("리본돼지 이동 대상과 목적지를 예약했습니다. 배치 확정 전까지 되돌릴 수 있습니다.")
		elseif self.RibbonSelectionState == "NoTarget" then
			self:SetCardHint("이동 가능한 앞순번 아군이 없어 리본돼지를 효과 없이 예약했습니다.")
		end
		self.PermanentVisualSignatureBySlot = {}
		self:RequestVisualRefresh()
		log(
			"[Phase2C5][RibbonManual][HUD] State="
			.. self.RibbonSelectionState
			.. ", Source=" .. self.RibbonSelectionSourceId
		)
	end

	@ExecSpace("ClientOnly")
	method boolean HandleRibbonTargetSlotInput(integer slotIndex)
		if self.RibbonSelectionState ~= "Selecting" then
			return false
		end
		local targetInstanceId = self.RibbonCandidateBySlot[slotIndex]
		if targetInstanceId == nil or targetInstanceId == "" then
			self:SetCardHint("이 슬롯은 리본돼지 효과의 유효 대상이 아닙니다. 초록색 슬롯을 선택하세요.")
			return true
		end
		local board = self:GetBoard()
		if board == nil then
			return true
		end
		board:RequestSelectRibbonEffectTarget(self.RibbonSelectionSourceId, targetInstanceId)
		self:SetCardHint("리본돼지 이동 대상의 서버 검증을 기다리는 중입니다.")
		return true
	end

	@ExecSpace("ClientOnly")
	method void RefreshHud()
		local board = self:GetBoard()
		if board == nil then
			return
		end
		if not self.PrivateSnapshotRequested then
			self.PrivateSnapshotRequested = true
			board:RequestPrivateCardSnapshot()
		end

		if isvalid(self.TurnText) then
			self.TurnText.Text = tostring(board.TurnNumber) .. "턴"
		end
		if isvalid(self.PhaseText) then
			self.PhaseText.Text = self:GetPhaseLabel(board)
		end
		self:RefreshDynamicTimer(board)
		if isvalid(self.PlayerHpText) then
			self.PlayerHpText.Text = tostring(board.PlayerNexusHp)
		end
		if isvalid(self.EnemyHpText) then
			self.EnemyHpText.Text = tostring(board.EnemyNexusHp)
		end
		if isvalid(self.CostText) then
			self.CostText.Text = tostring(board.CurrentCost) .. " / " .. tostring(board.MaxCost)
		end

		self:SetEntityText(
			self.PlayerPublicInfo,
			"패 " .. tostring(board.PlayerHandCount) .. "  덱 " .. tostring(board.PlayerDeckCount)
			.. "\n설치 " .. tostring(board.PlayerInstalledCount) .. "  소실 " .. tostring(board.PlayerBurnedCount)
		)
		self:SetEntityText(
			self.EnemyPublicInfo,
			"패 " .. tostring(board.EnemyHandCount) .. "  덱 " .. tostring(board.EnemyDeckCount)
			.. "\n설치 " .. tostring(board.EnemyInstalledCount) .. "  소실 " .. tostring(board.EnemyBurnedCount)
		)

		self:ValidateReservedSelection(board)
		self:RefreshConfirmVisual(board)
		self:RefreshCancelVisual(board)
		self:RefreshSpeedVisual(board)
		self:RefreshCardVisuals(board)
		self:RefreshMulliganVisual(board)
		self:RefreshPermanentSlots()
		self.LastHudStateSignature = self:BuildHudStateSignature(board)
		self.HudDataRefreshCount = self.HudDataRefreshCount + 1
	end

	@ExecSpace("ClientOnly")
	method void SetEntityText(Entity entity, string value)
		if isvalid(entity)
			and isvalid(entity.TextGUIRendererComponent)
			and entity.TextGUIRendererComponent.Text ~= value then
			entity.TextGUIRendererComponent.Text = value
		end
	end

	@ExecSpace("ClientOnly")
	method string GetPhaseLabel(ThreeLaneBoard board)
		if board.BattleState == "Victory" then
			return "승리 · 재시작 가능"
		end
		if board.BattleState == "Defeat" then
			return "패배 · 재시작 가능"
		end
		if board.BattleState == "Draw" then
			return "무승부 · 재시작 가능"
		end
		if board.Phase == "Mulligan" then
			return "첫 패 선택"
		end
		if board.Phase == "Placement" then
			return "배치 단계 (" .. tostring(board.PendingCount) .. "기 예약)"
		end
		if board.Phase == "Reveal" then
			return "공개 단계"
		end
		if board.Phase == "Battle" then
			return "전투 단계"
		end
		return "정산 단계"
	end

	@ExecSpace("ClientOnly")
	method void SetCardEntityData(Entity cardEntity, table record)
		if not isvalid(cardEntity) then
			return
		end
		if record == nil then
			self:SetEntityEnable(cardEntity, false)
			return
		end
		self:SetEntityEnable(cardEntity, true)
		local portrait = cardEntity:GetChildByName("Portrait")
		self:ApplyPortraitProfile(portrait, record)
		self:SetEntityText(cardEntity:GetChildByName("Name"), record.DevName)
		self:SetEntityText(cardEntity:GetChildByName("Cost"), tostring(record.Cost))
		local rangeLabel = "근접"
		if record.RangeClass == "Ranged" then
			rangeLabel = "원거리"
		end
		self:SetEntityText(cardEntity:GetChildByName("Range"), rangeLabel)
		local effectBadge = cardEntity:GetChildByName("EffectBadge")
		if isvalid(effectBadge) then
			effectBadge.Enable = record.EffectType ~= nil and record.EffectType ~= "" and record.EffectType ~= "None"
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshCardVisuals(ThreeLaneBoard board)
		local nextVisualRecordBySlot = {}
		local count = #self.HandCards
		if count > 7 then
			count = 7
		end
		local startSlot = math.floor((7 - count) / 2) + 1
		local placementOpen = board.BattleState == "Playing" and board.Phase == "Placement"
		for index = 1, count do
			local visualSlot = startSlot + index - 1
			nextVisualRecordBySlot[visualSlot] = self.HandCards[index]
		end
		for visualSlot = 1, 7 do
			local record = nextVisualRecordBySlot[visualSlot]
			local cardEntity = self.CardEntities[visualSlot]
			local signature = "Empty"
			if record ~= nil then
				signature = record.InstanceId
					.. "|" .. record.State
					.. "|" .. record.ImageRuid
					.. "|" .. tostring(record.Cost)
					.. "|" .. tostring(placementOpen)
					.. "|" .. tostring(board.CurrentCost)
					.. "|" .. tostring(self.SelectedCardInstanceId == record.InstanceId)
					.. "|" .. tostring(record.PortraitScale)
					.. "|" .. tostring(record.PortraitOffsetX)
					.. "|" .. tostring(record.PortraitOffsetY)
			end
			local changed = self.CardVisualSignatureBySlot[visualSlot] ~= signature
			if changed then
				self.CardVisualSignatureBySlot[visualSlot] = signature
				self.CardMutationCount = self.CardMutationCount + 1
				self:SetCardEntityData(cardEntity, record)
			end
			if record ~= nil
				and changed
				and isvalid(cardEntity)
				and isvalid(cardEntity.SpriteGUIRendererComponent) then
				if record.State == "Reserved" then
					cardEntity.SpriteGUIRendererComponent.Color = Color(0.36, 0.42, 0.50, 0.88)
				elseif not placementOpen then
					cardEntity.SpriteGUIRendererComponent.Color = Color(0.45, 0.47, 0.52, 0.78)
				elseif board.CurrentCost < record.Cost then
					cardEntity.SpriteGUIRendererComponent.Color = Color(0.62, 0.42, 0.42, 0.88)
				elseif self.SelectedCardInstanceId == record.InstanceId then
					cardEntity.SpriteGUIRendererComponent.Color = Color(1.0, 0.80, 0.28, 1.0)
				else
					cardEntity.SpriteGUIRendererComponent.Color = Color(0.8667, 0.9490, 1.0, 1.0)
				end
				local reservedShade = cardEntity:GetChildByName("ReservedShade")
				if isvalid(reservedShade) then
					reservedShade.Enable = record.State == "Reserved"
				end
				local selection = cardEntity:GetChildByName("SelectionBorder")
				if isvalid(selection) then
					selection.Enable = self.SelectedCardInstanceId == record.InstanceId
				end
			end
		end
		self.VisualRecordBySlot = nextVisualRecordBySlot
	end

	@ExecSpace("ClientOnly")
	method void RefreshMulliganVisual(ThreeLaneBoard board)
		if not isvalid(self.MulliganOverlay) then
			return
		end
		local visible = board.BattleState == "Playing" and board.Phase == "Mulligan"
		local parts = { tostring(visible), tostring(self.MulliganConfirmedLocally) }
		for index = 1, 4 do
			local record = self.HandCards[index]
			if record == nil then
				table.insert(parts, "Empty")
			else
				table.insert(
					parts,
					record.InstanceId .. ":" .. record.State .. ":" .. record.ImageRuid
						.. ":" .. tostring(record.PortraitScale)
						.. ":" .. tostring(record.PortraitOffsetX)
						.. ":" .. tostring(record.PortraitOffsetY)
				)
			end
		end
		local signature = table.concat(parts, "|")
		if signature == self.LastMulliganSignature then
			return
		end
		self.LastMulliganSignature = signature
		self:SetEntityEnable(self.MulliganOverlay, visible)
		if not visible then
			return
		end

		for index = 1, 4 do
			local record = self.HandCards[index]
			local cardEntity = self.MulliganCardEntities[index]
			self:SetCardEntityData(cardEntity, record)
			if isvalid(cardEntity) then
				cardEntity.UITransformComponent.anchoredPosition = Vector2(
					cardEntity.UITransformComponent.anchoredPosition.x,
					30
				)
			end
		end

		if isvalid(self.MulliganReplaceButton) then
			self:SetEntityText(self.MulliganReplaceButton, "패 전부 교체")
			local usable = not self.MulliganConfirmedLocally
			if isvalid(self.MulliganReplaceButton.ButtonComponent) then
				self.MulliganReplaceButton.ButtonComponent.Enable = usable
			end
			if isvalid(self.MulliganReplaceButton.SpriteGUIRendererComponent) then
				if usable then
					self.MulliganReplaceButton.SpriteGUIRendererComponent.Color = Color(0.16, 0.48, 0.78, 1.0)
				else
					self.MulliganReplaceButton.SpriteGUIRendererComponent.Color = Color(0.35, 0.39, 0.46, 0.9)
				end
			end
		end
		if isvalid(self.MulliganKeepButton) and isvalid(self.MulliganKeepButton.ButtonComponent) then
			self.MulliganKeepButton.ButtonComponent.Enable = not self.MulliganConfirmedLocally
		end
	end

	@ExecSpace("ClientOnly")
	method void OnMulliganReplaceClicked(ButtonClickEvent event)
		self:SubmitMulligan("ReplaceAll")
	end

	@ExecSpace("ClientOnly")
	method void OnMulliganKeepClicked(ButtonClickEvent event)
		self:SubmitMulligan("Keep")
	end

	@ExecSpace("ClientOnly")
	method void SubmitMulligan(string choice)
		local board = self:GetBoard()
		if board == nil or board.Phase ~= "Mulligan" or self.MulliganConfirmedLocally then
			return
		end
		self.MulliganConfirmedLocally = true
		self:RequestVisualRefresh()
		board:RequestConfirmMulligan(choice)
		if choice == "ReplaceAll" then
			self:SetCardHint("첫 패 4장 전부 교체를 요청했습니다. 서버 결과를 기다리는 중입니다.")
		else
			self:SetCardHint("현재 첫 패로 시작합니다. 서버 결과를 기다리는 중입니다.")
		end
	end

	@ExecSpace("ClientOnly")
	method boolean CanPickVisualCard(integer visualSlot)
		local record = self.VisualRecordBySlot[visualSlot]
		if record == nil then
			return false
		end
		local board = self:GetBoard()
		if board == nil then
			return false
		end
		if self.RibbonSelectionState == "Selecting" then
			self:SetCardHint("리본돼지의 이동 대상을 먼저 선택하세요.")
			return false
		end
		if board.BattleState ~= "Playing" then
			self:SetCardHint("전투가 끝났습니다. 재시작을 눌러 주세요.")
			return false
		end
		if board.Phase ~= "Placement" then
			self:SetCardHint("첫 패 선택이 끝난 배치 단계에서만 카드를 사용할 수 있습니다.")
			return false
		end
		if record.State == "Reserved" then
			self:SetCardHint("이미 예약 중인 카드 복사본입니다. 되돌리기로 회수할 수 있습니다.")
			return false
		end
		if record.State ~= "Hand" then
			return false
		end
		if board.CurrentCost < record.Cost then
			self:SetCardHint("코스트가 부족합니다. 필요 " .. tostring(record.Cost) .. " · 보유 " .. tostring(board.CurrentCost))
			return false
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnCardTouchDown(integer visualSlot, UITouchDownEvent event)
		if self.ActiveVisualSlot ~= 0 or not self:CanPickVisualCard(visualSlot) then
			return
		end
		self.ActiveVisualSlot = visualSlot
		self.ActiveTouchId = event.TouchId
		self.DragStartPoint = event.TouchPoint
		self.IsDragging = false
		self.LongPressTriggered = false
		self.LongPressElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void OnCardTouchDrag(integer visualSlot, UITouchDragEvent event)
		if visualSlot ~= self.ActiveVisualSlot or event.TouchId ~= self.ActiveTouchId then
			return
		end
		local deltaX = event.TouchPoint.x - self.DragStartPoint.x
		local deltaY = event.TouchPoint.y - self.DragStartPoint.y
		local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)
		if not self.IsDragging and distance < self.DragThreshold then
			return
		end
		if not self.IsDragging then
			self.IsDragging = true
			self:HideCardDetails()
			self.SelectedVisualSlot = visualSlot
			local record = self.VisualRecordBySlot[visualSlot]
			if record ~= nil then
				self.SelectedCardInstanceId = record.InstanceId
			end
			if isvalid(self.DragGhost) then
				self:SetCardEntityData(self.DragGhost, record)
				self.DragGhost.Enable = true
				_UILogic:SetSiblingIndex(self.DragGhost.UITransformComponent, 100)
			end
		end
		self:MoveDragGhost(event.TouchPoint)
		self:UpdateSnapTarget(event.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void OnCardTouchUp(integer visualSlot, UITouchUpEvent event)
		if visualSlot ~= self.ActiveVisualSlot or event.TouchId ~= self.ActiveTouchId then
			return
		end
		local record = self.VisualRecordBySlot[visualSlot]
		if self.IsDragging then
			self:MoveDragGhost(event.TouchPoint)
			self:UpdateSnapTarget(event.TouchPoint)
			local targetSlot = self.SnapSlotEntity
			if isvalid(self.DragGhost) then
				self.DragGhost.Enable = false
			end
			self:ClearSnapTarget()
			if isvalid(targetSlot) then
				self:RequestCardToSlot(record, targetSlot, "drag")
			else
				self.SelectedCardInstanceId = ""
				self.SelectedVisualSlot = 0
				self:SetCardHint("배치 취소: 슬롯 중앙에 더 가깝게 놓아 주세요.")
			end
		elseif self.LongPressTriggered then
			self:HideCardDetails()
		else
			self:SelectVisualCard(visualSlot)
		end
		self.ActiveVisualSlot = 0
		self.ActiveTouchId = -999
		self.IsDragging = false
		self.LongPressTriggered = false
		self.LongPressElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void OnCardTouchEnter(integer visualSlot, UITouchEnterEvent event)
		-- 음수 TouchId는 PC 마우스 입력이다. 모바일은 길게 누르기 경로만 사용한다.
		if event.TouchId >= 0 then
			return
		end
		local record = self.VisualRecordBySlot[visualSlot]
		if record ~= nil then
			self.HoveredInstanceId = record.InstanceId
			self:ShowCardDetails(record)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCardTouchExit(integer visualSlot, UITouchExitEvent event)
		local record = self.VisualRecordBySlot[visualSlot]
		if record ~= nil and self.HoveredInstanceId == record.InstanceId then
			self.HoveredInstanceId = ""
			self:HideCardDetails()
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateLongPress(number delta)
		if self.ActiveVisualSlot == 0 or self.IsDragging or self.LongPressTriggered then
			return
		end
		self.LongPressElapsed = self.LongPressElapsed + delta
		if self.LongPressElapsed < 0.60 then
			return
		end
		local record = self.VisualRecordBySlot[self.ActiveVisualSlot]
		if record ~= nil then
			self.LongPressTriggered = true
			self:ShowCardDetails(record)
		end
	end

	@ExecSpace("ClientOnly")
	method void SelectVisualCard(integer visualSlot)
		local record = self.VisualRecordBySlot[visualSlot]
		if record == nil then
			return
		end
		if self.SelectedCardInstanceId == record.InstanceId then
			self.SelectedCardInstanceId = ""
			self.SelectedVisualSlot = 0
			self:SetCardHint("선택을 취소했습니다.")
			self:RequestVisualRefresh()
			return
		end
		if not self:CanPickVisualCard(visualSlot) then
			return
		end
		self:ClearReservedSelection()
		self.SelectedCardInstanceId = record.InstanceId
		self.SelectedVisualSlot = visualSlot
		self:SetCardHint(record.DevName .. " 선택 (코스트 " .. tostring(record.Cost) .. ") · 빈 슬롯을 터치하세요.")
		self:RequestVisualRefresh()
	end

	@ExecSpace("ClientOnly")
	method table GetSelectedCardRecord()
		for _, record in ipairs(self.HandCards) do
			if record.InstanceId == self.SelectedCardInstanceId then
				return record
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method boolean RequestSelectedCardToSlot(Entity slotEntity)
		local record = self:GetSelectedCardRecord()
		if record == nil then
			self:SetCardHint("먼저 하단 손패에서 카드를 선택하세요.")
			return false
		end
		return self:RequestCardToSlot(record, slotEntity, "click")
	end

	@ExecSpace("ClientOnly")
	method boolean RequestCardToSlot(table record, Entity slotEntity, string inputSource)
		if record == nil or not isvalid(slotEntity) then
			return false
		end
		local visualSlot = self:FindVisualSlotByInstance(record.InstanceId)
		if visualSlot == 0 or not self:CanPickVisualCard(visualSlot) then
			return false
		end
		---@type ThreeLaneSlot
		local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
		if not isvalid(slot) then
			return false
		end
		if slot.IsOccupied then
			self:SetCardHint("이미 영구 설치 또는 예약 중인 슬롯입니다.")
			return false
		end
		local board = self:GetBoard()
		if board == nil then
			return false
		end
		board:RequestPlaceCardInstance(slot.SlotIndex, record.InstanceId)
		self.SelectedCardInstanceId = ""
		self.SelectedVisualSlot = 0
		self:SetCardHint("배치 예약: " .. record.DevName .. " → 슬롯 " .. tostring(slot.SlotIndex) .. " · 확정 전 되돌리기 가능")
		self:RequestVisualRefresh()
		log("[Phase2C4B][Placement] Source=" .. inputSource .. ", Instance=" .. record.InstanceId .. ", Slot=" .. tostring(slot.SlotIndex))
		return true
	end

	@ExecSpace("ClientOnly")
	method integer FindVisualSlotByInstance(string instanceId)
		for visualSlot, record in pairs(self.VisualRecordBySlot) do
			if record.InstanceId == instanceId then
				return visualSlot
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void MoveDragGhost(Vector2 screenPoint)
		if isvalid(self.DragGhost) then
			self.DragGhost.UITransformComponent.anchoredPosition = _UILogic:ScreenToUIPosition(screenPoint)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateSnapTarget(Vector2 screenPoint)
		self:ClearSnapTarget()
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) or not isvalid(localPlayer.CurrentMap) then
			return
		end
		local worldPoint = _UILogic:ScreenToWorldPosition(screenPoint)
		local nearestSlot = nil
		local nearestDistance = 999999
		local secondDistance = 999999
		for index = 1, 15 do
			local slotEntity = localPlayer.CurrentMap:GetChildByName("PlayerSlot_" .. tostring(index))
			if isvalid(slotEntity) then
				local slotPosition = slotEntity.TransformComponent.WorldPosition
				local deltaX = worldPoint.x - slotPosition.x
				local deltaY = worldPoint.y - slotPosition.y
				local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)
				if distance < nearestDistance then
					secondDistance = nearestDistance
					nearestDistance = distance
					nearestSlot = slotEntity
				elseif distance < secondDistance then
					secondDistance = distance
				end
			end
		end
		if not isvalid(nearestSlot) or nearestDistance > self.SnapRadius then
			return
		end
		---@type ThreeLaneSlot
		local slot = nearestSlot:GetComponent("script.ThreeLaneSlot")
		if not isvalid(slot) or slot.IsOccupied then
			self:SetCardHint("가장 가까운 슬롯은 이미 사용 중입니다.")
			return
		end
		if secondDistance <= self.SnapRadius and secondDistance - nearestDistance < self.AmbiguityMargin then
			self:SetCardHint("두 슬롯 사이입니다. 원하는 슬롯 중앙에 더 가깝게 놓아 주세요.")
			return
		end
		self.SnapSlotEntity = nearestSlot
		if isvalid(nearestSlot.SpriteRendererComponent) then
			nearestSlot.SpriteRendererComponent.Color = Color(1.0, 0.78, 0.18, 1.0)
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearSnapTarget()
		if isvalid(self.SnapSlotEntity) and isvalid(self.SnapSlotEntity.SpriteRendererComponent) then
			---@type ThreeLaneSlot
			local slot = self.SnapSlotEntity:GetComponent("script.ThreeLaneSlot")
			if isvalid(slot) and slot.OccupancyState == "Permanent" then
				self.SnapSlotEntity.SpriteRendererComponent.Color = Color(0.30, 0.38, 0.55, 0.75)
			elseif isvalid(slot) and slot.IsOccupied then
				self.SnapSlotEntity.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.6)
			else
				self.SnapSlotEntity.SpriteRendererComponent.Color = Color(0.25, 0.65, 1.0, 0.85)
			end
		end
		self.SnapSlotEntity = nil
	end

	@ExecSpace("ClientOnly")
	method void SelectReservedSlot(Entity slotEntity)
		local board = self:GetBoard()
		if board == nil or board.BattleState ~= "Playing" or board.Phase ~= "Placement" then
			return
		end
		---@type ThreeLaneSlot
		local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
		if not isvalid(slot) or slot.OccupancyState ~= "Reserved" then
			self:SetCardHint("영구 설치 슬롯은 취소하거나 다시 배치할 수 없습니다.")
			return
		end
		if self.SelectedReservedSlot == slot.SlotIndex then
			self:ClearReservedSelection()
			return
		end
		self:ClearReservedSelection()
		self.SelectedReservedSlot = slot.SlotIndex
		self.SelectedCardInstanceId = ""
		self.SelectedVisualSlot = 0
		if isvalid(slotEntity.SpriteRendererComponent) then
			slotEntity.SpriteRendererComponent.Color = Color(1.0, 0.45, 0.20, 1.0)
		end
		self:SetCardHint("예약 선택: 슬롯 " .. tostring(slot.SlotIndex) .. " · 취소 버튼으로 정확한 카드 복사본을 회수합니다.")
		self:RequestVisualRefresh()
	end

	@ExecSpace("ClientOnly")
	method void ClearReservedSelection()
		local slotEntity = self:GetSlotEntity(self.SelectedReservedSlot)
		if isvalid(slotEntity) and isvalid(slotEntity.SpriteRendererComponent) then
			slotEntity.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.6)
		end
		self.SelectedReservedSlot = 0
	end

	@ExecSpace("ClientOnly")
	method void ValidateReservedSelection(ThreeLaneBoard board)
		if self.SelectedReservedSlot == 0 then
			return
		end
		if board.Phase ~= "Placement" or board.BattleState ~= "Playing" then
			self:ClearReservedSelection()
			return
		end
		local slotEntity = self:GetSlotEntity(self.SelectedReservedSlot)
		if not isvalid(slotEntity) then
			self.SelectedReservedSlot = 0
			return
		end
		---@type ThreeLaneSlot
		local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
		if not isvalid(slot) or slot.OccupancyState ~= "Reserved" then
			self.SelectedReservedSlot = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshPermanentSlots()
		local installedBySlot = {}
		local reservedBySlot = {}
		for _, record in ipairs(self.InstalledCards) do
			installedBySlot[record.PermanentSlotIndex] = record
		end
		for _, record in ipairs(self.HandCards) do
			if record.State == "Reserved" and record.ReservedSlotIndex > 0 then
				reservedBySlot[record.ReservedSlotIndex] = record
			end
		end

		for slotIndex = 1, 15 do
			local installed = installedBySlot[slotIndex]
			local reserved = reservedBySlot[slotIndex]
			local candidateId = self.RibbonCandidateBySlot[slotIndex] or ""
			local destination = self.RibbonDestinationBySlot[slotIndex] == true
			local occupancy = "Empty"
			local instanceId = ""
			local imageRuid = ""
			local visualState = ""
			if installed ~= nil then
				occupancy = "Permanent"
				instanceId = installed.InstanceId
				imageRuid = installed.ImageRuid
				visualState = installed.VisualState
			elseif reserved ~= nil then
				occupancy = "Reserved"
				instanceId = reserved.InstanceId
				imageRuid = reserved.ImageRuid
			elseif destination then
				occupancy = "EffectDestination"
			end
			local signature = occupancy
				.. "|" .. instanceId
				.. "|" .. imageRuid
				.. "|" .. visualState
				.. "|" .. candidateId
				.. "|" .. tostring(destination)
				.. "|" .. tostring(self.SelectedReservedSlot == slotIndex)
			if installed ~= nil then
				signature = signature
					.. "|" .. tostring(installed.PortraitScale)
					.. "|" .. tostring(installed.PortraitOffsetX)
					.. "|" .. tostring(installed.PortraitOffsetY)
			end
			if self.PermanentVisualSignatureBySlot[slotIndex] ~= signature then
				self.PermanentVisualSignatureBySlot[slotIndex] = signature
				self.PermanentMutationCount = self.PermanentMutationCount + 1
				local slotEntity = self:GetSlotEntity(slotIndex)
				local marker = self.PermanentMarkerEntities[slotIndex]
				if isvalid(slotEntity) then
					---@type ThreeLaneSlot
					local slot = slotEntity:GetComponent("script.ThreeLaneSlot")
					if isvalid(slot) then
						slot.IsOccupied = occupancy ~= "Empty"
						slot.OccupancyState = occupancy
					end
					if isvalid(slotEntity.SpriteRendererComponent) then
						if candidateId ~= "" then
							slotEntity.SpriteRendererComponent.Color = Color(0.28, 1.0, 0.48, 1.0)
						elseif destination then
							slotEntity.SpriteRendererComponent.Color = Color(0.72, 0.38, 1.0, 0.95)
						elseif occupancy == "Permanent" then
							slotEntity.SpriteRendererComponent.Color = Color(0.30, 0.38, 0.55, 0.75)
						elseif occupancy == "Reserved" and self.SelectedReservedSlot == slotIndex then
							slotEntity.SpriteRendererComponent.Color = Color(1.0, 0.45, 0.20, 1.0)
						elseif occupancy == "Reserved" then
							slotEntity.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.6)
						else
							slotEntity.SpriteRendererComponent.Color = Color(0.25, 0.65, 1.0, 0.85)
						end
					end
				end
				if installed == nil then
					self:SetEntityEnable(marker, false)
				elseif isvalid(marker) and isvalid(slotEntity) then
					self:SetEntityEnable(marker, true)
					self:ApplyPortraitProfile(marker:GetChildByName("Portrait"), installed)
					local deadShade = marker:GetChildByName("DeadShade")
					self:SetEntityEnable(deadShade, installed.VisualState == "Dead")
					local worldPosition = slotEntity.TransformComponent.WorldPosition
					local screenPosition = _UILogic:WorldToScreenPosition(Vector2(worldPosition.x, worldPosition.y))
					marker.UITransformComponent.anchoredPosition = _UILogic:ScreenToUIPosition(screenPosition)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowCardDetails(table record)
		if record == nil or not isvalid(self.CardDetailPanel) then
			return
		end
		self.DetailInstanceId = record.InstanceId
		self.CardDetailPanel.Enable = true
		local portrait = self.CardDetailPanel:GetChildByName("Portrait")
		self:ApplyPortraitProfile(portrait, record)
		self:SetEntityText(
			self.CardDetailPanel:GetChildByName("Name"),
			record.DevName .. " · 코스트 " .. tostring(record.Cost)
		)
		local rangeLabel = "근접"
		if record.RangeClass == "Ranged" then
			rangeLabel = "원거리"
		end
		self:SetEntityText(
			self.CardDetailPanel:GetChildByName("Stats"),
			self:FormatGradeLine("체력", record.HPGrade)
			.. "\n" .. self:FormatGradeLine("공격력", record.AttackGrade)
			.. "\n" .. self:FormatGradeLine("공격 속도", record.AttackSpeedGrade)
			.. "\n" .. self:FormatGradeLine("이동 속도", record.MoveSpeedGrade)
			.. "\n" .. self:FormatGradeLine("수호석 피해", record.NexusDamageGrade)
		)
		local effectText = "특수효과 없음"
		if record.EffectType ~= "None" then
			effectText = "특수효과 · " .. record.EffectType
		end
		self:SetEntityText(
			self.CardDetailPanel:GetChildByName("Effect"),
			"공격 유형: " .. rangeLabel .. "\n" .. effectText
		)
	end

	@ExecSpace("ClientOnly")
	method string GetGradeLabel(integer grade)
		if grade == 1 then return "매우 낮음" end
		if grade == 2 then return "낮음" end
		if grade == 3 then return "보통" end
		if grade == 4 then return "높음" end
		if grade == 5 then return "매우 높음" end
		return "미정"
	end

	@ExecSpace("ClientOnly")
	method string FormatGradeLine(string label, integer grade)
		local clamped = grade
		if clamped < 0 then clamped = 0 end
		if clamped > 5 then clamped = 5 end
		local dots = ""
		for index = 1, 5 do
			if index <= clamped then dots = dots .. "●"
			else dots = dots .. "○" end
		end
		return label .. ": " .. dots .. " · " .. self:GetGradeLabel(grade)
	end

	@ExecSpace("ClientOnly")
	method void HideCardDetails()
		self.DetailInstanceId = ""
		if isvalid(self.CardDetailPanel) then
			self.CardDetailPanel.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void StartDrawAnimation(table record)
		if record == nil or not isvalid(self.DrawGhost) then
			return
		end
		self:SetCardEntityData(self.DrawGhost, record)
		self.DrawGhost.Enable = true
		self.DrawGhost.UITransformComponent.anchoredPosition = Vector2(620, -350)
		self.DrawAnimationElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void UpdateDrawAnimation(number delta)
		if self.DrawAnimationElapsed < 0 or not isvalid(self.DrawGhost) then
			return
		end
		self.DrawAnimationElapsed = self.DrawAnimationElapsed + delta
		local rate = self.DrawAnimationElapsed / 0.45
		if rate > 1 then
			rate = 1
		end
		self.DrawGhost.UITransformComponent.anchoredPosition = Vector2(
			620 + (0 - 620) * rate,
			-350 + (-425 + 350) * rate
		)
		if rate >= 1 then
			self.DrawGhost.Enable = false
			self.DrawAnimationElapsed = -1
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowBurnToast(table record)
		if record == nil or not isvalid(self.BurnToast) then
			return
		end
		self.BurnToast.Enable = true
		self.BurnToastRemaining = 3.0
		local portrait = self.BurnToast:GetChildByName("Portrait")
		self:ApplyPortraitProfile(portrait, record)
		self:SetEntityText(self.BurnToast:GetChildByName("Name"), record.DevName)
		self:SetEntityText(self.BurnToast:GetChildByName("Message"), "패가 가득 차 카드가 소실되었습니다")
	end

	@ExecSpace("ClientOnly")
	method void UpdateBurnToast(number delta)
		if self.BurnToastRemaining <= 0 then
			return
		end
		self.BurnToastRemaining = self.BurnToastRemaining - delta
		if self.BurnToastRemaining <= 0 and isvalid(self.BurnToast) then
			self.BurnToast.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshConfirmVisual(ThreeLaneBoard board)
		if not isvalid(self.ConfirmButton) then
			return
		end
		local usable = board.BattleState == "Playing"
			and board.Phase == "Placement"
			and self.RibbonSelectionState ~= "Selecting"
		if isvalid(self.ConfirmButton.ButtonComponent) then
			self.ConfirmButton.ButtonComponent.Enable = usable
		end
		if isvalid(self.ConfirmButton.SpriteGUIRendererComponent) then
			if usable then self.ConfirmButton.SpriteGUIRendererComponent.Color = Color(0.16, 0.55, 0.32, 1.0)
			else self.ConfirmButton.SpriteGUIRendererComponent.Color = Color(0.28, 0.30, 0.34, 0.7) end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshCancelVisual(ThreeLaneBoard board)
		if not isvalid(self.CancelButton) then
			return
		end
		local usable = board.BattleState == "Playing" and board.Phase == "Placement" and board.PendingCount > 0
		if isvalid(self.CancelButton.ButtonComponent) then
			self.CancelButton.ButtonComponent.Enable = usable
		end
		if isvalid(self.CancelButton.TextGUIRendererComponent) then
			if self.SelectedReservedSlot ~= 0 then self.CancelButton.TextGUIRendererComponent.Text = "슬롯 " .. tostring(self.SelectedReservedSlot) .. " 취소"
			else self.CancelButton.TextGUIRendererComponent.Text = "되돌리기 (" .. tostring(board.PendingCount) .. ")" end
		end
		if isvalid(self.CancelButton.SpriteGUIRendererComponent) then
			if usable then self.CancelButton.SpriteGUIRendererComponent.Color = Color(0.68, 0.24, 0.24, 1.0)
			else self.CancelButton.SpriteGUIRendererComponent.Color = Color(0.28, 0.30, 0.34, 0.7) end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSpeedVisual(ThreeLaneBoard board)
		self:SetSpeedButtonVisual(self.Speed1Button, board.SimSpeed == 1)
		self:SetSpeedButtonVisual(self.Speed2Button, board.SimSpeed == 2)
	end

	@ExecSpace("ClientOnly")
	method void SetSpeedButtonVisual(Entity button, boolean selected)
		if not isvalid(button) then
			return
		end
		if isvalid(button.SpriteGUIRendererComponent) then
			if selected then button.SpriteGUIRendererComponent.Color = Color(1.0, 0.80, 0.28, 1.0)
			else button.SpriteGUIRendererComponent.Color = Color(0.28, 0.30, 0.34, 0.88) end
		end
		if isvalid(button.TextGUIRendererComponent) then
			if selected then button.TextGUIRendererComponent.FontColor = Color(0.10, 0.14, 0.19, 1.0)
			else button.TextGUIRendererComponent.FontColor = Color(1.0, 1.0, 1.0, 1.0) end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCancelClicked(ButtonClickEvent event)
		local board = self:GetBoard()
		if board == nil or board.Phase ~= "Placement" or board.PendingCount <= 0 then
			return
		end
		if self.SelectedReservedSlot ~= 0 then
			local slotIndex = self.SelectedReservedSlot
			self:ClearReservedSelection()
			board:RequestCancelPlacement(slotIndex)
		else
			board:RequestUndoPlacement()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnConfirmClicked(ButtonClickEvent event)
		local board = self:GetBoard()
		if board == nil or board.BattleState ~= "Playing" or board.Phase ~= "Placement" then
			self:SetCardHint("첫 패 선택이 끝난 배치 단계에서만 확정할 수 있습니다.")
			return
		end
		if self.RibbonSelectionState == "Selecting" then
			self:SetCardHint("리본돼지의 이동 대상을 먼저 선택해야 배치를 확정할 수 있습니다.")
			return
		end
		self.SelectedCardInstanceId = ""
		self.SelectedVisualSlot = 0
		self:ClearReservedSelection()
		self:ClearSnapTarget()
		board:RequestConfirmPlacement()
	end

	@ExecSpace("ClientOnly")
	method void OnRestartClicked(ButtonClickEvent event)
		local board = self:GetBoard()
		if board == nil then
			return
		end
		self.SelectedCardInstanceId = ""
		self.SelectedVisualSlot = 0
		self.MulliganConfirmedLocally = false
		self:ClearReservedSelection()
		self:ClearSnapTarget()
		board:RequestRestart()
	end

	@ExecSpace("ClientOnly")
	method void OnSpeed1Clicked(ButtonClickEvent event)
		local board = self:GetBoard()
		if board ~= nil then
			board:RequestSetSimulationSpeed(1)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSpeed2Clicked(ButtonClickEvent event)
		local board = self:GetBoard()
		if board ~= nil then
			board:RequestSetSimulationSpeed(2)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetCardHint(string message)
		if isvalid(self.CardHintText) then
			self.CardHintText.Text = message
		end
	end

end
